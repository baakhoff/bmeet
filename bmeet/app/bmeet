def socket_path() -> str:
    if os.environ.get("BMEET_SOCKET"):
        return os.environ["BMEET_SOCKET"]
    base = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    return os.path.join(base, f"bmeet-{os.getuid()}.sock")


class SingleInstance(QObject):
    """One window per user: QLocalServer at a per-uid socket path. A second launch
    sends its request as one JSON line and gets "ok" back. A flock on PATH.lock,
    held by the running window, keeps two simultaneous first launches apart."""
    received = pyqtSignal(dict)

    def __init__(self, path: str) -> None:
        super().__init__()
        self.path = path
        self.server: QLocalServer | None = None
        self._lock_fd: int | None = None
        self._conns: list[tuple[QLocalSocket, bytearray]] = []

    def forward(self, request: dict, timeout_ms: int = 1500) -> bool:
        sock = QLocalSocket()
        sock.connectToServer(self.path)
        if not sock.waitForConnected(timeout_ms):
            return False
        sock.write(json.dumps(request).encode() + b"\n")
        sock.waitForBytesWritten(timeout_ms)
        reply = b""
        for _ in range(20):  # up to ~5 s while the window is busy
            if sock.waitForReadyRead(250) or sock.bytesAvailable():
                reply += sock.readAll().data()
            if b"\n" in reply or sock.state() == QLocalSocket.LocalSocketState.UnconnectedState:
                break
        sock.abort()
        return reply.startswith(b"ok")

    def lock(self) -> bool:
        fd = os.open(self.path + ".lock", os.O_RDWR | os.O_CREAT, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            os.close(fd)
            return False
        self._lock_fd = fd
        return True

    def listen(self) -> bool:
        QLocalServer.removeServer(self.path)  # stale socket of a crashed instance
        self.server = QLocalServer(self)
        self.server.setSocketOptions(QLocalServer.SocketOption.UserAccessOption)
        self.server.newConnection.connect(self._on_connection)
        ok = self.server.listen(self.path)
        if not ok:
            print(f"bmeet: cannot listen on {self.path}: {self.server.errorString()}", file=sys.stderr)
        return ok

    def _on_connection(self) -> None:
        while self.server.hasPendingConnections():
            conn = self.server.nextPendingConnection()
            buf = bytearray()
            entry = (conn, buf)
            self._conns.append(entry)
            conn.readyRead.connect(lambda e=entry: self._on_ready(e))
            conn.disconnected.connect(lambda e=entry: self._drop(e))
            if conn.bytesAvailable():
                self._on_ready(entry)

    def _on_ready(self, entry: tuple[QLocalSocket, bytearray]) -> None:
        conn, buf = entry
        buf += conn.readAll().data()
        if b"\n" not in buf or entry not in self._conns:
            return
        try:
            request = json.loads(bytes(buf).split(b"\n", 1)[0])
        except ValueError:
            request = None
        ok = isinstance(request, dict)
        conn.write(b"ok\n" if ok else b"error\n")
        conn.flush()
        conn.disconnectFromServer()
        self._drop(entry)
        if ok:
            QTimer.singleShot(0, lambda: self.received.emit(request))

    def _drop(self, entry) -> None:
        if entry in self._conns:
            self._conns.remove(entry)
            entry[0].deleteLater()


