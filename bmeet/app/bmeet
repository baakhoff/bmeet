class ListDetailPage(QWidget):
    """List (top) and detail (bottom) in a splitter, like KMail's message list + preview."""
    COLUMNS: tuple[str, ...] = ()
    EMPTY = ""

    def __init__(self, main: MainWindow) -> None:
        super().__init__()
        self.main = main
        self.terms: list[str] = []
        self.current_text = ""  # what Copy copies

        self.tree = QTreeWidget()
        self.tree.setHeaderLabels(self.COLUMNS)
        self.tree.setRootIsDecorated(False)
        self.tree.setUniformRowHeights(True)
        self.tree.setAllColumnsShowFocus(True)
        self.tree.setSelectionMode(QAbstractItemView.SelectionMode.SingleSelection)
        self.tree.setSortingEnabled(True)
        self.tree.sortByColumn(1, Qt.SortOrder.DescendingOrder)
        self.tree.setContextMenuPolicy(Qt.ContextMenuPolicy.ActionsContextMenu)
        header = self.tree.header()
        header.setStretchLastSection(False)
        header.setSectionResizeMode(0, QHeaderView.ResizeMode.Stretch)
        for col in range(1, len(self.COLUMNS)):
            header.setSectionResizeMode(col, QHeaderView.ResizeMode.ResizeToContents)
        self.tree.currentItemChanged.connect(lambda *_: self.show_current())

        self.title = QLabel()
        f = self.title.font()
        f.setPointSizeF(f.pointSizeF() * 1.25)
        f.setBold(True)
        self.title.setFont(f)
        self.title.setWordWrap(True)
        self.title.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        self.meta = QLabel()
        self.meta.setWordWrap(True)
        self.meta.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        pal = self.meta.palette()
        pal.setColor(QPalette.ColorRole.WindowText, pal.color(QPalette.ColorRole.PlaceholderText))
        self.meta.setPalette(pal)
        self.bar = QToolBar()
        self.bar.setIconSize(QSize(16, 16))
        self.bar.setToolButtonStyle(Qt.ToolButtonStyle.ToolButtonTextBesideIcon)
        self.view = MarkdownView()

        detail = QWidget()
        dl = QVBoxLayout(detail)
        dl.setContentsMargins(0, 8, 0, 0)
        dl.setSpacing(4)
        head = QVBoxLayout()
        head.setContentsMargins(4, 0, 4, 0)
        head.addWidget(self.title)
        head.addWidget(self.meta)
        dl.addLayout(head)
        dl.addWidget(self.bar)
        dl.addWidget(self.view, 1)

        self.placeholder = QLabel()
        self.placeholder.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.placeholder.setWordWrap(True)
        self.placeholder.setMargin(24)
        self.placeholder.setPalette(pal)
        self.detail_stack = QStackedWidget()
        self.detail_stack.addWidget(self.placeholder)
        self.detail_stack.addWidget(detail)

        self.splitter = QSplitter(Qt.Orientation.Vertical)
        self.splitter.addWidget(self.tree)
        self.splitter.addWidget(self.detail_stack)
        self.splitter.setStretchFactor(0, 2)
        self.splitter.setStretchFactor(1, 3)
        self.splitter.setChildrenCollapsible(False)
        lay = QVBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.addWidget(self.splitter)

    # -- helpers for subclasses
    def add_action(self, icon_name: str, text: str, slot, tip: str = "",
                   shortcut: QKeySequence.StandardKey | None = None) -> QAction:
        act = QAction(icon(icon_name), text, self)
        act.setToolTip(tip or text)
        act.triggered.connect(slot)
        if shortcut is not None:
            act.setShortcut(QKeySequence(shortcut))
            act.setShortcutContext(Qt.ShortcutContext.WidgetWithChildrenShortcut)
        self.bar.addAction(act)
        self.tree.addAction(act)
        return act

    def items(self) -> list[QTreeWidgetItem]:
        return [self.tree.topLevelItem(i) for i in range(self.tree.topLevelItemCount())]

    def current_key(self) -> str | None:
        item = self.tree.currentItem()
        return item.data(0, KEY_ROLE) if item is not None and not item.isHidden() else None

    def item_for(self, key: str | None) -> QTreeWidgetItem | None:
        return next((it for it in self.items() if it.data(0, KEY_ROLE) == key), None) if key else None

    def select_key(self, key: str | None) -> bool:
        item = self.item_for(key)
        if item is None or item.isHidden():
            return False
        self.tree.setCurrentItem(item)
        self.tree.scrollToItem(item)
        return True

    def select_first_visible(self) -> None:
        for item in self.items():  # items() is in display (sorted) order
            if not item.isHidden():
                self.tree.setCurrentItem(item)
                return
        self.tree.setCurrentItem(None)

    def counts(self) -> tuple[int, int]:
        items = self.items()
        return sum(not it.isHidden() for it in items), len(items)

    def show_current(self) -> None:
        key = self.current_key()
        if key is None:
            shown, total = self.counts()
            self.placeholder.setText(self.EMPTY if total == 0 else
                                     "Nothing matches the search." if shown == 0 else
                                     "Select an item to see its transcript.")
            self.detail_stack.setCurrentIndex(0)
            self.current_text = ""
            return
        self.detail_stack.setCurrentIndex(1)
        self.show_detail(key)

    def set_filter(self, terms: list[str]) -> None:
        self.terms = terms
        for item in self.items():
            item.setHidden(not self.item_matches(item.data(0, KEY_ROLE), terms))
        if self.current_key() is None:
            self.select_first_visible()
            if self.tree.currentItem() is None:
                self.show_current()
        self.view.set_terms(terms)

    def repopulate(self, rows: list[tuple[str, list[str], list, str]], keep: str | None) -> None:
        """rows: (key, column texts, sort keys, tooltip). Keeps the selection."""
        self.tree.blockSignals(True)
        self.tree.setSortingEnabled(False)
        self.tree.clear()
        for key, texts, sort_keys, tip in rows:
            item = SortItem(texts)
            item.setData(0, KEY_ROLE, key)
            for col, value in enumerate(sort_keys):
                if value is not None:
                    item.setData(col, SORT_ROLE, value)
            if tip:
                item.setToolTip(0, tip)
            self.tree.addTopLevelItem(item)
        self.tree.setSortingEnabled(True)
        for item in self.items():
            item.setHidden(not self.item_matches(item.data(0, KEY_ROLE), self.terms))
        if not self.select_key(keep):
            self.select_first_visible()
        self.tree.blockSignals(False)

    # -- overridden
    def item_matches(self, key: str, terms: list[str]) -> bool:
        return True

    def show_detail(self, key: str) -> None:
        pass

    def copy_text(self) -> None:
        if self.current_text:
            QGuiApplication.clipboard().setText(self.current_text)
            self.main.message("Copied the transcript to the clipboard")


class NameSpeakersDialog(QDialog):
    """Names for the speakers of one meeting, and the "remember voices" switch."""

    def __init__(self, parent: QWidget, speakers: list[tuple[str, str]], has_fingerprints: bool,
                 you_allowed: bool = False) -> None:
        super().__init__(parent)
        self.setWindowTitle("Name speakers")
        self.you_allowed = you_allowed
        layout = QVBoxLayout(self)
        intro = QLabel("Who is who? Leave a field empty to keep the label. Give two labels the "
                       "same name when they are one person."
                       + (" This meeting was in person: write You for yourself." if you_allowed else ""))
        intro.setWordWrap(True)
        layout.addWidget(intro)
        grid = QGridLayout()
        self.fields: dict[str, QLineEdit] = {}
        for row, (label, said) in enumerate(speakers):
            grid.addWidget(QLabel(f"<b>{html.escape(label)}</b>"), row * 2, 0)
            edit = QLineEdit("" if NOT_A_NAME.search(label) else label)
            edit.setPlaceholderText("Name")
            grid.addWidget(edit, row * 2, 1)
            sample = QLabel(html.escape(said[:140] + ("…" if len(said) > 140 else "")) or "–")
            sample.setWordWrap(True)
            sample.setEnabled(False)  # greyed: a hint, not a field
            grid.addWidget(sample, row * 2 + 1, 1)
            self.fields[label] = edit
        layout.addLayout(grid)
        self.remember = QCheckBox("Recognise them by voice in later meetings")
        self.remember.setChecked(remember_voices_on())
        self.remember.setToolTip(
            "Keeps a voice fingerprint of each person you name on this computer "
            f"({tilde(VOICES_DIR)}), and later meetings call them by name.\n"
            "Unticking it forgets all fingerprints.")
        self.remember.toggled.connect(self._remember_toggled)
        layout.addWidget(self.remember)
        self.note = QLabel()
        self.note.setWordWrap(True)
        layout.addWidget(self.note)
        self.has_fingerprints = has_fingerprints
        self.error = QLabel()
        self.error.setStyleSheet("color: #da4453")
        self.error.hide()
        layout.addWidget(self.error)
        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        self.voices_btn = buttons.addButton("Remembered voices…", QDialogButtonBox.ButtonRole.ResetRole)
        self.voices_btn.clicked.connect(lambda: VoicesDialog(self).exec())
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)
        self._update_note()

    def _update_note(self) -> None:
        on = self.remember.isChecked()
        self.voices_btn.setVisible(on and bool(remembered_voices() or own_voice_meetings()))
        self.note.setText("" if not on or self.has_fingerprints else
                          "Recognition starts with the next meeting: this one was transcribed "
                          "before remembering voices was on, so it has no fingerprints.")
        self.note.setVisible(bool(self.note.text()))

    def _remember_toggled(self, on: bool) -> None:
        if not on and (remembered_voices() or own_voice_meetings()) and QMessageBox.question(
                self, "Forget voices", "Forget all remembered voices?",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
                QMessageBox.StandardButton.No) != QMessageBox.StandardButton.Yes:
            self.remember.blockSignals(True)
            self.remember.setChecked(True)
            self.remember.blockSignals(False)
        self._update_note()

    def names(self) -> dict[str, str]:
        """{label: new name} for the fields that changed."""
        return {label: edit.text().strip() for label, edit in self.fields.items()
                if edit.text().strip() and edit.text().strip() != label}

    def problems(self) -> list[str]:
        return [f"“{name}”: {why}" for name in self.names().values()
                if (why := name_problem(name, self.you_allowed))]

    def accept(self) -> None:
        if problems := self.problems():
            self.error.setText("Not a name: " + "; ".join(problems))
            self.error.show()
            return
        super().accept()


class VoicesDialog(QDialog):
    """The remembered voices, to forget one or all."""

    def __init__(self, parent: QWidget) -> None:
        super().__init__(parent)
        self.setWindowTitle("Remembered voices")
        layout = QVBoxLayout(self)
        info = QLabel(f"Voice fingerprints kept in {tilde(VOICES_DIR)}. Later meetings call these "
                      "people by name.")
        info.setWordWrap(True)
        layout.addWidget(info)
        self.list = QListWidget()
        layout.addWidget(self.list)
        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Close)
        self.forget_btn = buttons.addButton("Forget", QDialogButtonBox.ButtonRole.ActionRole)
        self.forget_btn.clicked.connect(self.forget)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)
        self.fill()

    def fill(self) -> None:
        self.list.clear()
        if n := own_voice_meetings():  # (None: not a name, so it cannot clash with one)
            item = QListWidgetItem(f"You: your own voice  ({n} meeting{'s' if n != 1 else ''})")
            item.setToolTip("Learned from your microphone in online meetings; in-person "
                            "meetings use it to tell you from the others in the room")
            item.setData(Qt.ItemDataRole.UserRole, None)
            self.list.addItem(item)
        for name, n in sorted(remembered_voices().items(), key=lambda x: x[0].casefold()):
            item = QListWidgetItem(f"{name}  ({n} meeting{'s' if n != 1 else ''})")
            item.setData(Qt.ItemDataRole.UserRole, name)
            self.list.addItem(item)
        self.forget_btn.setEnabled(self.list.count() > 0)

    def forget(self) -> None:
        item = self.list.currentItem() or self.list.item(0)
        if item:
            name = item.data(Qt.ItemDataRole.UserRole)
            if name is None:
                forget_own_voice()
            else:
                forget_voice(name)
            self.fill()


class MeetingsPage(ListDetailPage):
    COLUMNS = ("Title", "Date", "Duration", "Status")
    EMPTY = mac_words("No meetings yet.\n\nPress “Start meeting” above (or Meta+Alt+M) to record the "
             "microphone and the system audio. The transcript shows up here as people talk.")

    def __init__(self, main: MainWindow) -> None:
        super().__init__(main)
        self.meetings: dict[str, Meeting] = {}
        self.export_cache: dict[str, str] = {}   # meeting id -> exported Markdown
        self.export_failed: set[str] = set()
        self.texts = TextCache()
        self.live_id: str | None = None
        self.live_state = "idle"
        self.live_elapsed: float | None = None
        self.live_md: str | None = None           # the running meeting's live transcript
        self.live_sig: tuple | None = None        # ... as last shown
        self.follow: str | None = None            # a meeting that just started: select it once listed
        self.polled = False
        self.speakers_pending: set[str] = set()   # running speaker passes (pass_running)
        self.error: str | None = None
        self._req = 0
        self._index_queue: list[str] = []
        self._index_busy = False
        self.act_refresh = self.add_action("view-refresh", "Reload", lambda: self.show_current_force(),
                                           f"Load the transcript again from {ENGINE}")
        self.act_copy = self.add_action("edit-copy", "Copy all", self.copy_text,
                                        "Copy the whole transcript (Markdown) to the clipboard")
        self.act_export = self.add_action("document-export", "Export…", self.export,
                                          "Save the transcript as Markdown, plain text or JSON")
        self.act_folder = self.add_action("document-open-folder", "Open folder", self.open_folder,
                                          "Show the Markdown copy in the file manager")
        self.act_names = self.add_action("im-user", "Name speakers…", self.name_speakers,
                                         "Put names on Person 1, Person 2, …; optionally recognise "
                                         "them by voice in later meetings")
        self.act_delete = self.add_action("edit-delete", "Delete…", self.delete,
                                          f"Delete this meeting from {ENGINE}", QKeySequence.StandardKey.Delete)

    def is_live(self, m: Meeting) -> bool:
        return m.id == self.live_id and self.live_state in ("recording", "paused")

    def current(self) -> Meeting | None:
        return self.meetings.get(self.current_key() or "")

    def reload(self) -> None:
        old_key = self.current_key()
        old_sig = self.meetings[old_key].signature() if old_key in self.meetings else None
        try:
            meetings = load_meetings()
            self.error = None
        except sqlite3.Error as exc:
            meetings, self.error = [], f"Cannot read {MEETING_DB}: {exc}"
        old = self.meetings
        self.meetings = {m.id: m for m in meetings}
        for mid in list(self.export_cache) + list(self.export_failed):  # meeting changed or gone:
            new = self.meetings.get(mid)                               # export it again when needed
            if new is None or (mid in old and old[mid].signature() != new.signature()):
                self.export_cache.pop(mid, None)
                self.export_failed.discard(mid)
        rows = []
        for m in meetings:
            rows.append((m.id, [m.title, fmt_date(m.started_at), self.duration_text(m), self.status_text(m)],
                         [m.title.casefold(), m.started_at, self.duration_value(m), None],
                         tilde(m.md_path) if m.md_path else ""))
        self.repopulate(rows, old_key)
        if self.follow and self.select_key(self.follow):
            self.follow = None
        new_key = self.current_key()
        new_sig = self.meetings[new_key].signature() if new_key in self.meetings else None
        if new_key != old_key or new_sig != old_sig:
            self.show_current()
        if self.error:
            self.placeholder.setText(self.error)
            self.detail_stack.setCurrentIndex(0)

    def duration_value(self, m: Meeting) -> float | None:
        return self.live_elapsed if self.is_live(m) else m.duration()

    def duration_text(self, m: Meeting) -> str:
        return fmt_duration(self.duration_value(m))

    def status_text(self, m: Meeting) -> str:
        if self.is_live(m):
            return "Recording" if self.live_state == "recording" else "Paused"
        return m.status.replace("_", " ").capitalize() or "–"

    def set_live(self, meeting_id: str | None, state: str, elapsed: float | None,
                 live_md: str | None = None) -> None:
        """Called every second by the window: update the running meeting's row, and its
        transcript so far when it is shown and live_md (from bmeet-ctl) changed."""
        old_id = self.live_id
        changed = (meeting_id, state) != (self.live_id, self.live_state)
        if meeting_id and old_id is None and self.polled:  # (started now, not before the window opened)
            self.follow = meeting_id
        self.polled = True
        self.live_id, self.live_state, self.live_elapsed, self.live_md = meeting_id, state, elapsed, live_md
        if self.follow and self.select_key(self.follow):
            self.follow = None
        for mid in {meeting_id, old_id} - {None}:
            item, m = self.item_for(mid), self.meetings.get(mid)
            if item is not None and m is not None:
                item.setText(2, self.duration_text(m))
                item.setText(3, self.status_text(m))
        if changed and self.current_key():
            self.show_current()
        elif meeting_id and self.current_key() == meeting_id and meeting_id in self.meetings:
            self.meta.setText(self.meta_text(self.meetings[meeting_id]))
            if self.is_live(self.meetings[meeting_id]) and stat_sig(live_md or "") != self.live_sig:
                self.show_live()

    def meta_text(self, m: Meeting) -> str:
        parts = [fmt_date(m.started_at, long=True), self.duration_text(m), self.status_text(m)]
        if m.chunk_count:
            parts.append(f"{m.chunk_count} chunk{'s' if m.chunk_count != 1 else ''}")
        if m.model:
            parts.append(Path(m.model).name)
        text = " · ".join(parts)
        text += "\n" + (f"Markdown copy: {tilde(m.md_path)}" if m.md_path
                        else f"From {ENGINE}'s meeting database (no Markdown copy)")
        if self.pass_running(m):
            text += "\nTelling the speakers apart… the transcript is replaced when that is done."
        if self.is_live(m) and self.live_md:
            text += "\nLive: transcribed as people talk; in italics, what is still being said"
        return text

    def pass_running(self, m: Meeting) -> bool:
        """Is the speaker pass working on this meeting? (bmeet-ctl's speakers_pending: the
        transcripts being replaced, or start stamps from markers that name none)"""
        if self.is_live(m):  # (its pass starts when it stops)
            return False
        names = {Path(p).name for p in self.speakers_pending}  # (one folder: names are enough)
        if m.md_path and Path(m.md_path).name in names or m.stamps() & self.speakers_pending:
            return True
        # no copy yet (the export failed): it may be the one the pass is going to write
        return bool(not m.md_path and m.ended_at and m.stamps() & {n[:15] for n in names})

    def set_speakers_pending(self, pending: set[str]) -> None:
        self.speakers_pending = pending
        if m := self.current():
            self.meta.setText(self.meta_text(m))
            self.update_names_action(m)

    def update_names_action(self, m: Meeting) -> None:
        busy = self.is_live(m) or self.pass_running(m)
        has_people = bool(m.md_path and md_speakers(self.texts.get(m.md_path) or ""))
        self.act_names.setEnabled(has_people and not busy)
        self.act_names.setToolTip(
            "Wait until the speakers are told apart" if busy and has_people else
            "Put names on Person 1, Person 2, …; optionally recognise them by voice in later meetings"
            if has_people else "This transcript has no speakers to name")

    def ask_names(self, speakers: list[tuple[str, str]], has_fingerprints: bool,
                  you_allowed: bool = False) -> tuple[dict[str, str], bool] | None:
        """({label: name}, remember voices?) from the dialog, or None if cancelled."""
        dlg = NameSpeakersDialog(self, speakers, has_fingerprints, you_allowed)
        if dlg.exec() != QDialog.DialogCode.Accepted:
            return None
        return dlg.names(), dlg.remember.isChecked()

    def name_speakers(self) -> None:
        m = self.current()
        if m is None or not m.md_path or self.is_live(m) or self.pass_running(m):
            return
        text = read_text(m.md_path)
        speakers = md_speakers(text or "")
        if not speakers:
            return
        answer = self.ask_names(speakers, meeting_voices_path(m.md_path).exists(), mic_split(text or ""))
        if answer is None:
            return
        names, remember = answer
        if remember != remember_voices_on():
            set_remember_voices(remember)
        if not names:
            return
        try:
            path = Path(m.md_path)
            fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(rename_speakers(text or "", names))
            os.chmod(tmp, path.stat().st_mode & 0o777)
            os.replace(tmp, path)
        except OSError as exc:
            self.main.error_box("Could not rename the speakers", str(exc))
            return
        remembered = remember_named(m.md_path, names) if remember else []
        self.main.message("Renamed " + ", ".join(f"{a} → {b}" for a, b in names.items())
                          + (f"; {', '.join(remembered)} will be recognised in later meetings"
                             if remembered else ""))
        self.reload()

    def show_detail(self, key: str) -> None:
        m = self.meetings.get(key)
        if m is None:
            return
        live = self.is_live(m)
        self.title.setText(m.title)
        self.meta.setText(self.meta_text(m))
        self.act_refresh.setVisible(live or not m.md_path)
        self.update_names_action(m)
        self.act_delete.setEnabled(not live)
        self.act_delete.setToolTip("Stop the meeting before deleting it" if live
                                   else f"Delete this meeting from {ENGINE}")
        self.load_body(m, live)

    def show_current_force(self) -> None:
        m = self.current()
        if m:
            self.export_cache.pop(m.id, None)
            self.load_body(m, self.is_live(m))

    def load_body(self, m: Meeting, live: bool) -> None:
        self._req += 1
        req = self._req
        if live:  # (voxtype keeps a meeting's text to itself until it stops)
            self.show_live(first=True)
            return
        if m.md_path:
            text = self.texts.get(m.md_path)
            if text is not None:
                self._show_text(text)
                return
        if m.id in self.export_cache:
            self._show_text(self.export_cache[m.id])
            return
        self.current_text = ""
        self.act_copy.setEnabled(False)
        self.view.show_message(message_html("Loading the transcript…", f"{ENGINE} meeting export", "busy"))

        def done(code: int, out: str, err: str) -> None:
            if code == 0:
                self.export_cache[m.id] = out
                self.export_failed.discard(m.id)
            if req != self._req:
                return  # the selection moved on
            if code == 0:
                self._show_text(out)
            else:
                self.view.show_message(message_html(
                    "Could not load the transcript",
                    (err.strip() or f"{ENGINE} exited with status {code}")
                    + (f"\n\nIs the {ENGINE} daemon running?" if code == -1 else ""), "error"))
        run_command(self, export_cmd(m.id), done, timeout_ms=60_000)

    def show_live(self, first: bool = False) -> None:
        """The running meeting's transcript so far (npu-transcribe --live), following its end
        unless you scrolled up (or search in it)."""
        self.live_sig = stat_sig(self.live_md or "")
        text = read_text(self.live_md) if self.live_md else None
        if text is None:
            self.current_text = ""
            self.act_copy.setEnabled(False)
            self.view.show_message(message_html(
                "The transcript shows up here as people talk",
                "If it does not, the live transcript is off, and the transcript shows up here when the "
                "meeting stops. It needs telling speakers apart (on unless installed with "
                "--no-speakers), and ~/.config/bmeet/live-transcript must not say “off”.", "busy"))
            return
        bar = self.view.verticalScrollBar()
        follow, pos = not self.terms and (first or bar.value() >= bar.maximum() - 4), bar.value()
        self.current_text = text
        self.act_copy.setEnabled(bool(text.strip()))
        # The transcript only: the info above it changes with every line (word count, ...).
        body = text.split("\n## Transcript\n", 1)[-1]
        self.view.show_paragraphs([p.strip() for p in body.split("\n\n") if p.strip()]
                                  or ["*(nothing said yet)*"])
        if self.terms and first:
            return  # (at the first search hit)

        def scroll() -> None:
            bar.setValue(bar.maximum() if follow else pos)
        scroll()
        QTimer.singleShot(0, scroll)  # (once the text is laid out)

    def _show_text(self, text: str) -> None:
        self.current_text = text
        self.act_copy.setEnabled(bool(text.strip()))
        self.view.show_markdown(text if text.strip() else "*(the transcript is empty)*")

    # -- search: title + Markdown copy, else the exported transcript (fetched on demand)
    def content(self, m: Meeting) -> str | None:
        if m.md_path:
            text = self.texts.get(m.md_path)
            if text is not None:
                return text
        return self.export_cache.get(m.id)

    def item_matches(self, key: str, terms: list[str]) -> bool:
        m = self.meetings.get(key)
        if m is None:
            return False
        if not terms:
            return True
        content = self.content(m)
        if content is None and not self.is_live(m) and m.id not in self.export_failed \
                and m.id not in self._index_queue:
            self._index_queue.append(m.id)
            QTimer.singleShot(0, self._index_next)
        return matches(terms, m.title, content)

    def _index_next(self) -> None:
        if self._index_busy:
            return
        while self._index_queue:
            mid = self._index_queue.pop(0)
            if mid in self.meetings and mid not in self.export_cache and mid not in self.export_failed:
                break
        else:
            return
        self._index_busy = True

        def done(code: int, out: str, _err: str) -> None:
            self._index_busy = False
            if code == 0:
                self.export_cache[mid] = out
            else:
                self.export_failed.add(mid)
            if self.terms:
                self.main.apply_search()
            self._index_next()
        run_command(self, export_cmd(mid), done, timeout_ms=60_000)

    # -- actions
    def export(self) -> None:
        m = self.current()
        if m is None:
            return
        start = Path(self.main.settings.value("meetings/exportDir", "") or
                     (MEETING_MD_DIR if MEETING_MD_DIR.is_dir() else HOME / "Documents"))
        path, flt = QFileDialog.getSaveFileName(self, "Export meeting transcript",
                                                str(start / f"{safe_filename(m.title)}.md"),
                                                ";;".join(f[0] for f in EXPORT_FORMATS))
        if path:
            self.main.settings.setValue("meetings/exportDir", str(Path(path).parent))
            self.export_to(m.id, path, flt)

    def export_to(self, meeting_id: str, path: str, name_filter: str = "") -> str:
        """Format from the file extension, else from the chosen filter (extension added).
        From the Markdown copy (the running meeting: its live transcript) when there is one,
        else voxtype's own transcript (meeting_export())."""
        ext = Path(path).suffix.lower()
        fmt = next((f[1] for f in EXPORT_FORMATS if f[2] == ext), None)
        if fmt is None:
            fmt, ext = next(((f[1], f[2]) for f in EXPORT_FORMATS if f[0] == name_filter),
                            ("markdown", ".md"))
            path += ext
        m = self.meetings.get(meeting_id)
        source = m and (m.md_path or (self.live_md if self.is_live(m) else None))
        text = read_text(source) if source else None
        if m is not None and text is not None:
            try:
                Path(path).write_text(meeting_export(m, text, fmt), encoding="utf-8")
            except OSError as exc:
                self.main.error_box("Export failed", str(exc))
                return path
            self.main.message(f"Exported to {tilde(path)}")
            return path

        def done(code: int, _out: str, err: str) -> None:
            if code == 0:
                self.main.message(f"Exported to {tilde(path)}")
            else:
                self.main.error_box("Export failed", err.strip() or f"{ENGINE} exited with status {code}")
        run_command(self, export_cmd(meeting_id, fmt, path), done, timeout_ms=60_000)
        return path

    def open_folder(self) -> None:
        m = self.current()
        if m and m.md_path and os.path.isfile(m.md_path):
            show_in_folder(m.md_path)
        elif m and m.storage_path and os.path.isdir(m.storage_path):
            open_path(m.storage_path)
        else:
            open_path(str(MEETING_MD_DIR if MEETING_MD_DIR.is_dir() else HOME))

    def ask_delete(self, m: Meeting) -> tuple[bool, bool]:
        """(delete?, also trash the Markdown copy?)"""
        box = QMessageBox(QMessageBox.Icon.Warning, "Delete meeting",
                          f"Delete “{m.title}” ({fmt_date(m.started_at)})?", parent=self)
        box.setInformativeText(f"The meeting and its transcript are removed from {ENGINE}'s "
                               "database. This cannot be undone.")
        cb = None
        if m.md_path and os.path.isfile(m.md_path):
            cb = QCheckBox(f"Also move the Markdown copy “{Path(m.md_path).name}” to the Trash")
            box.setCheckBox(cb)
        delete_btn = box.addButton("Delete", QMessageBox.ButtonRole.DestructiveRole)
        delete_btn.setIcon(QIcon.fromTheme("edit-delete"))
        box.setDefaultButton(box.addButton(QMessageBox.StandardButton.Cancel))
        box.exec()
        return box.clickedButton() is delete_btn, bool(cb and cb.isChecked())

    def delete(self) -> None:
        m = self.current()
        if m is None or self.is_live(m):
            return
        ok, trash_md = self.ask_delete(m)
        if not ok:
            return

        def done(code: int, _out: str, err: str) -> None:
            if code != 0:
                self.main.error_box("Delete failed", err.strip() or f"{ENGINE} exited with status {code}")
                return
            self.export_cache.pop(m.id, None)
            if m.md_path:  # its voice fingerprints, if any (remembered names stay)
                meeting_voices_path(m.md_path).unlink(missing_ok=True)
            text = f"Deleted “{m.title}”"
            if trash_md and m.md_path:
                if move_to_trash(m.md_path):
                    text += "; its Markdown copy is in the Trash"
                else:
                    self.main.error_box("Could not move to the Trash", m.md_path)
            self.main.message(text)
            self.reload()
            self.main.update_counts()
        cmd = MEETING_CMD + ["delete"] if MAC else [VOXTYPE, "meeting", "delete"]
        run_command(self, cmd + ["--force", "--", m.id], done, timeout_ms=60_000)

    def select_md(self, path: str) -> bool:
        p = os.path.abspath(path)
        return any(m.md_path == p and self.select_key(m.id) for m in self.meetings.values())

    def select_newest(self) -> None:
        if self.meetings:
            self.select_key(max(self.meetings.values(), key=lambda m: m.started_at).id)


class FilesPage(ListDetailPage):
    COLUMNS = ("Name", "Date", "Duration", "Model", "Status")
    EMPTY = mac_words("No transcribed files yet.\n\nUse “Transcribe a file”, or right-click a recording "
                      "in Dolphin → Transcribe (NPU).")

    def __init__(self, main: MainWindow) -> None:
        super().__init__(main)
        self.entries: dict[str, HistoryEntry] = {}
        self.texts = TextCache()
        self.act_copy = self.add_action("edit-copy", "Copy", self.copy_text,
                                        "Copy the transcript to the clipboard")
        self.act_srt = self.add_action("media-view-subtitles-symbolic", "Open subtitles",
                                       lambda: self._open(".srt"), "Open the .srt subtitles")
        self.act_notes = self.add_action("document-open", "Open notes", lambda: self._open(".md"),
                                         "Open the .md notes in your editor")
        self.act_folder = self.add_action("document-open-folder", "Open folder", self.open_folder,
                                          "Show the transcript in the file manager")
        self.act_again = self.add_action("view-refresh", "Transcribe again", self.again,
                                         "Queue the audio/video file on “Transcribe a file”")
        self.act_remove = self.add_action("list-remove", "Remove from list…", self.remove,
                                          "Remove from this list (files stay unless you choose otherwise)",
                                          QKeySequence.StandardKey.Delete)

    def current(self) -> HistoryEntry | None:
        return self.entries.get(self.current_key() or "")

    def reload(self) -> None:
        old_key = self.current_key()
        old_sig = self._sig(old_key)
        entries = load_history()
        self.entries = {}
        rows = []
        for e in entries:
            if e.raw in self.entries:
                continue
            self.entries[e.raw] = e
            model = " · ".join(x for x in (e.model and Path(e.model).name, e.device) if x)
            rows.append((e.raw, [e.name, fmt_date(e.time), fmt_duration(e.duration or None), model, e.state()],
                         [e.name.casefold(), e.time, e.duration, None, None], e.input))
        self.repopulate(rows, old_key)
        new_key = self.current_key()
        if new_key != old_key or self._sig(new_key) != old_sig:
            self.show_current()

    def _sig(self, key: str | None) -> tuple | None:
        e = self.entries.get(key or "")
        return (key, e.state(), stat_sig(e.text_path() or "")) if e else None

    def item_matches(self, key: str, terms: list[str]) -> bool:
        e = self.entries.get(key)
        if e is None:
            return False
        return not terms or matches(terms, e.name, self.texts.get(e.text_path()))

    def show_detail(self, key: str) -> None:
        e = self.entries.get(key)
        if e is None:
            return
        self.title.setText(e.name)
        self.title.setToolTip(e.input)
        parts = [fmt_date(e.time, long=True), fmt_duration(e.duration or None)]
        if e.model:
            parts.append(f"{Path(e.model).name} on {e.device}" if e.device else Path(e.model).name)
        if e.language and e.language != "?":
            parts.append(f"language {e.language}")
        parts.append(e.state())
        self.meta.setText(" · ".join(parts) + f"\n{tilde(e.input)}")
        srt, md = e.output(".srt"), e.output(".md")
        self.act_srt.setEnabled(bool(srt and os.path.isfile(srt)))
        self.act_notes.setEnabled(bool(md and os.path.isfile(md)))
        self.act_again.setEnabled(os.path.isfile(e.input))
        path = e.text_path()
        self.current_text = ""
        if e.status != "done":
            self.view.show_message(message_html(
                "Transcription failed",
                f"{e.input}\n\nUse “Transcribe again” to retry; the Transcribe page shows the "
                "log of runs started from this window.", "error"))
        elif path is None:
            self.view.show_message(message_html(
                "The transcript files were moved or deleted",
                "\n".join(e.outputs) or "(npu-transcribe recorded no output files)", "error"))
        else:
            text = self.texts.get(path) or ""
            self.current_text = text
            if path.lower().endswith(".md"):
                self.view.show_markdown(text)
            else:
                self.view.show_plain(text)
        self.act_copy.setEnabled(bool(self.current_text.strip()))

    def _open(self, ext: str) -> None:
        e = self.current()
        path = e.output(ext) if e else None
        if path and os.path.isfile(path):
            open_path(path)

    def open_folder(self) -> None:
        e = self.current()
        if e is None:
            return
        target = e.text_path() or next(iter(e.existing_outputs()), None) or \
            (e.input if os.path.exists(e.input) else None)
        if target:
            show_in_folder(target)
        elif os.path.isdir(os.path.dirname(e.input)):
            open_path(os.path.dirname(e.input))

    def again(self) -> None:
        e = self.current()
        if e and os.path.isfile(e.input):
            self.main.transcribe_page.add_files([e.input])
            self.main.set_page("transcribe")

    def ask_remove(self, e: HistoryEntry, outputs: list[str]) -> tuple[bool, bool]:
        """(remove from the list?, also trash the transcript files?)"""
        box = QMessageBox(QMessageBox.Icon.Question, "Remove from list",
                          f"Remove “{e.name}” from the list?", parent=self)
        box.setInformativeText("Only the list entry is removed: the recording and its "
                               "transcripts stay where they are, unless you tick the box.")
        cb = None
        if outputs:
            cb = QCheckBox("Also move the transcript files to the Trash: "
                           + ", ".join(Path(o).name for o in outputs))
            box.setCheckBox(cb)
        remove_btn = box.addButton("Remove", QMessageBox.ButtonRole.AcceptRole)
        remove_btn.setIcon(QIcon.fromTheme("list-remove"))
        box.setDefaultButton(box.addButton(QMessageBox.StandardButton.Cancel))
        box.exec()
        return box.clickedButton() is remove_btn, bool(cb and cb.isChecked())

    def remove(self) -> None:
        e = self.current()
        if e is None:
            return
        outputs = e.existing_outputs()
        ok, trash = self.ask_remove(e, outputs)
        if not ok:
            return
        try:
            remove_history_entries({e.raw})
        except OSError as exc:
            self.main.error_box("Could not update the list", f"{FILE_HISTORY}: {exc}")
            return
        failed = [o for o in outputs if trash and not move_to_trash(o)]
        if failed:
            self.main.error_box("Could not move to the Trash", "\n".join(failed))
        self.main.message(f"Removed “{e.name}” from the list"
                          + ("; its transcripts are in the Trash" if trash and not failed else ""))
        self.reload()
        self.main.update_counts()

    def select_path(self, path: str) -> bool:
        """Select the newest entry whose input or output is `path`."""
        for key, e in self.entries.items():  # dict order = newest first
            if e.matches_path(path) and self.select_key(key):
                return True
        return False

    def find_for_job(self, job: Job) -> str | None:
        outs = set(job.outputs)
        for key, e in self.entries.items():
            if e.input == job.path and (not outs or outs == set(e.outputs)):
                return key
        return None


