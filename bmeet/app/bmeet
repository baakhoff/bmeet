# Remembered voices (opt-in): npu-transcribe --voices keeps each meeting's voice
# fingerprints in VOICES_DIR/meetings/<transcript>.json; naming people here copies theirs
# to VOICES_DIR/voices.json, and later meetings call them by name.
VOICES_DIR = Path(os.environ.get("BMEET_VOICES_DIR")
                  or Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share") / "bmeet/voices")
REMEMBER_FILE = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "bmeet/remember-voices"
NOT_A_NAME = re.compile(r"^(You|Remote|Person \d+|Person \?|Speaker \d+|Speaker \?)$|[\n#*,\[\]`<>|]")
MAX_FINGERPRINTS = 10      # per person: the latest meetings they were named in
SPEAKERS_LINE = "- **Speakers:** "
# npu-transcribe's line in a transcript whose microphone was split by voice (an in-person
# meeting): there "You" is a voice like the others, and you can name yourself (You).
SPLIT_MIC_LINE = "- **Microphone:** split by voice"
YOU = "You"


def remember_voices_on() -> bool:
    try:
        return REMEMBER_FILE.read_text().split()[0] == "on"
    except (OSError, IndexError):
        return False


def set_remember_voices(on: bool) -> None:
    """Switch remembered voices; off forgets every fingerprint as well."""
    REMEMBER_FILE.parent.mkdir(parents=True, exist_ok=True)
    REMEMBER_FILE.write_text("on\n" if on else "off\n")
    if not on:
        shutil.rmtree(VOICES_DIR, ignore_errors=True)


def name_problem(name: str, you_allowed: bool = False) -> str | None:
    """Why `name` cannot be a speaker's name, or None. you_allowed: "You" is a name too
    (yourself, in a meeting whose microphone was split by voice)."""
    if not name:
        return "empty"
    if name == YOU and you_allowed:
        return None
    if len(name) > 40:
        return "longer than 40 characters"
    if NOT_A_NAME.search(name):
        return "reserved, or contains one of # * , [ ] ` < > |"
    return None


def mic_split(text: str) -> bool:
    """Was the microphone of this meeting transcript split by voice (in person)?"""
    return any(line.startswith(SPLIT_MIC_LINE) for line in text.splitlines())


def md_speakers(text: str) -> list[tuple[str, str]]:
    """(label, the first thing they said) for each speaker heading of a meeting transcript
    ("### Person 1"), in order of appearance; without You (your microphone), unless the
    microphone was split by voice (then You is a guess that can be wrong)."""
    out: dict[str, str] = {}
    label = None
    with_you = mic_split(text)
    for line in text.splitlines():
        if line.startswith("### "):
            label = line[4:].strip()
            if label != YOU or with_you:
                out.setdefault(label, "")
        elif label in out and not out[label] and line.strip():
            out[label] = re.sub(r"^\*\[[\d:]+\]\*\s*", "", line.strip())
    return list(out.items())


def rename_speakers(text: str, names: dict[str, str]) -> str:
    """Rename speakers in a meeting transcript: the headings and the Speakers line, nothing
    else. Two labels may get the same name (one person the pass split in two)."""
    out = []
    for line in text.splitlines(keepends=True):
        end = line[len(line.rstrip("\r\n")):]
        body = line[:len(line) - len(end)]
        if body.startswith("### ") and body[4:].strip() in names:
            line = f"### {names[body[4:].strip()]}{end}"
        elif body.startswith(SPEAKERS_LINE):
            items = [names.get(x.strip(), x.strip()) for x in body[len(SPEAKERS_LINE):].split(",")]
            line = SPEAKERS_LINE + ", ".join(dict.fromkeys(i for i in items if i)) + end
        out.append(line)
    return "".join(out)


def meeting_voices_path(md_path: str) -> Path:
    return VOICES_DIR / "meetings" / f"{Path(md_path).stem}.json"


def _load_json(path: Path) -> dict | None:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def _write_private(path: Path, data: dict) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)  # 0600
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f)
    os.replace(tmp, path)


def remembered_voices() -> dict[str, int]:
    """{name: how many meetings their voice comes from}"""
    data = _load_json(VOICES_DIR / "voices.json") or {}
    return {name: len(v.get("fingerprints") or []) for name, v in (data.get("voices") or {}).items()}


def own_voice_meetings() -> int:
    """How many meetings your own voice (you.json) comes from: npu-transcribe learns it from
    your microphone in online meetings, and you can name yourself in in-person meetings."""
    return len((_load_json(VOICES_DIR / "you.json") or {}).get("fingerprints") or [])


def forget_own_voice() -> None:
    (VOICES_DIR / "you.json").unlink(missing_ok=True)


def _own_voice(model, key: str, fingerprint: list[float] | None) -> None:
    """Take this meeting's fingerprint out of your own voice (you.json), and put
    `fingerprint` in instead when given (the latest MAX_FINGERPRINTS meetings)."""
    path = VOICES_DIR / "you.json"
    data = _load_json(path) or {}
    if data.get("model") != model:
        data = {"version": 1, "model": model, "fingerprints": [], "meetings": []}
    fps, meetings = data.get("fingerprints") or [], data.get("meetings") or []
    if len(meetings) != len(fps):
        meetings = [""] * len(fps)
    pairs = [(f, m) for f, m in zip(fps, meetings) if m != key]
    if fingerprint is None and len(pairs) == len(fps):
        return  # nothing of this meeting in it
    if fingerprint is not None:
        pairs = (pairs + [(fingerprint, key)])[-MAX_FINGERPRINTS:]
    data.update(fingerprints=[f for f, _ in pairs], meetings=[m for _, m in pairs], updated=int(time.time()))
    _write_private(path, data)


def forget_voice(name: str) -> None:
    path = VOICES_DIR / "voices.json"
    if (data := _load_json(path)) and name in (data.get("voices") or {}):
        del data["voices"][name]
        _write_private(path, data)


def remember_named(md_path: str, names: dict[str, str]) -> list[str]:
    """After naming the speakers of a meeting: their voice fingerprints from this meeting go
    to voices.json under the new names (replacing this meeting's fingerprint under an old
    name), and the meeting's own file follows the new labels. Returns the names remembered.
    Nothing happens when the meeting has no fingerprints (remembered voices were off)."""
    side = meeting_voices_path(md_path)
    meeting = _load_json(side)
    if not meeting or not isinstance(meeting.get("people"), dict):
        return []
    key = side.stem
    voices_path = VOICES_DIR / "voices.json"
    store = _load_json(voices_path) or {}
    if store.get("model") != meeting.get("model"):  # another model's fingerprints don't compare
        store = {"version": 1, "model": meeting.get("model"), "voices": {}}
    voices = store.setdefault("voices", {})
    remembered, people = [], {}
    for label, fingerprint in meeting["people"].items():
        new = names.get(label, label)
        people.setdefault(new, fingerprint)
        if new == label:
            continue
        if label == YOU or new == YOU:  # your own voice is kept apart (you.json)
            _own_voice(meeting.get("model"), key, fingerprint if new == YOU else None)
            if new == YOU:
                remembered.append(YOU)
        if label in voices:  # this meeting's fingerprint no longer belongs to the old name
            old = voices[label]
            keep = [i for i, m in enumerate(old.get("meetings") or []) if m != key]
            old["fingerprints"] = [old["fingerprints"][i] for i in keep]
            old["meetings"] = [old["meetings"][i] for i in keep]
            if not old["fingerprints"]:
                del voices[label]
        if name_problem(new) is None:
            entry = voices.setdefault(new, {"fingerprints": [], "meetings": []})
            pairs = [(f, m) for f, m in zip(entry["fingerprints"], entry["meetings"]) if m != key]
            pairs = (pairs + [(fingerprint, key)])[-MAX_FINGERPRINTS:]
            entry["fingerprints"], entry["meetings"] = [f for f, _ in pairs], [m for _, m in pairs]
            entry["updated"] = int(time.time())
            if new not in remembered:
                remembered.append(new)
    _write_private(voices_path, store)
    meeting["people"] = people
    _write_private(side, meeting)
    return remembered


# ============================================================================ data: file history

@dataclass
class HistoryEntry:
    """One line of npu-transcribe's history.jsonl; `raw` (the line) is its identity."""
    raw: str
    time: int
    input: str
    outputs: list[str]
    model: str = ""
    language: str = ""
    device: str = ""
    duration: float = 0.0
    status: str = "done"

    @property
    def name(self) -> str:
        return Path(self.input).name or self.input

    def output(self, ext: str) -> str | None:
        return next((o for o in self.outputs if o.lower().endswith(ext)), None)

    def existing_outputs(self) -> list[str]:
        return [o for o in self.outputs if os.path.isfile(o)]

    def text_path(self) -> str | None:
        """The file to show: notes (.md), else plain text, else subtitles."""
        for ext in (".md", ".txt", ".srt"):
            p = self.output(ext)
            if p and os.path.isfile(p):
                return p
        return None

    def state(self) -> str:
        if self.status != "done":
            return "Failed"
        return "Done" if self.existing_outputs() else "Files missing"

    def matches_path(self, path: str) -> bool:
        p = os.path.abspath(path)
        return p == self.input or p in self.outputs


def load_history(path: Path | None = None) -> list[HistoryEntry]:
    """Transcribed files, newest first. Broken lines are skipped."""
    try:
        text = Path(path or FILE_HISTORY).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []
    entries: list[HistoryEntry] = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            h = json.loads(line)
            entries.append(HistoryEntry(
                raw=line, time=int(h.get("time") or 0), input=str(h["input"]),
                outputs=[str(o) for o in h.get("outputs") or [] if o],
                model=str(h.get("model") or ""), language=str(h.get("language") or ""),
                device=str(h.get("device") or ""), duration=float(h.get("duration") or 0.0),
                status=str(h.get("status") or "done")))
        except (ValueError, TypeError, KeyError, AttributeError):
            continue
    entries.reverse()  # equal times: the later line first (sort is stable)
    entries.sort(key=lambda e: e.time, reverse=True)
    return entries


def remove_history_entries(raws: set[str], path: Path | None = None) -> int:
    """Drop the given lines from history.jsonl, rewriting it in place under the same
    flock npu-transcribe takes for appending (so a concurrent append is not lost)."""
    path = Path(path or FILE_HISTORY)
    with open(path, "r+", encoding="utf-8", errors="surrogateescape") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        lines = f.read().splitlines(keepends=True)
        keep = [ln for ln in lines if ln.strip() not in raws]
        removed = len(lines) - len(keep)
        if removed:
            f.seek(0)
            f.writelines(keep)
            f.truncate()
    return removed


# ============================================================================ npu-transcribe output

PROGRESS_RE = re.compile(r":\s+(\?|\d+)%\s+(\d+:\d\d:\d\d)/(\S+)\s+elapsed\s+(\d+:\d\d:\d\d)"
                         r"\s+speed\s+(\S+)\s*$")
LOG_PREFIX = "npu-transcribe: "


def parse_hms(text: str) -> int | None:
    try:
        h, m, s = (int(x) for x in text.split(":"))
        return h * 3600 + m * 60 + s
    except ValueError:
        return None


def parse_transcribe_line(line: str) -> dict:
    """Classify one stderr line of npu-transcribe. Without a terminal it prints log
    lines "npu-transcribe: ..." and, after each ~2 min audio block, a progress line
    "NAME:  40%  00:02:00/00:05:00  elapsed 00:00:10  speed 12.0x"."""
    line = line.rstrip("\r\n")
    if line.startswith(LOG_PREFIX):
        msg = line[len(LOG_PREFIX):]
        for prefix, kind in (("ERROR: ", "error"), ("error: ", "error"), ("WARNING: ", "warning"),
                             ("done: ", "done")):
            if msg.startswith(prefix):
                return {"kind": kind, "text": msg[len(prefix):]}
        if msg.startswith(("loading ", "reloading ")):
            return {"kind": "loading", "text": msg, "compile": "compiles the model" in msg}
        if msg.startswith("model ready"):
            return {"kind": "ready", "text": msg}
        if msg.startswith("language: "):
            return {"kind": "language", "language": msg.split()[1], "text": msg}
        if msg == "interrupted":
            return {"kind": "interrupted", "text": msg}
        return {"kind": "info", "text": msg}
    m = PROGRESS_RE.search(line)
    if m:
        done, total = parse_hms(m[2]), (None if m[3] == "?" else parse_hms(m[3]))
        percent = None if m[1] == "?" else int(m[1])
        fraction = min(1.0, done / total) if total else (percent / 100 if percent is not None else None)
        try:
            speed = float(m[5].rstrip("x"))
        except ValueError:
            speed = None
        return {"kind": "progress", "percent": percent, "done": done, "total": total,
                "fraction": fraction, "speed": speed}
    return {"kind": "other", "text": line}


# ============================================================================ command line

def parse_cli(argv: list[str], cwd: str | None = None) -> dict:
    """[PAGE] [--id ID] [--file PATH]... [FILE...] -> {"page", "id", "files"}. Files become
    absolute paths, because they may be forwarded to a window with another cwd."""
    cwd = cwd or os.getcwd()
    page, meeting_id, files = None, None, []
    args, only_files = list(argv), False
    while args:
        a = args.pop(0)
        if only_files:
            files.append(a)
        elif a == "--":
            only_files = True
        elif a == "--id" and args:
            meeting_id = args.pop(0)
        elif a.startswith("--id="):
            meeting_id = a[5:]
        elif a == "--file" and args:
            files.append(args.pop(0))
        elif a.startswith("--file="):
            files.append(a[7:])
        elif a in PAGES and page is None and not files:
            page = a
        elif a.startswith("-") and a != "-":
            raise ValueError(f"unknown option or missing value: {a}")
        else:
            files.append(a)

    def absolute(f: str) -> str:
        if f.startswith("file:"):
            f = QUrl(f).toLocalFile()
        return os.path.abspath(os.path.join(cwd, os.path.expanduser(f)))
    return {"page": page, "id": meeting_id or None, "files": [absolute(f) for f in files if f]}


# ============================================================================ processes & desktop

def run_command(parent: QObject, cmd: list[str], callback=None, timeout_ms: int = 300_000) -> QProcess:
    """Run cmd without blocking the UI; callback(exit_code, stdout, stderr) once.
    exit_code is -1 when the program could not start or crashed/timed out."""
    proc = QProcess(parent)
    proc.setProgram(cmd[0])
    proc.setArguments(cmd[1:])
    state = {"done": False}

    def finish(code: int, out: str, err: str) -> None:
        if state["done"]:
            return
        state["done"] = True
        timer.stop()
        debug("exit", code, shlex.join(cmd))
        if callback:
            callback(code, out, err)
        proc.deleteLater()

    def on_finished(code: int, status: QProcess.ExitStatus) -> None:
        try:
            out = proc.readAllStandardOutput().data().decode(errors="replace")
            err = proc.readAllStandardError().data().decode(errors="replace")
        except RuntimeError:  # the parent (window) is being destroyed: nobody to tell
            state["done"] = True
            return
        finish(code if status == QProcess.ExitStatus.NormalExit else -1, out, err)

    def on_error(error: QProcess.ProcessError) -> None:
        if error == QProcess.ProcessError.FailedToStart and not state["done"]:
            finish(-1, "", f"could not start {cmd[0]}")

    timer = QTimer(proc, singleShot=True, interval=timeout_ms)
    timer.timeout.connect(proc.kill)
    proc.finished.connect(on_finished)
    proc.errorOccurred.connect(on_error)
    debug("run", shlex.join(cmd))
    proc.start()
    timer.start()
    return proc


def run_detached(cmd: list[str]) -> int | None:
    """Start and forget (outlives the window); returns the pid. Logged only in dry-run."""
    debug("detached" + (" (dry run)" if DRY_RUN else ""), shlex.join(cmd))
    if DRY_RUN:
        return None
    ok, pid = QProcess.startDetached(cmd[0], cmd[1:])
    return pid if ok else None


def open_url(url: QUrl) -> None:
    debug("open" + (" (dry run)" if DRY_RUN else ""), url.toString())
    if not DRY_RUN:
        QDesktopServices.openUrl(url)


def open_path(path: str) -> None:
    open_url(QUrl.fromLocalFile(path))


def show_in_folder(path: str) -> None:
    """Open the file manager with `path` selected (org.freedesktop.FileManager1,
    which Dolphin implements); fall back to opening the folder."""
    debug("show-in-folder" + (" (dry run)" if DRY_RUN else ""), path)
    if DRY_RUN:
        return
    if MAC and bmeetmac.reveal(Path(path)):   # Finder
        return
    try:
        from PyQt6.QtDBus import QDBusConnection, QDBusMessage
        msg = QDBusMessage.createMethodCall("org.freedesktop.FileManager1", "/org/freedesktop/FileManager1",
                                            "org.freedesktop.FileManager1", "ShowItems")
        msg.setArguments([[QUrl.fromLocalFile(path).toString()], ""])
        if QDBusConnection.sessionBus().send(msg):
            return
    except Exception as exc:  # no D-Bus: plain folder
        debug("FileManager1 failed:", exc)
    QDesktopServices.openUrl(QUrl.fromLocalFile(str(Path(path).parent)))


def move_to_trash(path: str) -> bool:
    debug("trash", path)
    ok, _ = QFile.moveToTrash(path)
    return bool(ok)


def notify(summary: str, body: str, icon: str = "view-media-lyrics") -> None:
    if MAC:
        debug("notify", summary, body)
        if not DRY_RUN:
            bmeetmac.notify(summary, body)
        return
    run_detached(["notify-send", f"--app-name={APP_NAME}", f"--icon={icon}", summary, body])


def icon(name: str, *fallbacks: str) -> QIcon:
    for n in (name, *fallbacks):
        if QIcon.hasThemeIcon(n):
            return QIcon.fromTheme(n)
    return QIcon.fromTheme(name)


# macOS has no freedesktop icon theme: the standard icons Qt draws itself stand in for the
# theme icons the window uses (on Linux the theme has them, so this changes nothing there).
THEME_FALLBACKS = {
    "document-open": "SP_DialogOpenButton", "edit-delete": "SP_TrashIcon", "list-remove": "SP_DialogDiscardButton",
    "edit-find": "SP_FileDialogContentsView", "media-playback-start": "SP_MediaPlay",
    "media-playback-stop": "SP_MediaStop", "media-playback-pause": "SP_MediaPause",
    "document-save": "SP_DialogSaveButton", "document-export": "SP_DialogSaveButton",
    "edit-copy": "SP_FileDialogDetailedView", "folder-open": "SP_DirOpenIcon", "view-refresh": "SP_BrowserReload",
    "dialog-warning": "SP_MessageBoxWarning", "dialog-error": "SP_MessageBoxCritical",
    "dialog-information": "SP_MessageBoxInformation", "meeting-attending": "SP_ComputerIcon",
    "view-media-lyrics": "SP_FileIcon", "document-import": "SP_ArrowDown", "audio-input-microphone": "SP_MediaVolume",
}
if MAC:
    _from_theme = QIcon.fromTheme

    def _theme_or_standard(name: str, *rest) -> QIcon:
        if (symbol := mac_icon(name)) is not None:   # (BMeet's own choice of SF Symbol first)
            return symbol
        found = _from_theme(name, *rest)
        if found.isNull() and name in THEME_FALLBACKS and QApplication.instance() is not None:
            return QApplication.style().standardIcon(getattr(QStyle.StandardPixmap, THEME_FALLBACKS[name]))
        return found
    QIcon.fromTheme = staticmethod(_theme_or_standard)


def message_html(title: str, body: str = "", kind: str = "info") -> str:
    color = {"error": COLORS["red"], "busy": COLORS["blue"]}.get(kind)
    style = f' style="color:{color}"' if color else ""
    text = f"<h3{style}>{html.escape(title)}</h3>"
    if body:
        text += "<p>" + html.escape(body).replace("\n", "<br>") + "</p>"
    return text


# ============================================================================ widgets

class StateDot(QWidget):
    """Small coloured circle in front of a state label."""

    def __init__(self) -> None:
        super().__init__()
        self.setFixedSize(12, 12)
        self._color = QColor(COLORS["gray"])

    def set_color(self, color: str) -> None:
        if QColor(color) != self._color:
            self._color = QColor(color)
            self.update()

    def paintEvent(self, _event) -> None:
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(self._color)
        p.drawEllipse(self.rect().adjusted(1, 1, -1, -1))


def state_widget() -> tuple[QWidget, StateDot, QLabel]:
    w = QWidget()
    lay = QHBoxLayout(w)
    lay.setContentsMargins(6, 0, 6, 0)
    lay.setSpacing(6)
    dot, label = StateDot(), QLabel()
    lay.addWidget(dot)
    lay.addWidget(label)
    return w, dot, label


class Banner(QFrame):
    """Inline message strip in the style of KDE's KMessageWidget."""

    def __init__(self, kind: str = "warning") -> None:
        super().__init__()
        self._lay = QHBoxLayout(self)
        self._lay.setContentsMargins(10, 6, 6, 6)
        self.icon = QLabel()
        self.text = QLabel()
        self.text.setWordWrap(True)
        self.text.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        self._lay.addWidget(self.icon)
        self._lay.addWidget(self.text, 1)
        self.set_kind(kind)

    def set_kind(self, kind: str) -> None:
        self.kind = kind
        name = {"warning": "dialog-warning", "error": "dialog-error"}.get(kind, "dialog-information")
        self.icon.setPixmap(QIcon.fromTheme(name).pixmap(22, 22))
        self.update()

    def add_button(self, text: str, slot, icon_name: str = "") -> QPushButton:
        btn = QPushButton(QIcon.fromTheme(icon_name) if icon_name else QIcon(), text)
        btn.clicked.connect(slot)
        self._lay.addWidget(btn)
        return btn

    def paintEvent(self, _event) -> None:
        c = QColor(COLORS[{"warning": "orange", "error": "red"}.get(self.kind, "blue")])
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setPen(QPen(c, 1))
        fill = QColor(c)
        fill.setAlpha(40)
        p.setBrush(fill)
        p.drawRoundedRect(self.rect().adjusted(0, 0, -1, -1), 4, 4)


class DropZone(QFrame):
    """Dashed area that accepts dropped files, with a "Choose files…" button."""
    files_dropped = pyqtSignal(list)
    browse = pyqtSignal()

    def __init__(self) -> None:
        super().__init__()
        self.setAcceptDrops(True)
        self.setMinimumHeight(130)
        self._hover = False
        lay = QVBoxLayout(self)
        lay.setContentsMargins(16, 14, 16, 14)
        pic = QLabel()
        pic.setPixmap(icon("document-import").pixmap(48, 48))
        pic.setAlignment(Qt.AlignmentFlag.AlignCenter)
        text = QLabel("Drop audio or video files here")
        text.setAlignment(Qt.AlignmentFlag.AlignCenter)
        f = text.font()
        f.setPointSizeF(f.pointSizeF() * 1.15)
        text.setFont(f)
        btn = QPushButton(QIcon.fromTheme("document-open"), "Choose files…")
        btn.clicked.connect(self.browse)
        row = QHBoxLayout()
        row.addStretch()
        row.addWidget(btn)
        row.addStretch()
        lay.addStretch()
        lay.addWidget(pic)
        lay.addWidget(text)
        lay.addLayout(row)
        lay.addStretch()

    @staticmethod
    def _paths(event) -> list[str]:
        md = event.mimeData()
        return [u.toLocalFile() for u in md.urls() if u.isLocalFile()] if md.hasUrls() else []

    def dragEnterEvent(self, event) -> None:
        if self._paths(event):
            event.acceptProposedAction()
            self._hover = True
            self.update()

    def dragLeaveEvent(self, _event) -> None:
        self._hover = False
        self.update()

    def dropEvent(self, event) -> None:
        self._hover = False
        self.update()
        paths = self._paths(event)
        if paths:
            event.acceptProposedAction()
            self.files_dropped.emit(paths)

    def paintEvent(self, _event) -> None:
        pal = self.palette()
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        color = pal.color(QPalette.ColorRole.Highlight) if self._hover else pal.color(QPalette.ColorRole.Mid)
        pen = QPen(color, 2 if self._hover else 1.5, Qt.PenStyle.DashLine)
        p.setPen(pen)
        fill = QColor(pal.color(QPalette.ColorRole.Highlight))
        fill.setAlpha(30 if self._hover else 0)
        p.setBrush(fill)
        p.drawRoundedRect(self.rect().adjusted(2, 2, -2, -2), 8, 8)


class MarkdownView(QTextBrowser):
    """Read-only transcript view; highlights the search terms."""

    def __init__(self) -> None:
        super().__init__()
        self.setOpenLinks(False)
        self.anchorClicked.connect(open_url)
        self.document().setDocumentMargin(12)
        self._terms: list[str] = []
        self._paragraphs: list[str] | None = None  # shown by show_paragraphs(), one block each

    def show_markdown(self, text: str) -> None:
        self._paragraphs = None
        self.setMarkdown(text)
        if MAC:
            mac_typography(self.document())
        self._highlight()

    def show_plain(self, text: str) -> None:
        self._paragraphs = None
        self.setPlainText(text)
        self._highlight()

    def show_message(self, html_text: str) -> None:
        self._paragraphs = None
        self.setHtml(html_text)
        self.setExtraSelections([])

    def show_paragraphs(self, paragraphs: list[str]) -> None:
        """Markdown paragraphs that each make one block (a heading, a line of text). When
        the ones shown before start the same, only the rest is redone: a live transcript
        changes at its end, and laying out all of an hour's text took ~40 ms each time."""
        doc, old = self.document(), self._paragraphs
        if old is None or self._terms or doc.blockCount() != len(old):
            self.show_markdown("\n\n".join(paragraphs))
            self._paragraphs = paragraphs
            return
        k = 0
        while k < min(len(old), len(paragraphs)) and old[k] == paragraphs[k]:
            k += 1
        if k == len(old) == len(paragraphs):
            return
        if k == len(paragraphs):  # (only some gone at the end: rare)
            self.show_markdown("\n\n".join(paragraphs))
            self._paragraphs = paragraphs
            return
        cur = QTextCursor(doc.findBlockByNumber(min(k, doc.blockCount() - 1)))
        if k >= doc.blockCount():  # (only new ones: they start a block of their own)
            cur.movePosition(QTextCursor.MoveOperation.End)
            cur.insertBlock()
        cur.movePosition(QTextCursor.MoveOperation.End, QTextCursor.MoveMode.KeepAnchor)
        cur.removeSelectedText()
        rest = QTextDocument()
        rest.setMarkdown("\n\n".join(paragraphs[k:]))
        cur.insertFragment(QTextDocumentFragment(rest))
        # (the first one took the format of the block it went into)
        QTextCursor(doc.findBlockByNumber(k)).setBlockFormat(rest.firstBlock().blockFormat())
        if MAC:
            mac_typography(doc, k)
        self._paragraphs = paragraphs if doc.blockCount() == len(paragraphs) else None

    def set_terms(self, terms: list[str]) -> None:
        if terms != self._terms:
            self._terms = terms
            self._highlight()

    def _highlight(self) -> None:
        selections, first = [], None
        fmt = QTextCharFormat()
        color = QColor(self.palette().color(QPalette.ColorRole.Highlight))
        color.setAlpha(110)
        fmt.setBackground(color)
        doc = self.document()
        for term in self._terms:
            cur = QTextCursor(doc)
            for _ in range(500):
                cur = doc.find(term, cur)
                if cur.isNull():
                    break
                sel = QTextEdit.ExtraSelection()
                sel.cursor, sel.format = QTextCursor(cur), fmt
                selections.append(sel)
                if first is None or cur.position() < first:
                    first = cur.position()
        self.setExtraSelections(selections)
        if first is not None:
            c = QTextCursor(doc)
            c.setPosition(first)
            self.setTextCursor(c)
            self.ensureCursorVisible()
        else:
            self.moveCursor(QTextCursor.MoveOperation.Start)


class SortItem(QTreeWidgetItem):
    """Sorts by SORT_ROLE data (dates, durations) instead of the displayed text."""

    def __lt__(self, other: QTreeWidgetItem) -> bool:
        tree = self.treeWidget()
        col = tree.sortColumn() if tree else 0
        a, b = self.data(col, SORT_ROLE), other.data(col, SORT_ROLE)
        if a is None or b is None or type(a) is not type(b):
            return self.text(col).casefold() < other.text(col).casefold()
        return a < b


