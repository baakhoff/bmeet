@dataclass
class Job:
    path: str
    state: str = "ready"   # ready -> queued -> running -> done | failed | cancelled
    model: str = "turbo"
    language: str = "auto"
    translate: bool = False
    phase: str = ""
    fraction: float | None = None
    remaining: float | None = None
    language_found: str = ""
    error: str = ""
    log: list[str] = field(default_factory=list)
    outputs: list[str] = field(default_factory=list)
    started: float = 0.0
    item: QTreeWidgetItem | None = None
    proc: QProcess | None = None
    cancel_requested: bool = False
    _err_buf: str = ""
    _out_buf: str = ""

    @property
    def name(self) -> str:
        return os.path.basename(self.path)

    def args(self) -> list[str]:
        return (["--model", self.model, "--language", self.language]
                + (["--translate"] if self.translate else []) + ["--", self.path])

    def options_text(self) -> str:
        if self.state == "ready":
            return "–"
        lang = {"auto": "auto language"}.get(self.language, self.language)
        return f"{self.model} · {lang}" + (" → English" if self.translate else "")

    def status_text(self) -> str:
        if self.state == "running":
            if self.fraction is not None:
                return f"{self.fraction * 100:.0f} %"
            return self.phase or "Starting…"
        return {"ready": "Ready", "queued": "Waiting", "done": "Done",
                "cancelled": "Cancelled"}.get(self.state, f"Failed: {self.error}")


