# ============================================================================ small helpers

def fmt_duration(seconds: float | None) -> str:
    if seconds is None or seconds < 0:
        return "–"
    s = int(round(seconds))
    return f"{s // 3600}:{s % 3600 // 60:02d}:{s % 60:02d}" if s >= 3600 else f"{s // 60}:{s % 60:02d}"


def fmt_date(epoch: float | None, long: bool = False) -> str:
    if not epoch:
        return "–"
    fmt = "ddd d MMM yyyy, HH:mm" if long else "yyyy-MM-dd HH:mm"
    return QLocale().toString(QDateTime.fromSecsSinceEpoch(int(epoch)), fmt)


def configured_languages() -> list[str]:
    """Dictation languages from ~/.config/bmeet/languages (via bmeet-ctl)."""
    if ctl is not None and hasattr(ctl, "languages"):
        try:
            return ctl.languages()
        except Exception as exc:  # unreadable file etc.: offer English only
            debug("languages:", exc)
    return ["en"]


def language_name(code: str) -> str:
    """English name of a Whisper language code ("de" -> "German"), else the code."""
    loc = QLocale(code)
    if loc.language() in (QLocale.Language.C, QLocale.Language.AnyLanguage) \
            or loc.name().split("_")[0] != code:
        return code.upper()
    return QLocale.languageToString(loc.language())


def tilde(path: str | Path) -> str:
    p, home = str(path), str(HOME)
    return "~" + p[len(home):] if p == home or p.startswith(home + "/") else p


def stat_sig(path: Path | str) -> tuple | None:
    try:
        st = os.stat(path)
        return st.st_mtime_ns, st.st_size
    except OSError:
        return None


def read_text(path: str, limit: int = 16 << 20) -> str | None:
    try:
        with open(path, "rb") as f:
            return f.read(limit).decode("utf-8", errors="replace")
    except OSError:
        return None


def safe_filename(name: str) -> str:
    name = re.sub(r"[/\x00-\x1f]+", " ", name).strip(" .")
    return name or "transcript"


def pid_alive(pid: int | None) -> bool:
    """True while `pid` runs (zombies count as gone)."""
    if not pid:
        return False
    if not os.path.isdir("/proc"):   # macOS: no /proc
        try:
            if os.waitpid(pid, os.WNOHANG)[0] == pid:   # our child, and it has ended (now reaped)
                return False
        except ChildProcessError:   # (not our child: detached)
            pass
        except OSError:
            return False
        try:
            os.kill(pid, 0)
            return True
        except ProcessLookupError:
            return False
        except PermissionError:
            return True
    try:
        with open(f"/proc/{pid}/stat") as f:
            return f.read().rsplit(")", 1)[1].split()[0] != "Z"
    except (OSError, IndexError):
        return False


class TextCache:
    """File contents for the search box, re-read only when mtime/size change."""

    def __init__(self) -> None:
        self._data: dict[str, tuple[tuple, str]] = {}

    def get(self, path: str | None) -> str | None:
        if not path:
            return None
        sig = stat_sig(path)
        if sig is None:
            return None
        hit = self._data.get(path)
        if hit and hit[0] == sig:
            return hit[1]
        text = read_text(path)
        if text is not None:
            self._data[path] = (sig, text)
        return text


def search_terms(query: str) -> list[str]:
    return query.casefold().split()


def matches(terms: list[str], *texts: str | None) -> bool:
    """All terms (case-insensitive) occur somewhere in the texts."""
    if not terms:
        return True
    hay = "\n".join(t for t in texts if t).casefold()
    return all(t in hay for t in terms)


_MIME_DB: QMimeDatabase | None = None


def is_media(path: str) -> bool:
    global _MIME_DB
    if _MIME_DB is None:
        _MIME_DB = QMimeDatabase()
    mt = _MIME_DB.mimeTypeForFile(path)
    names = [mt.name(), *mt.allAncestors()]
    if mt.name() in NOT_MEDIA:
        return False
    return any(n.startswith(("audio/", "video/")) or n in EXTRA_MEDIA for n in names)


# ============================================================================ data: meetings

MD_NAME = re.compile(r"^(\d{4}-\d{2}-\d{2}_\d{4})-meeting.*\.md$")


@dataclass
class Meeting:
    id: str
    title: str
    started_at: int
    ended_at: int | None = None
    duration_secs: int | None = None
    status: str = ""
    chunk_count: int = 0
    storage_path: str | None = None
    model: str | None = None
    md_path: str | None = None  # Markdown copy in ~/Documents/Meetings, if any
    md_sig: tuple | None = None  # its stat when loaded: the speaker pass replaces it later

    def duration(self) -> int | None:
        if self.duration_secs is not None:
            return int(self.duration_secs)
        if self.ended_at:
            return max(0, int(self.ended_at) - self.started_at)
        return None

    def signature(self) -> tuple:
        return (self.title, self.ended_at, self.duration_secs, self.status, self.chunk_count,
                self.md_path, self.md_sig)

    def stamps(self) -> set[str]:
        """Start stamps this meeting may be filed under (see assign_meeting_mds)."""
        if self.md_path and (m := MD_NAME.match(Path(self.md_path).name)):
            return {m[1]}
        return {minute_stamp(self.started_at), minute_stamp(self.started_at + 10)}


def written_order(name: str) -> tuple[int, int, str]:
    """YYYY-MM-DD_HHMM-meeting.md before -meeting-EPOCH.md: the order the toggle wrote them.
    Anything else after its own (-meeting-speakers.md: the speaker pass's version of a
    transcript you were editing, which stays the meeting's copy)."""
    m = re.search(r"-meeting(?:-(\d+))?(\.md|-.*\.md)$", name)
    return (int(m[1] or 0), m[2] != ".md", name) if m else (0, 1, name)


def minute_stamp(epoch: float) -> str:
    return time.strftime("%Y-%m-%d_%H%M", time.localtime(epoch))


def md_title(path: str) -> str:
    """The "# Title" a meeting transcript starts with ("" if none); remembered per file
    version, as the meetings list reloads often."""
    sig = stat_sig(path)
    if (hit := _MD_TITLES.get(path)) and hit[0] == sig:
        return hit[1]
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            first = f.readline().strip()
    except OSError:
        return ""
    title = first[2:].strip() if first.startswith("# ") else ""
    _MD_TITLES[path] = (sig, title)
    return title


_MD_TITLES: dict[str, tuple[tuple | None, str]] = {}


def assign_meeting_mds(meetings: list[Meeting], md_dir: Path, *more_dirs: Path) -> None:
    """Find the Markdown copy voxtype-meeting-toggle wrote for each meeting:
    MD_DIR/YYYY-MM-DD_HHMM-meeting[-EPOCH].md, named after the start minute. The stamp
    is taken just after `voxtype meeting start` returns, and voxtype's own start time
    can fall in the next or the previous minute (a file stamped 1532 for a meeting
    voxtype started at 15:33:00), so a neighbouring minute counts too when the file's
    title is the meeting's. Two meetings started in the same minute each get their own
    (pick_md: the same rule as bmeet-ctl's pair_mds). more_dirs: other folders with copies
    (on a Mac, where macos/bmeet-meeting saves one it cannot write in md_dir)."""
    groups: dict[str, list[str]] = {}
    for folder in dict.fromkeys(Path(d) for d in (md_dir, *more_dirs)):
        found: dict[str, list[str]] = {}
        try:
            for entry in os.scandir(folder):
                m = MD_NAME.match(entry.name)
                if m and entry.is_file():
                    found.setdefault(m[1], []).append(entry.path)
        except OSError:
            continue
        for stamp, files in found.items():   # (an X-speakers.md goes with the X.md next to it)
            groups.setdefault(stamp, []).extend(without_twins(files))
    for stamp, files in groups.items():
        groups[stamp] = sorted(files, key=lambda p: written_order(os.path.basename(p)))
    titles = collections.Counter(m.title for m in meetings)
    taken: set[str] = set()
    # exact minute, "the start took a moment", then a minute either side with the title
    for offset, by_title in ((0, False), (10, False), (-60, True), (60, True)):
        for m in sorted(meetings, key=lambda m: m.started_at):
            if m.md_path is None and (group := groups.get(minute_stamp(m.started_at + offset))):
                if pick := pick_md(m.title, group, taken, titles, by_title, md_title, m.ended_at):
                    taken.add(pick)
                    m.md_path = pick


def without_twins(paths: list[str]) -> list[str]:
    """Leave out X-speakers.md next to X.md: the speaker pass's version of a transcript you
    edited while it ran, which stays the meeting's copy. (Alone, it is the copy.)"""
    names = {os.path.basename(p) for p in paths}
    return [p for p in paths if not (p.endswith("-speakers.md")
                                     and os.path.basename(p)[:-len("-speakers.md")] + ".md" in names)]


def pick_md(title: str, group: list[str], taken: set[str], titles: collections.Counter, by_title: bool,
            title_of, ended: int | None = None) -> str | None:
    """A meeting's Markdown copy among the files of a minute (group, in the order written):
    the one file of that minute with its title, if no other meeting (titles: how many have
    each title) has it too; else (by_title: not at all) the first
    written that is not taken, that no other meeting can claim by its title alone and,
    named -meeting-EPOCH.md, that was written when this meeting ended (MD_WRITTEN_WITHIN of
    `ended`: the toggle names it when the meeting stops). A title counts only when no other
    file of the minute has it: on 2026-10-15 two meetings shared a recording, and both
    copies got the second one's title. Modification times say nothing: the speaker pass
    rewrites the files."""
    named = [p for p in group if title_of(p) == title]
    if len(named) == 1 and named[0] not in taken and titles[title] == 1:
        return named[0]
    if by_title:
        return next((p for p in named if p not in taken), None)
    others = {t for t, n in titles.items() if t != title and n == 1}  # (theirs alone)
    return next((p for p in group if p not in taken and not (
        title_of(p) in others and sum(title_of(q) == title_of(p) for q in group) == 1)
        and not (ended and written_order(os.path.basename(p))[0]
                 and abs(written_order(os.path.basename(p))[0] - ended) > MD_WRITTEN_WITHIN)), None)


MD_WRITTEN_WITHIN = 600  # s: a -meeting-EPOCH.md copy is named when its meeting stops


def load_meetings(db_path: Path | None = None, md_dir: Path | None = None) -> list[Meeting]:
    """All meetings, newest first, from voxtype's index (opened read-only)."""
    db_path = Path(db_path or MEETING_DB)
    if not db_path.is_file():
        return []
    con = sqlite3.connect(db_path.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
    try:
        rows = con.execute("SELECT id, title, started_at, ended_at, duration_secs, status, "
                           "chunk_count, storage_path, model FROM meetings "
                           "ORDER BY started_at DESC").fetchall()
    finally:
        con.close()
    meetings = [Meeting(id=str(r[0]), title=(r[1] or "").strip() or "Meeting",
                        started_at=int(r[2] or 0), ended_at=r[3], duration_secs=r[4],
                        status=str(r[5] or ""), chunk_count=int(r[6] or 0), storage_path=r[7],
                        model=r[8]) for r in rows]
    # (on a Mac also the index's folder: macos/bmeet-meeting's copies when Documents can't be written)
    assign_meeting_mds(meetings, Path(md_dir or MEETING_MD_DIR), *([db_path.parent] if MAC else []))
    for m in meetings:
        m.md_sig = stat_sig(m.md_path) if m.md_path else None
    return meetings


def export_cmd(meeting_id: str, fmt: str = "markdown", output: str | None = None) -> list[str]:
    cmd = (MEETING_CMD[:] if MAC else [VOXTYPE, "meeting"]) + ["export", "--format", fmt, "--timestamps",
                                                              "--speakers", "--metadata"]
    if output:
        cmd += ["--output", output]
    return cmd + ["--", meeting_id]


# Exports come from the Markdown copy when there is one: voxtype's own transcript (what
# `voxtype meeting export` gives) is the one from during the meeting, without the speaker
# pass (You / Remote, everyone under You in person), the names or the tidying.
MD_INFO = re.compile(r"^- \*\*(.+?):\*\* (.*)$")
MD_STAMPED = re.compile(r"^\*\[(\d+(?::\d\d){1,2})\]\*\s*(.*)$")                 # *[mm:ss]* text
MD_OLD_LINE = re.compile(r"^\*\*\[(\d+(?::\d\d){1,2})\] (.+?):\*\*\s*(.*)$")  # **[h:mm:ss] Who:** text


def md_meeting(text: str) -> tuple[str, dict[str, str], list[tuple[str, str, str]]]:
    """A meeting transcript in voxtype's Markdown layout (the speaker pass and the live
    transcript write it the same way), read back: (title, its "- **Key:** value" info,
    its paragraphs as (time stamp or "", speaker, text))."""
    title, info, paragraphs, section, speaker = "", {}, [], "", ""
    for line in (raw.strip() for raw in text.splitlines()):
        if line.startswith("# ") and not title:
            title = line[2:].strip()
        elif line.startswith("## "):
            section = line[3:].strip()
        elif section == "Meeting Info" and (m := MD_INFO.match(line)):
            info[m[1]] = m[2]
        elif m := MD_OLD_LINE.match(line):
            paragraphs.append((m[1], m[2], m[3]))
        elif section == "Transcript" and line.startswith("### "):
            speaker = line[4:].strip()
        elif section == "Transcript" and line and not line.startswith("*("):
            m = MD_STAMPED.match(line)
            paragraphs.append((m[1], speaker, m[2]) if m else ("", speaker, line))
    return title, info, paragraphs


def stamp_seconds(stamp: str) -> int | None:
    if not stamp:
        return None
    seconds = 0
    for part in stamp.split(":"):
        seconds = seconds * 60 + int(part)
    return seconds


def meeting_export(m: Meeting, text: str, fmt: str) -> str:
    """The Markdown copy `text` of meeting m as an export: itself, or in voxtype's plain text
    or JSON layout."""
    if fmt == "markdown":
        return text
    title, info, paragraphs = md_meeting(text)
    title = title or m.title
    words = sum(len(t.split()) for _, _, t in paragraphs)
    speakers = list(dict.fromkeys(s for _, s, _ in paragraphs if s))
    if fmt == "json":
        return json.dumps({
            "metadata": {"id": m.id, "title": title,
                         "startedAt": QDateTime.fromSecsSinceEpoch(int(m.started_at)).toString(Qt.DateFormat.ISODate)
                         if m.started_at else None,
                         "durationSecs": m.duration(), "status": m.status, "info": info},
            "transcript": {"segments": [{"id": i, "startMs": None if (sec := stamp_seconds(st)) is None else sec * 1000,
                                         "text": t, "speaker": s or None}
                                        for i, (st, s, t) in enumerate(paragraphs)],
                           "wordCount": words, "speakers": speakers},
        }, ensure_ascii=False, indent=2) + "\n"
    out = [title] + [f"{key}: {info[key]}" for key in ("Date", "Duration", "Speakers") if key in info]
    out += [f"Words: {words}", "", "=" * 60, ""]
    last = ""
    for stamp, speaker, t in paragraphs:  # (voxtype's layout: the name on its own line at each change)
        line = f"[{stamp}] " if stamp else ""
        if speaker and speaker != last:
            if last:
                out.append("")
            line += f"{speaker}:\n"
            last = speaker
        out.append(line + t)
    return "\n".join(out) + "\n"


