def mac_typography(doc: QTextDocument, first: int = 0) -> None:
    """A transcript in the type of macOS: the title a size up, the sections ("Meeting Info",
    "Transcript") as small gray capitals, the speakers in semibold accent blue, the [mm:ss]
    times in the secondary gray. From block `first` on (a live transcript only grows at its end)."""
    from PyQt6.QtGui import QFont, QTextFormat
    secondary = QApplication.palette().color(QPalette.ColorRole.PlaceholderText)
    block = doc.findBlockByNumber(first)
    while block.isValid():
        level = block.blockFormat().headingLevel()
        cur = QTextCursor(block)
        if level:
            cur.movePosition(QTextCursor.MoveOperation.EndOfBlock, QTextCursor.MoveMode.KeepAnchor)
            fmt = QTextCharFormat()
            fmt.setProperty(QTextFormat.Property.FontSizeAdjustment, 0)   # (Qt's heading steps, on top of the size)
            bf = block.blockFormat()
            if level == 1:   # (one step up: the header above shows the title too)
                fmt.setProperty(QTextFormat.Property.FontSizeAdjustment, 1)
                fmt.setFontWeight(QFont.Weight.Bold)
                bf.setBottomMargin(6)
            elif level == 2:
                fmt.setFontPointSize(11)
                fmt.setFontWeight(QFont.Weight.DemiBold)
                fmt.setFontCapitalization(QFont.Capitalization.AllUppercase)
                fmt.setFontLetterSpacing(106)
                fmt.setForeground(secondary)
                bf.setTopMargin(16)
                bf.setBottomMargin(4)
            else:
                fmt.setFontPointSize(13)
                fmt.setFontWeight(QFont.Weight.DemiBold)
                fmt.setForeground(QColor(COLORS["blue"]))
                bf.setTopMargin(10)
                bf.setBottomMargin(1)
            cur.mergeCharFormat(fmt)
            cur.setBlockFormat(bf)
        else:
            it = block.begin()
            while not it.atEnd():
                frag = it.fragment()
                if frag.isValid() and frag.charFormat().fontItalic() and frag.text().startswith("["):
                    c = QTextCursor(doc)
                    c.setPosition(frag.position())
                    c.setPosition(frag.position() + frag.length(), QTextCursor.MoveMode.KeepAnchor)
                    fmt = QTextCharFormat()
                    fmt.setForeground(secondary)
                    fmt.setFontItalic(False)
                    c.mergeCharFormat(fmt)
                it += 1
        block = block.next()


MAC_ICONS = APP_FILE.parents[2] / "macos/icons"   # SF Symbols, drawn at install (macos/tools/make-symbols.swift)


def dark_mode() -> bool:
    app = QApplication.instance()
    return app is not None and app.palette().window().color().lightness() < 128


def mac_icon(name: str) -> QIcon | None:
    """The SF Symbol drawn for a theme icon name (light or dark mode), if there is one."""
    path = MAC_ICONS / f"{name}{'-dark' if dark_mode() else ''}.png"
    if not path.is_file():
        return None
    ic = QIcon()
    ic.addFile(str(path))
    return ic


def setup_mac(app: QApplication) -> None:
    """Before the window: Apple's system colors (light or dark) for the states, and the icons."""
    if dark_mode():
        COLORS.update(red="#ff453a", orange="#ff9f0a", green="#30d158", blue="#0a84ff", gray="#98989d")
    else:
        COLORS.update(red="#ff3b30", orange="#ff9500", green="#34c759", blue="#007aff", gray="#8e8e93")


# (only on these widgets: a stylesheet on the whole app would turn off Qt's native macOS drawing)
MAC_NAV_STYLE = """
QListWidget { background: transparent; border: none; outline: 0; }
QListWidget::item { padding: 3px 8px; margin: 1px 8px; border-radius: 6px; }
QListWidget::item:selected { background: palette(highlight); color: palette(highlighted-text); }
"""
MAC_SEARCH_STYLE = "QLineEdit { border: 1px solid palette(mid); border-radius: 7px; padding: 3px 4px; " \
                   "background: palette(base); }"


def apply_mac_look(w: "MainWindow", side: QWidget) -> None:
    """The window as a Mac app: the toolbar in the title bar, a sidebar, ⌘ shortcuts and the
    menus a Mac app has, ⌃⌥ and Finder in its texts. (On Linux it keeps KDE's look.)"""
    w.toolbar.setIconSize(QSize(18, 18))
    # the sidebar: a shade off the window, as Finder's and Mail's
    pal = side.palette()
    base = pal.window().color()
    pal.setColor(QPalette.ColorRole.Window, base.lighter(112) if dark_mode() else base.darker(104))
    side.setPalette(pal)
    side.setAutoFillBackground(True)
    side.layout().setContentsMargins(8, 10, 0, 8)
    side.layout().setSpacing(8)
    w.search.setStyleSheet(MAC_SEARCH_STYLE)
    w.nav.setStyleSheet(MAC_NAV_STYLE)
    w.nav.setIconSize(QSize(18, 18))
    for i in range(w.nav.count()):
        w.nav.item(i).setSizeHint(QSize(0, 30))
    w.split.setHandleWidth(1)
    w.statusBar().setSizeGripEnabled(False)
    for widget in [w, *w.findChildren(QWidget)]:
        if widget.toolTip():
            widget.setToolTip(mac_words(widget.toolTip()))
    for act in w.findChildren(QAction):
        if act.toolTip():
            act.setToolTip(mac_words(act.toolTip()))

    bar = w.menuBar()
    def menu(title: str, items) -> None:
        m = bar.addMenu(title)
        for item in items:
            if item is None:
                m.addSeparator()
                continue
            text, keys, slot, *role = item
            a = QAction(text, w)
            if keys:
                a.setShortcut(QKeySequence(keys))
            a.triggered.connect(slot)
            if role:
                a.setMenuRole(role[0])
            m.addAction(a)
    pages = {name: (lambda _=False, n=name: w.set_page(n)) for name in PAGES}
    menu("File", [("Transcribe Files…", "Ctrl+O", w.open_files), None,
                  ("Close Window", "Ctrl+W", w.close),
                  ("About BMeet", "", lambda: about_mac(w), QAction.MenuRole.AboutRole),
                  ("Settings…", "Ctrl+,", lambda: open_path(str(CONFIG_DIR)), QAction.MenuRole.PreferencesRole),
                  ("Quit BMeet Window", "Ctrl+Q", w.close, QAction.MenuRole.QuitRole)])
    menu("Edit", [("Find", "Ctrl+F", w.focus_search)])
    menu("View", [("Meetings", "Ctrl+1", pages["meetings"]), ("Transcribed Files", "Ctrl+2", pages["files"]),
                  ("Transcribe a File", "Ctrl+3", pages["transcribe"]), None,
                  ("Reload", "Ctrl+R", w.reload_all)])
    controls = bar.addMenu("Controls")
    for act in (w.act_dictate, w.act_cancel, None, w.act_meet_start, w.act_meet_room, w.act_meet_pause,
                w.act_meet_stop):
        if act is None:
            controls.addSeparator()
        else:
            controls.addAction(act)
    menu("Window", [("Minimize", "Ctrl+M", w.showMinimized), ("Zoom", "", lambda: w.showNormal()
                                                                 if w.isMaximized() else w.showMaximized())])
    menu("Help", [("BMeet on a Mac", "", lambda: open_url(QUrl(
        "https://github.com/baakhoff/bmeet/blob/main/docs/macos.md"))),
                  ("BMeet on GitHub", "", lambda: open_url(QUrl("https://github.com/baakhoff/bmeet")))])


CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "bmeet"


def about_mac(parent: QWidget) -> None:
    QMessageBox.about(parent, "About BMeet", f"<h3>BMeet {__version__}</h3>"
                      "<p>Dictation, meeting transcripts and file transcription, on this Mac's "
                      "Neural Engine. Nothing is uploaded.</p>"
                      "<p><a href='https://github.com/baakhoff/bmeet'>github.com/baakhoff/bmeet</a> · MIT</p>")


def main(argv: list[str]) -> int:
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__.strip())
        return 0
    if "--version" in argv:
        print(f"bmeet {__version__}")
        return 0
    try:
        request = parse_cli(argv)
    except ValueError as exc:
        print(f"bmeet: {exc}\n\n{__doc__.strip()}", file=sys.stderr)
        return 2
    request["token"] = os.environ.get("XDG_ACTIVATION_TOKEN", "")

    QGuiApplication.setDesktopFileName(APP_ID)  # Wayland app_id = bmeet.desktop
    app = QApplication([sys.argv[0]])
    app.setApplicationName(APP_ID)
    app.setApplicationDisplayName(APP_NAME)
    app.setWindowIcon(QIcon.fromTheme("audio-input-microphone"))
    if MAC:
        setup_mac(app)

    instance = SingleInstance(socket_path())
    if instance.forward(request):
        debug("forwarded to the running window")
        return 0
    if not instance.lock():  # another first launch is just starting: wait for its server
        deadline = time.monotonic() + 8
        while time.monotonic() < deadline:
            time.sleep(0.2)
            if instance.forward(request):
                debug("forwarded to the running window")
                return 0
        print("bmeet: another instance holds the lock but does not answer", file=sys.stderr)
        return 1

    win = MainWindow()
    instance.listen()
    instance.received.connect(win.handle_remote)
    app.aboutToQuit.connect(win.shutdown)

    def on_signal(*_) -> None:  # SIGTERM/SIGINT: save settings, stop transcriptions, quit
        win.force_quit = True
        app.quit()
    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    win.handle_request(request, initial=True)
    if win.nav.currentRow() < 0:
        win.set_page("meetings")
    win.show()
    debug("ready", instance.path)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
