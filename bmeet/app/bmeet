def load_ctl():
    """Import bmeet-ctl (a script without .py) as a module. Its status() only reads
    a few small files, so the window can poll it every second without spawning anything."""
    try:
        loader = importlib.machinery.SourceFileLoader("bmeet_ctl", str(CTL_PATH))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        return module, None
    except Exception as exc:  # missing/broken: the window still works, minus live state
        return None, f"cannot load {CTL_PATH}: {exc}"


