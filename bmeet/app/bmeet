                err = f"status failed: {exc}"
        self.apply_status(st, err)
        self.check_data()

    def apply_status(self, st: dict | None, error: str | None = None) -> None:
        now = time.time()
        self.status = st
        if st is None:
            self.dict_dot.set_color(COLORS["gray"])
            self.dict_label.setText("Status unavailable")
            self.dict_label.setToolTip(error or "")
            for act in (self.act_dictate, self.act_cancel, self.act_lang, self.act_meet_start,
                        self.act_meet_room, self.act_meet_pause, self.act_meet_stop):
                act.setEnabled(False)
            self.meet_label.setText("")
            return
        daemon_on = st.get("daemon") == "active"
        dictation = st.get("dictation") or "off"
        if dictation == "streaming":
            dictation = "recording"
        self._set_banner(self.daemon_banner, not daemon_on)

        # dictation
        if not daemon_on:
            color, text = COLORS["gray"], f"{ENGINE_TITLE} is off"
        elif dictation == "recording":
            color, text = COLORS["red"], "Listening…"
        elif dictation == "transcribing":
            color, text = COLORS["orange"], "Transcribing…"
        else:
            color, text = COLORS["green"], "Ready to dictate"
        self.dict_dot.set_color(color)
        self.dict_label.setText(text)
        self.dict_label.setToolTip(f"Dictation: {dictation} · model {st.get('model') or '?'} "
                                   f"on {st.get('device') or '?'}")
        if self._dictating_here and self._last_dictation == "transcribing" and dictation == "idle":
            self.message("Dictated text copied to the clipboard: paste it with Ctrl+V")
            self._dictating_here = False
        self._last_dictation = dictation
        recording = dictation == "recording"
        self.act_dictate.setEnabled(daemon_on and dictation in ("idle", "recording"))
        self.act_dictate.setChecked(recording)
        self.act_dictate.setText("Stop dictation" if recording else "Dictate to clipboard")
        self.act_dictate.setIcon(icon("media-playback-stop" if recording else "audio-input-microphone"))
        self.act_dictate.setToolTip(mac_words(
            "Stop listening; the text is transcribed and copied to the clipboard" if recording else
            "Listen until you click again, then copy the text to the clipboard (paste with Ctrl+V).\n"
            "To type straight into another app at its cursor, press Meta+H in that app "
            "(Meta+Alt+H dictates to the clipboard from anywhere)."))
        self.act_cancel.setVisible(daemon_on and dictation in ("recording", "transcribing"))
        self.act_cancel.setEnabled(True)

        # meeting
        meeting = (st.get("meeting") or "idle") if daemon_on else "idle"
        if meeting not in ("recording", "paused"):
            meeting = "idle"
        stopping = pid_alive(self._stop_pid)
        if self._stop_pid and not stopping:
            self._stop_pid = None
            self.meetings_page.reload()
            self.meetings_page.select_newest()
            self.message("Meeting saved")
        if self._meeting_pending and (meeting != "idle" or now > self._meeting_pending[1]):
            self._meeting_pending = None
        if meeting == "idle":
            self._meeting_seen = self._pause_began = None
            self._paused_total = 0.0
            elapsed = None
        else:
            if self._meeting_seen is None:
                self._meeting_seen = now
            if meeting == "paused" and self._pause_began is None:
                self._pause_began = now
            elif meeting == "recording" and self._pause_began is not None:
                self._paused_total += now - self._pause_began
                self._pause_began = None
            started = st.get("meeting_started") or self._meeting_seen
            elapsed = max(0.0, (self._pause_began or now) - started - self._paused_total)
        if stopping:
            color, text = COLORS["blue"], "Saving transcript…"
        elif self._meeting_pending:
            color, text = COLORS["gray"], "Starting…"
        elif meeting == "recording":
            color, text = COLORS["red"], f"Meeting {fmt_duration(elapsed)}"
        elif meeting == "paused":
            color, text = COLORS["orange"], f"Paused {fmt_duration(elapsed)}"
        else:
            color, text = COLORS["gray"], "No meeting"
        self.meet_dot.set_color(color)
        self.meet_label.setText(text)
        self.meet_label.setToolTip(st.get("meeting_title") or "")
        busy = stopping or bool(self._meeting_pending)
        self.act_meet_start.setEnabled(daemon_on and meeting == "idle" and not busy)
        self.act_meet_room.setEnabled(self.act_meet_start.isEnabled())
        self.act_meet_pause.setEnabled(daemon_on and meeting != "idle" and not busy)
        self.act_meet_pause.setText("Resume" if meeting == "paused" else "Pause")
        self.act_meet_pause.setIcon(icon("media-playback-start" if meeting == "paused" else "media-playback-pause"))
        self.act_meet_pause.setToolTip("Continue recording" if meeting == "paused"
                                       else "Pause recording (nothing is recorded until you resume)")
        self.act_meet_stop.setEnabled(daemon_on and meeting != "idle" and not busy)
        self.meetings_page.set_live(st.get("meeting_id"), meeting, elapsed, st.get("meeting_live"))
        pending = set(st.get("speakers_pending") or [])
        if pending != self.meetings_page.speakers_pending:
            finished = self.meetings_page.speakers_pending - pending
            self.meetings_page.set_speakers_pending(pending)
            if finished:  # its Markdown copy was replaced: show the new one
                self.meetings_page.reload()
                self.message("Speakers told apart: the meeting transcript was updated")

        # language
        lang = (st.get("language") or "en").lower()
        if self._lang_pending and (lang != self._lang_pending[0] or now > self._lang_pending[1]):
            self._lang_pending = None
        other = st.get("next_language") or ""
        self.act_lang.setText("…" if self._lang_pending else lang.upper())
        if meeting != "idle":
            why = "Stop the meeting to switch the language"
        elif dictation in ("recording", "transcribing"):
            why = "Wait for the dictation to finish to switch the language"
        elif not other:
            why = (f"Dictation language: {language_name(lang)}. To switch here, list more languages "
                   "in ~/.config/bmeet/languages (e.g. \"en de\").")
        else:
            why = ""
        self.act_lang.setEnabled(not why and not self._lang_pending)
        self.act_lang.setToolTip(why or f"Dictation language: {language_name(lang)}. Click to switch to "
                                 f"{language_name(other)} (" + ("from the next dictation; also ⌃⌥⇧H" if MAC else "restarts voxtype, ~3 s; also Meta+Shift+H") + ").")

    @staticmethod
    def _set_banner(banner: Banner, visible: bool) -> None:
        if banner.wrapper.isHidden() == visible:
            banner.wrapper.setVisible(visible)

    def check_data(self) -> None:
        """Reload a list when its source changed (cheap stat calls, every poll)."""
        shown = self.meetings_page.current()
        sigs = {"meetings": (stat_sig(MEETING_DB), stat_sig(f"{MEETING_DB}-wal"), stat_sig(MEETING_MD_DIR),
                             stat_sig(MEETING_DB.parent) if MAC else None,   # (copies saved there: load_meetings)
                             # the open transcript, also when it is edited in place
                             stat_sig(shown.md_path) if shown and shown.md_path else None),
                "files": (stat_sig(FILE_HISTORY),)}
        changed = False
        for name, sig in sigs.items():
            if self._sigs.get(name) != sig:
                self._sigs[name] = sig
                (self.meetings_page if name == "meetings" else self.files_page).reload()
                changed = True
        if changed:
            self.update_counts()

    def reload_all(self) -> None:
        self._sigs.clear()
        self.check_data()

    # -- actions -----------------------------------------------------------------
    def toggle_dictation(self) -> None:
        recording = (self.status or {}).get("dictation") == "recording"
        self.act_dictate.setChecked(recording)  # the daemon's state decides, not the click
        self._dictating_here = True
        if MAC:   # (BMeet.app dictates; from the window the text goes to the clipboard, as on Linux)
            self._side_effect([sys.executable, "-I", str(CTL_PATH), "dictate", "--clipboard"], "Dictation")
            return
        self._side_effect([VOXTYPE, "record", "toggle", "--clipboard"], "Dictation")

    def cancel_dictation(self) -> None:
        self._dictating_here = False
        if MAC:
            self._side_effect([sys.executable, "-I", str(CTL_PATH), "cancel"], "Cancel")
            return
        self._side_effect([VOXTYPE, "record", "cancel"], "Cancel")

    def toggle_language(self) -> None:
        lang = ((self.status or {}).get("language") or "en").lower()
        target = (self.status or {}).get("next_language")
        if not target:
            return
        self._lang_pending = (lang, time.time() + 15)
        run_detached([sys.executable, "-I", str(CTL_PATH), "lang", target] if MAC
                     else [str(BIN / "voxtype-lang"), target])
        self.act_lang.setText("…")
        self.act_lang.setEnabled(False)

    def start_meeting(self, in_person: bool = False) -> None:
        self._meeting_pending = ("starting", time.time() + 10)
        cmd = [sys.executable, "-I", str(CTL_PATH), "meeting"] if MAC else [str(BIN / "voxtype-meeting-toggle")]
        run_detached(cmd + ["start"] + (["--in-person"] if in_person else []))
        self.poll()

    def stop_meeting(self) -> None:
        # Detached: it waits for the last chunk (can take minutes) and must outlive the window.
        cmd = [sys.executable, "-I", str(CTL_PATH), "meeting"] if MAC else [str(BIN / "voxtype-meeting-toggle")]
        self._stop_pid = run_detached(cmd + ["stop"])
        self.poll()

    def pause_meeting(self) -> None:
        action = "resume" if (self.status or {}).get("meeting") == "paused" else "pause"
        cmd = [sys.executable, "-I", str(CTL_PATH), "meeting"] if MAC else [VOXTYPE, "meeting"]
        self._side_effect(cmd + [action], action.capitalize())

    def start_daemon(self) -> None:
        if MAC:   # BMeet.app (the menu bar app) dictates and records
            run_detached(["open", "-g", "-b", "io.github.baakhoff.bmeet"])
            QTimer.singleShot(2000, self.poll)
            return
        self.start_daemon_btn.setEnabled(False)
        self.daemon_banner.text.setText("Starting voxtype…")

        def done(code: int, _out: str, err: str) -> None:
            self.start_daemon_btn.setEnabled(True)
            if code == 0:
                self.daemon_banner.set_kind("warning")
                self.daemon_banner.text.setText("Voxtype is not running: dictation and meeting "
                                                "recording are unavailable.")
            else:
                self.daemon_banner.set_kind("error")
                self.daemon_banner.text.setText("Could not start voxtype: " + (err.strip() or f"status {code}")
                                                + "\nDetails: journalctl --user -u voxtype")
            self.poll()
        if DRY_RUN:
            debug("run (dry run)", "systemctl --user start voxtype")
            QTimer.singleShot(0, lambda: done(0, "", ""))
        else:
            run_command(self, ["systemctl", "--user", "start", "voxtype"], done, timeout_ms=60_000)

    def _side_effect(self, cmd: list[str], what: str) -> None:
        """Quick voxtype command (records audio etc.): async; logged only in dry-run."""
        if DRY_RUN:
            debug("run (dry run)", shlex.join(cmd))
            return

        def done(code: int, _out: str, err: str) -> None:
            if code != 0:
                self.message(f"{what} failed: {err.strip() or f'status {code}'}")
            self.poll()
        run_command(self, cmd, done, timeout_ms=15_000)

    # -- pages, search -------------------------------------------------------------
    def set_page(self, name: str) -> None:
        if name in PAGES:
            self.nav.setCurrentRow(PAGES.index(name))

    def page(self) -> str:
        return PAGES[max(0, self.stack.currentIndex())]

    def _page_changed(self, row: int) -> None:
        if row < 0:
            return
        self.stack.setCurrentIndex(row)
        self.setWindowTitle(PAGE_TITLES[PAGES[row]])
        self.settings.setValue("page", PAGES[row])

    def focus_search(self) -> None:
        self.search.setFocus()
        self.search.selectAll()

    def open_files(self) -> None:
        self.set_page("transcribe")
        self.transcribe_page.browse()

    def apply_search(self) -> None:
        terms = search_terms(self.search.text())
        self.meetings_page.set_filter(terms)
        self.files_page.set_filter(terms)
        self.update_counts()

    def update_counts(self) -> None:
        for row, page in ((0, self.meetings_page), (1, self.files_page)):
            shown, total = page.counts()
            base = PAGE_TITLES[PAGES[row]]
            self.nav.item(row).setText(base if not total else
                                       f"{base} ({shown}/{total})" if shown != total else f"{base} ({total})")
        pending = self.transcribe_page.pending()
        self.nav.item(2).setText(PAGE_TITLES["transcribe"] + (f" ({pending})" if pending else ""))

    def message(self, text: str, ms: int = 8000) -> None:
        text = mac_words(text)
        debug("message:", text)
        self.statusBar().showMessage(text, ms)

    def error_box(self, title: str, text: str) -> None:
        debug("error:", title, "-", text)
        QMessageBox.warning(self, title, text)

    # -- transcription results ---------------------------------------------------------
    def _job_finished(self, job: Job) -> None:
        self.files_page.reload()
        self.update_counts()
        if job.state == "done":
            self.message(f"Transcribed {job.name}")
            if not self.transcribe_page.pending():
                self.show_job_result(job)
            if not self.isActiveWindow():
                notify("Transcription finished", job.name)
        elif job.state == "failed":
            self.message(f"Transcription of {job.name} failed: {job.error}")
            if not self.isActiveWindow():
                notify("Transcription failed", f"{job.name}: {job.error}", "dialog-error")

    def show_job_result(self, job: Job) -> None:
        key = self.files_page.find_for_job(job)
        if key is not None:
            if self.files_page.item_for(key) and self.files_page.item_for(key).isHidden():
                self.search.clear()
                self.apply_search()
            self.set_page("files")
            self.files_page.select_key(key)
        elif job.outputs:
            md = next((o for o in job.outputs if o.endswith(".md")), job.outputs[0])
            open_path(md)

    # -- requests from the command line / a second launch ---------------------------------
    def handle_request(self, req: dict, initial: bool = False) -> None:
        page = req.get("page") if req.get("page") in PAGES else None
        mid, files = req.get("id"), list(req.get("files") or [])
        debug("request", json.dumps({k: v for k, v in req.items() if k != "token"}))
        if files or mid:
            self.search.clear()
            self.apply_search()
        target, queue = page, []
        for f in files:
            if page == "transcribe" or (page is None and is_media(f)):
                queue.append(f)
            elif page in (None, "files") and self.files_page.select_path(f):
                target = target or "files"
            elif page in (None, "meetings") and self.meetings_page.select_md(f):
                target = target or "meetings"
            elif is_media(f):
                queue.append(f)
            else:
                self.message(f"Not a recording or a transcript from the lists: {f}")
        if queue:
            self.transcribe_page.add_files(queue)
            target = "transcribe"
        if mid:
            if self.meetings_page.select_key(mid):
                target = target or "meetings"
            else:
                self.message(f"Meeting {mid} not found")
                target = target or "meetings"
        if target:
            self.set_page(target)
        elif initial:
            self.set_page(self.settings.value("page", "meetings"))

    def handle_remote(self, req: dict) -> None:
        self.bring_to_front(req.get("token") or "")
        self.handle_request(req)

    def bring_to_front(self, token: str = "") -> None:
        # Wayland: only an activation token from the launcher lets us take focus
        # (Qt uses XDG_ACTIVATION_TOKEN on the next activation); otherwise KWin
        # marks the window as demanding attention.
        if token:
            os.environ["XDG_ACTIVATION_TOKEN"] = token
        if self.isMinimized():
            self.showNormal()
        else:
            self.show()
        self.raise_()
        self.activateWindow()

    # -- settings, closing ---------------------------------------------------------
    def _restore_settings(self) -> None:
        s = self.settings
        if s.value("geometry") is not None:
            self.restoreGeometry(s.value("geometry"))
        else:
            self.resize(1180, 780)
        for key, splitter in (("split/main", self.split), ("split/meetings", self.meetings_page.splitter),
                              ("split/files", self.files_page.splitter)):
            if s.value(key) is not None:
                splitter.restoreState(s.value(key))
        for key, tree in (("header/meetings", self.meetings_page.tree), ("header/files", self.files_page.tree)):
            if s.value(key) is not None:
                tree.header().restoreState(s.value(key))
        self.transcribe_page.set_options(s.value("transcribe/model", "turbo"),
                                         s.value("transcribe/language", "auto"),
                                         s.value("transcribe/translate", False, type=bool))
        self.transcribe_page.log_toggle.setChecked(s.value("transcribe/log", False, type=bool))
        self.nav.blockSignals(True)
        self.nav.setCurrentRow(-1)
        self.nav.blockSignals(False)

    def save_settings(self) -> None:
        s = self.settings
        s.setValue("geometry", self.saveGeometry())
        s.setValue("page", self.page())
        s.setValue("split/main", self.split.saveState())
        s.setValue("split/meetings", self.meetings_page.splitter.saveState())
        s.setValue("split/files", self.files_page.splitter.saveState())
        s.setValue("header/meetings", self.meetings_page.tree.header().saveState())
        s.setValue("header/files", self.files_page.tree.header().saveState())
        s.setValue("transcribe/log", self.transcribe_page.log_toggle.isChecked())
        s.sync()

    def closeEvent(self, event) -> None:
        if not self.force_quit and self.transcribe_page.pending():
            answer = QMessageBox.question(
                self, "Transcription running",
                "A transcription is still running. Quit and cancel it?",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
                QMessageBox.StandardButton.No)
            if answer != QMessageBox.StandardButton.Yes:
                event.ignore()
                return
        self.shutdown()
        event.accept()

    def shutdown(self) -> None:
        if getattr(self, "_shut", False):
            return
        self._shut = True
        self.save_settings()
        self.transcribe_page.stop_all()
        for proc in self.findChildren(QProcess):  # exports still running: not needed any more
            if proc.state() != QProcess.ProcessState.NotRunning:
                proc.kill()
                proc.waitForFinished(1000)


