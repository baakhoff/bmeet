        self._update_hint()

    def _update_hint(self) -> None:
        text = "Transcripts are saved next to each file: NAME.srt (subtitles) and NAME.md (notes)."
        if self.translate.isChecked():
            text += (" Translation works best with the small model (turbo was not trained to translate)."
                     if self.model.currentData() == "turbo" else
                     " Translation uses the small model (turbo was not trained to translate).")
        self.hint.setText(text)

    def options(self) -> dict:
        return {"model": self.model.currentData(), "language": self.language.currentData(),
                "translate": self.translate.isChecked()}

    def set_options(self, model: str, language: str, translate: bool) -> None:
        self.translate.setChecked(bool(translate))
        if (i := self.model.findData(model)) >= 0:
            self.model.setCurrentIndex(i)
        if (i := self.language.findData(language)) >= 0:
            self.language.setCurrentIndex(i)

    # -- queue
    def browse(self) -> None:
        start = self.main.settings.value("transcribe/lastDir", "") or str(HOME)
        paths, _ = QFileDialog.getOpenFileNames(self, "Choose audio or video files", start, MEDIA_FILTER)
        if paths:
            self.main.settings.setValue("transcribe/lastDir", os.path.dirname(paths[0]))
            self.add_files(paths)

    def add_files(self, paths: list[str]) -> int:
        added, skipped = 0, []
        for p in paths:
            p = os.path.abspath(os.path.expanduser(p))
            if not os.path.isfile(p):
                skipped.append(f"{os.path.basename(p)} (not found)")
            elif not is_media(p):
                skipped.append(f"{os.path.basename(p)} (not audio or video)")
            elif any(j.path == p and j.state in ("ready", "queued", "running") for j in self.jobs):
                skipped.append(f"{os.path.basename(p)} (already in the queue)")
            else:
                job = Job(p)
                job.item = QTreeWidgetItem([job.name, "", ""])
                job.item.setToolTip(0, p)
                job.item.setIcon(0, icon("video-x-generic" if is_video(p) else "audio-x-generic"))
                self.jobs.append(job)
                self.queue.addTopLevelItem(job.item)
                self._update_item(job)
                added += 1
        if added:
            self.queue.setCurrentItem(self.jobs[-1].item)
            self.main.message(f"Added {added} file{'s' if added > 1 else ''}: choose the options "
                              "and press Transcribe" + (f" (skipped: {', '.join(skipped)})" if skipped else ""))
        elif skipped:
            self.main.message("Not added: " + ", ".join(skipped))
        self._update_buttons()
        return added

    def start_ready(self) -> None:
        ready = [j for j in self.jobs if j.state == "ready"]
        if not ready:
            self.browse()
            return
        opts = self.options()
        self.main.settings.setValue("transcribe/model", opts["model"])
        self.main.settings.setValue("transcribe/language", opts["language"])
        self.main.settings.setValue("transcribe/translate", opts["translate"])
        for job in ready:
            job.model, job.language, job.translate = opts["model"], opts["language"], opts["translate"]
            job.state = "queued"
            self._update_item(job)
        self._pump()

    def running(self) -> Job | None:
        return next((j for j in self.jobs if j.state == "running"), None)

    def pending(self) -> int:
        return sum(j.state in ("queued", "running") for j in self.jobs)

    def _pump(self) -> None:
        if self.running() is None:
            job = next((j for j in self.jobs if j.state == "queued"), None)
            if job is not None:
                self._start(job)
        self._update_buttons()
        self.main.update_counts()

    def _start(self, job: Job) -> None:
        job.state, job.phase, job.started = "running", "Starting…", time.monotonic()
        job.log.append(f"$ npu-transcribe {shlex.join(job.args())}")
        proc = QProcess(self)
        proc.setProgram(TRANSCRIBE)
        proc.setArguments(job.args())
        proc.readyReadStandardError.connect(lambda: self._read(job, err=True))
        proc.readyReadStandardOutput.connect(lambda: self._read(job, err=False))
        proc.finished.connect(lambda code, status: self._finished(job, code, status))
        proc.errorOccurred.connect(lambda e: self._proc_error(job, e))
        job.proc = proc
        debug("transcribe", TRANSCRIBE, shlex.join(job.args()))
        proc.start()
        self.ticker.start()
        if self._log_job is None or self._log_job.state != "running":
            self.queue.setCurrentItem(job.item)
        self._update_item(job)
        self._update_run_panel()

    def _read(self, job: Job, err: bool) -> None:
        if job.proc is None:
            return
        if err:
            job._err_buf += job.proc.readAllStandardError().data().decode(errors="replace")
            *lines, job._err_buf = job._err_buf.split("\n")
            for line in lines:
                self._stderr_line(job, line)
        else:
            job._out_buf += job.proc.readAllStandardOutput().data().decode(errors="replace")
            *lines, job._out_buf = job._out_buf.split("\n")
            job.outputs += [ln.strip() for ln in lines if ln.strip()]
        self._update_item(job)
        self._update_run_panel()

    def _stderr_line(self, job: Job, line: str) -> None:
        if not line.strip():
            return
        job.log.append(line)
        if self._log_job is job:
            self.log_view.appendPlainText(line)
        info = parse_transcribe_line(line)
        kind = info["kind"]
        if kind == "loading":
            job.phase = ("Preparing the model (the first NPU run compiles it, up to a few minutes)…"
                         if info["compile"] else "Loading the model…")
        elif kind == "ready":
            job.phase = "Transcribing…"
        elif kind == "language":
            job.language_found = info["language"]
        elif kind == "progress":
            job.fraction = info["fraction"]
            job.phase = "Transcribing…"
            if info["speed"] and info["total"]:
                job.remaining = max(0.0, (info["total"] - info["done"]) / info["speed"])
        elif kind == "error":
            job.error = info["text"]
            if job.error.startswith(job.name + ": "):
                job.error = job.error[len(job.name) + 2:]
        elif kind == "info" and not job.error and job.proc is not None:
            job.phase = info["text"][:120]

    def _proc_error(self, job: Job, error: QProcess.ProcessError) -> None:
        if error == QProcess.ProcessError.FailedToStart:
            job.error = f"could not start {TRANSCRIBE}"
            job.log.append(job.error)
            self._finished(job, -1, QProcess.ExitStatus.CrashExit)

    def _finished(self, job: Job, code: int, status: QProcess.ExitStatus) -> None:
        if job.state != "running":
            return
        if job.proc is not None:
            self._read(job, err=True)
            self._read(job, err=False)
            last_err, last_out = job._err_buf, job._out_buf  # lines without a final newline
            job._err_buf = job._out_buf = ""
            if last_err.strip():
                self._stderr_line(job, last_err)
            if last_out.strip():
                job.outputs.append(last_out.strip())
            job.proc.deleteLater()
            job.proc = None
        if job.cancel_requested:
            job.state = "cancelled"
        elif status == QProcess.ExitStatus.NormalExit and code == 0:
            job.state, job.fraction = "done", 1.0
        else:
            job.state = "failed"
            job.error = job.error or (f"exit status {code}" if code >= 0 else "crashed")
        job.log.append(f"[{job.state}, exit status {code}]")
        if self._log_job is job:
            self.log_view.appendPlainText(job.log[-1])
        debug("job", job.state, job.path, job.outputs)
        self._update_item(job)
        if self.running() is None and not any(j.state == "queued" for j in self.jobs):
            self.ticker.stop()
        self._pump()
        self._update_run_panel()
        self.job_finished.emit(job)

    def cancel_current(self) -> None:
        job = self.running()
        if job is None or job.proc is None:
            return
        job.cancel_requested = True
        job.phase = "Cancelling…"
        self._update_run_panel()
        proc = job.proc
        pid = proc.processId()
        try:
            os.kill(pid, signal.SIGINT)  # npu-transcribe stops ffmpeg and exits with 130
        except OSError:
            proc.terminate()
        # SIGINT waits until the Python code runs again (not during an NPU compile).
        QTimer.singleShot(4000, lambda: job.proc is proc and proc.terminate())
        QTimer.singleShot(8000, lambda: job.proc is proc and proc.kill())

    def stop_all(self, wait_ms: int = 3000) -> None:
        """On quit: cancel the queue and stop the running process."""
        for j in self.jobs:
            if j.state == "queued":
                j.state = "cancelled"
        job = self.running()
        if job and job.proc:
            job.cancel_requested = True
            try:
                os.kill(job.proc.processId(), signal.SIGINT)
            except OSError:
                pass
            if not job.proc.waitForFinished(wait_ms):
                job.proc.kill()
                job.proc.waitForFinished(1000)

    def selected_jobs(self) -> list[Job]:
        items = self.queue.selectedItems()
        return [j for j in self.jobs if j.item in items]

    def remove_selected(self) -> None:
        for job in self.selected_jobs():
            if job.state != "running":
                self.queue.takeTopLevelItem(self.queue.indexOfTopLevelItem(job.item))
                self.jobs.remove(job)
                if self._log_job is job:
                    self._log_job = None
                    self.log_view.clear()
        self._update_buttons()
        self.main.update_counts()

    def clear_finished(self) -> None:
        for job in [j for j in self.jobs if j.state in ("done", "failed", "cancelled")]:
            self.queue.takeTopLevelItem(self.queue.indexOfTopLevelItem(job.item))
            self.jobs.remove(job)
            if self._log_job is job:
                self._log_job = None
                self.log_view.clear()
        self._update_buttons()

    def show_result(self) -> None:
        job = next((j for j in self.selected_jobs() if j.state == "done"), None)
        if job is not None:
            self.main.show_job_result(job)

    # -- display
    def _update_item(self, job: Job) -> None:
        if job.item is None:
            return
        job.item.setText(1, job.options_text())
        job.item.setText(2, job.status_text())
        job.item.setToolTip(2, job.error or job.phase)
        name = {"running": "media-playback-start", "done": "dialog-ok-apply", "failed": "dialog-error",
                "cancelled": "dialog-cancel", "queued": "chronometer"}.get(job.state)
        job.item.setIcon(2, icon(name) if name else QIcon())

    def _update_run_panel(self) -> None:
        job = self.running()
        self.run_frame.setVisible(job is not None)
        if job is None:
            return
        waiting = sum(j.state == "queued" for j in self.jobs)
        self.run_title.setText(f"Transcribing {job.name}" + (f"  (+{waiting} waiting)" if waiting else ""))
        if job.fraction is None:
            self.progress.setRange(0, 0)  # busy indicator while the model loads
        else:
            self.progress.setRange(0, 1000)
            self.progress.setValue(int(job.fraction * 1000))
        self._tick()

    def _tick(self) -> None:
        job = self.running()
        if job is None:
            return
        parts = [job.phase or "Starting…", f"{fmt_duration(time.monotonic() - job.started)} elapsed"]
        if job.remaining and job.fraction is not None and job.fraction < 1:
            parts.append(f"about {fmt_duration(job.remaining)} left")
        if job.language_found:
            parts.append(f"language {job.language_found}")
        self.run_phase.setText(" · ".join(parts))

    def _update_buttons(self) -> None:
        ready = sum(j.state == "ready" for j in self.jobs)
        self.start_btn.setText(f"Transcribe {ready} file{'s' if ready != 1 else ''}" if ready else "Transcribe…")
        self.start_btn.setToolTip("Start with the options above" if ready else "Choose files to transcribe")
        sel = self.selected_jobs()
        self.remove_btn.setEnabled(any(j.state != "running" for j in sel))
        self.clear_btn.setEnabled(any(j.state in ("done", "failed", "cancelled") for j in self.jobs))
        self.result_btn.setEnabled(any(j.state == "done" for j in sel))
        self.start_btn.setEnabled(os.access(TRANSCRIBE, os.X_OK))

    def _selection_changed(self) -> None:
        sel = self.selected_jobs()
        job = sel[0] if sel else self.running()
        if job is not self._log_job:
            self._log_job = job
            self.log_view.setPlainText("\n".join(job.log) if job else "")
            self.log_view.moveCursor(QTextCursor.MoveOperation.End)
        self._update_buttons()

    def _log_toggled(self, on: bool) -> None:
        self.log_toggle.setArrowType(Qt.ArrowType.DownArrow if on else Qt.ArrowType.RightArrow)
        self.log_view.setVisible(on)


def is_video(path: str) -> bool:
    global _MIME_DB
    if _MIME_DB is None:
        _MIME_DB = QMimeDatabase()
    return _MIME_DB.mimeTypeForFile(path).name().startswith("video/")


