#!/usr/bin/python3 -I
"""bmeet-ctl - one JSON interface to voxtype + npu-transcribe for the BMeet
panel widget and app. Stdlib only, runs on the system python3.

  bmeet-ctl status                     JSON: dictation/meeting state, language, ...
  bmeet-ctl recent [--limit N]         JSON list: meetings + transcribed files, newest first
  bmeet-ctl dictate [--clipboard]      toggle dictation (paste at cursor, or clipboard only); with
                                       ~/.config/bmeet/live-dictation "on" or "panel": BMeet's own,
                                       the text while you speak (bmeet-dictate), else voxtype's
  bmeet-ctl cancel                     cancel the current dictation
  bmeet-ctl lang [toggle|en|de|...]    switch dictation language (restarts the daemon)
  bmeet-ctl meeting start|stop|toggle|pause|resume [--in-person]
                                       (--in-person: microphone only, split by voice)
  bmeet-ctl open [meetings|files|transcribe] [--id ID] [--file PATH]   open the app
  bmeet-ctl version

Data sources (read-only): $XDG_RUNTIME_DIR/voxtype/{state,meeting_state,pid,meeting-toggle.started},
$XDG_RUNTIME_DIR/bmeet/meeting-audio/*/{speaker-pass,live.md},
~/.config/voxtype/config.toml, ~/.config/bmeet/languages (the languages
`lang toggle` cycles through, e.g. "en de"), ~/.local/share/voxtype/meetings/index.db,
~/Documents/Meetings/*.md, ~/.local/share/npu-transcribe/history.jsonl.
Actions that can take long (meeting stop waits for the last chunk) run detached.

Path overrides for testing (env): BMEET_RUN_DIR, BMEET_AUDIO_DIR, BMEET_MEETING_DB,
VOXTYPE_MEETING_DIR, NPU_TRANSCRIBE_HISTORY, BMEET_APP, BMEET_RUNTIME_DIR (bmeet-dictate's),
BMEET_DICTATE_START (how to start bmeet-dictate when it is not running).

On macOS there is no voxtype: BMeet.app (macos/BMeetApp) dictates, and macos/bmeet-meeting
records meetings. bmeet-ctl reads their state from the same file names in
$XDG_RUNTIME_DIR/bmeet (your temp folder; see macos/bmeetmac.py), the meetings from
~/.local/share/bmeet/meetings/index.db (voxtype's columns; Markdown copies that could not go to
~/Documents/Meetings are in that folder too), the dictation language from
~/.config/bmeet/language, and sends its actions to BMeet.app. It runs on BMeet's venv Python there.
"""
import json
import os
import re
import sqlite3
import subprocess
import sys
import tomllib
from pathlib import Path

__version__ = "0.8.1"

MAC = sys.platform == "darwin" and os.environ.get("BMEET_PLATFORM") != "linux"   # (tests: Linux on a Mac)
if MAC:
    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "macos"))
    import bmeetmac  # noqa: E402
    bmeetmac.setup()   # $XDG_RUNTIME_DIR: your user's temp folder
    __version__ = bmeetmac.VERSION   # BMeet for macOS has its own release line (macos/VERSION)

HOME = Path.home()
RUN = Path(os.environ.get("BMEET_RUN_DIR")
           or Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / ("bmeet" if MAC else "voxtype"))
# Meeting audio waiting for (or in) the speaker pass; see voxtype-meeting-toggle.
AUDIO_DIR = Path(os.environ.get("BMEET_AUDIO_DIR")
                 or Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "bmeet/meeting-audio")
XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
CONFIG = XDG_CONFIG / "voxtype/config.toml"
LANGUAGES_FILE = XDG_CONFIG / "bmeet/languages"
LANG_CODE = re.compile(r"^[a-z]{2,3}$")  # Whisper language codes ("en", "haw", ...)
MEETING_DB = Path(os.environ.get("BMEET_MEETING_DB")
                  or HOME / (".local/share/bmeet/meetings/index.db" if MAC else ".local/share/voxtype/meetings/index.db"))
MAC_LANGUAGE = XDG_CONFIG / "bmeet/language"   # macOS: the dictation language (voxtype's config on Linux)
MEETING = Path(__file__).resolve().parents[1] / "macos/bmeet-meeting"   # macOS: the meeting runner
MEETING_MD_DIR = Path(os.environ.get("VOXTYPE_MEETING_DIR", HOME / "Documents/Meetings"))
FILE_HISTORY = Path(os.environ.get("NPU_TRANSCRIBE_HISTORY")
                    or HOME / ".local/share/npu-transcribe/history.jsonl")
BIN = HOME / ".local/bin"
APP = Path(os.environ.get("BMEET_APP")
           or Path(__file__).resolve().parent / "app" / "bmeet")
# BMeet's own dictation (docs/live-dictation.md): "on" (into the text field), "panel", or off.
LIVE_DICTATION = XDG_CONFIG / "bmeet/live-dictation"
DICTATE = Path(__file__).resolve().parent / "dictate" / "bmeet-dictate"
DICTATE_SOCKET = Path(os.environ.get("BMEET_RUNTIME_DIR")
                      or Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "bmeet") / "dictate.sock"


def read_first_line(path: Path, default: str = "") -> str:
    try:
        return path.read_text().splitlines()[0].strip() or default
    except (OSError, IndexError):
        return default


def live_dictation() -> str:
    word = read_first_line(LIVE_DICTATION, "off").lower()
    return word if word in ("on", "panel") else "off"


def to_dictate(command: str, start: bool = True) -> dict | None:
    """One command to bmeet-dictate (its JSON answer; None if it is not running). start: run it
    first if it is not (the user unit bmeet-dictate; it keeps the speech model loaded)."""
    import socket
    import time

    def send() -> dict:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(5)
            s.connect(str(DICTATE_SOCKET))
            s.sendall(command.encode() + b"\n")
            return json.loads(s.makefile().readline() or "{}")
    try:
        return send()
    except OSError:
        if not start:
            return None
    cmd = os.environ.get("BMEET_DICTATE_START")
    subprocess.run(cmd if cmd else
                   ["systemd-run", "--user", "--quiet", "--collect", "--unit=bmeet-dictate",
                    "-p", "Wants=ydotool.service", "-p", "After=ydotool.service",
                    "/usr/bin/python3", "-I", str(DICTATE), "serve"], shell=bool(cmd), check=False)
    for _ in range(100):
        time.sleep(0.05)
        try:
            return send()
        except OSError:
            continue
    print("bmeet-ctl: bmeet-dictate did not start (journalctl --user -u bmeet-dictate)", file=sys.stderr)
    return None


def dictation_state() -> str:
    """idle / recording / transcribing: voxtype's, or bmeet-dictate's when BMeet dictates."""
    if MAC:   # BMeet.app's (it writes RUN/state as voxtype does)
        return read_first_line(RUN / "state", "idle") if daemon_running() else "off"
    if live_dictation() != "off":
        state = read_first_line(DICTATE_SOCKET.parent / "dictation", "idle")
        return "transcribing" if state == "committing" else state
    return read_first_line(RUN / "state", "idle") if daemon_running() else "off"


def daemon_running() -> bool:
    if MAC and not pid_running():
        # (macOS deletes the files in your temp folder that were not opened for 3 days, and
        # BMeet.app writes its pid file once, at launch: then ask BMeet.app itself)
        return bmeetmac.agent_running()
    return pid_running()


def pid_running() -> bool:
    try:
        pid = int(read_first_line(RUN / "pid", "0"))
    except ValueError:
        return False
    if pid <= 0:  # no pid file (os.kill(0, 0) would signal our own process group)
        return False
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False


def config() -> dict:
    if MAC:   # (voxtype's [openvino] section, for status())
        return {"openvino": {"language": read_first_line(MAC_LANGUAGE, "en"), "model": "whisper-large-v3-turbo",
                             "device": "ANE"}}
    try:
        with CONFIG.open("rb") as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def languages() -> list[str]:
    """Languages to cycle through with `lang toggle` (same file voxtype-lang reads)."""
    try:
        words = LANGUAGES_FILE.read_text().replace(",", " ").split()
    except (OSError, ValueError):  # missing, unreadable, not UTF-8
        words = ["en"]
    codes = [w.lower() for w in words if LANG_CODE.match(w.lower())]
    return list(dict.fromkeys(codes)) or ["en"]  # unique, order kept


def next_language(current: str) -> str | None:
    """The language `lang toggle` switches to, or None with only one configured."""
    langs = languages()
    if current not in langs:
        return langs[0] if langs[0] != current else None
    nxt = langs[(langs.index(current) + 1) % len(langs)]
    return nxt if nxt != current else None


def db() -> sqlite3.Connection | None:
    if not MEETING_DB.exists():
        return None
    con = sqlite3.connect(f"file:{MEETING_DB}?mode=ro", uri=True, timeout=2)
    con.row_factory = sqlite3.Row
    return con


def meeting_md(started_at: int, title: str = "") -> str | None:
    """The Markdown copy of one meeting (pair_mds)."""
    return pair_mds([(None, started_at, title)]).get(None)


def md_dirs() -> list[Path]:
    """Where the Markdown copies are: MEETING_MD_DIR, and on a Mac also the index's folder, where
    macos/bmeet-meeting saves a copy it cannot write in MEETING_MD_DIR (no access to Documents)."""
    spare = MEETING_DB.parent
    return [MEETING_MD_DIR, spare] if MAC and spare != MEETING_MD_DIR else [MEETING_MD_DIR]


def pair_mds(meetings: list[tuple]) -> dict:
    """{key: Markdown copy} for (key, started_at, title[, ended_at]) meetings. voxtype-meeting-toggle
    names the copy after the start minute, YYYY-MM-DD_HHMM-meeting.md (-EPOCH added for a
    later meeting of the same minute). voxtype's own start time can be a few seconds off
    that, so a minute either side counts too when the file's "# Title" is the meeting's. Of
    a minute's files: the one with the meeting's title, if no other file of that minute and no
    other meeting has it; else the first written that no other meeting claims by its title alone (the same
    rule as the app's pick_md: on 2026-10-15 two meetings shared a recording, and both copies
    got the second one's title), and a -meeting-EPOCH.md copy only for a meeting that ended
    then (the toggle names it when the meeting stops)."""
    import time
    titles = [m[2] for m in meetings]
    found: dict = {}
    taken: set[str] = set()
    for offset, by_title in ((0, False), (10, False), (-60, True), (60, True)):
        for key, started_at, title, *more in sorted(meetings, key=lambda m: m[1]):
            ended = more[0] if more else None
            if key in found:
                continue
            stamp = time.strftime("%Y-%m-%d_%H%M", time.localtime(started_at + offset))
            files = [p for d in md_dirs() for p in without_twins(d.glob(f"{stamp}-meeting*.md"))]
            group = [str(p) for p in sorted(files, key=written_order)]
            named = [p for p in group if md_title(p) == title]
            if len(named) == 1 and named[0] not in taken and titles.count(title) == 1:
                pick = named[0]
            elif by_title:
                pick = next((p for p in named if p not in taken), None)
            else:
                pick = next((p for p in group if p not in taken and not (
                    md_title(p) != title and titles.count(md_title(p)) == 1
                    and sum(md_title(q) == md_title(p) for q in group) == 1)
                    and not (ended and written_order(p)[0] and abs(written_order(p)[0] - ended) > 600)), None)
            if pick:
                found[key] = pick
                taken.add(pick)
    return found


def without_twins(paths) -> list:
    """Leave out X-speakers.md next to X.md: the speaker pass's version of a transcript you
    edited while it ran, which stays the meeting's copy. (Alone, it is the copy.)"""
    paths = list(paths)
    names = {Path(p).name for p in paths}
    return [p for p in paths if not (Path(p).name.endswith("-speakers.md")
                                     and Path(p).name[:-len("-speakers.md")] + ".md" in names)]


def written_order(path) -> tuple[int, int, str]:
    """YYYY-MM-DD_HHMM-meeting.md before -meeting-EPOCH.md (the toggle never overwrites: a
    later meeting of the same minute gets the time it stopped), not by modification time,
    which the speaker pass changes. Anything else after its own (-meeting-speakers.md: the
    speaker pass's version of a transcript you were editing, which stays the copy)."""
    name = Path(path).name
    m = re.search(r"-meeting(?:-(\d+))?(\.md|-.*\.md)$", name)
    return (int(m[1] or 0), m[2] != ".md", name) if m else (0, 1, name)


def md_title(path) -> str:
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            first = f.readline().strip()
    except OSError:
        return ""
    return first[2:].strip() if first.startswith("# ") else ""


def speakers_pending() -> list[str]:
    """The meetings whose speaker pass is running: the Markdown copy each one will replace
    (voxtype-meeting-toggle marks the recording with a "speaker-pass" file that names it; the
    pass deletes the folder when it ends), or, for a marker that names none (before 0.8.1),
    the start stamp YYYY-MM-DD_HHMM, as in the Markdown file names: the first 15 characters of
    the recording's name (a second recording of a minute is named ..._HHMM-2)."""
    pending = set()
    try:
        for d in AUDIO_DIR.iterdir():
            if (d / "speaker-pass").exists():
                pending.add(read_first_line(d / "speaker-pass") or d.name[:15])
    except OSError:
        return []
    return sorted(pending)


def live_transcript() -> str | None:
    """The running meeting's live transcript (npu-transcribe --live; see voxtype-meeting-toggle):
    live.md in its recording, whose name the toggle keeps in meeting-toggle.started."""
    stamp = read_first_line(RUN / "meeting-toggle.started")
    path = AUDIO_DIR / stamp / "live.md" if re.fullmatch(r"[\w-]+", stamp) else None
    return str(path) if path and path.is_file() else None


def status() -> dict:
    ov = config().get("openvino", {})
    language = str(ov.get("language", "en")).lower()
    meeting = read_first_line(RUN / "meeting_state", "idle")
    active = None
    if meeting in ("recording", "paused") and (con := db()):  # open the DB only when needed
        try:
            active = con.execute("SELECT id, title, started_at FROM meetings WHERE ended_at IS NULL "
                                 "ORDER BY started_at DESC LIMIT 1").fetchone()
        finally:
            con.close()
    return {
        "daemon": "active" if daemon_running() else "inactive",
        "dictation": dictation_state(),
        "live_dictation": live_dictation(),
        "meeting": meeting,
        "meeting_id": active["id"] if active else None,
        "meeting_title": active["title"] if active else None,
        "meeting_started": active["started_at"] if active else None,
        "meeting_live": live_transcript() if meeting in ("recording", "paused") else None,
        "speakers_pending": speakers_pending(),
        "language": language,
        "next_language": next_language(language),
        "languages": languages(),
        "model": Path(ov.get("model", "")).name or None,
        "device": ov.get("device"),
    }


def recent(limit: int) -> list[dict]:
    items: list[dict] = []
    con = db()
    if con:
        rows = con.execute("SELECT id, title, started_at, ended_at, duration_secs, status FROM meetings "
                           "ORDER BY started_at DESC LIMIT ?", (limit,)).fetchall()
        # (the meetings just before the oldest listed can share its minute: they claim copies too)
        before = con.execute("SELECT id, title, started_at, ended_at FROM meetings WHERE started_at >= ? "
                             f"AND id NOT IN ({','.join('?' * len(rows))})",
                             [rows[-1]["started_at"] - 120] + [r["id"] for r in rows]).fetchall() if rows else []
        con.close()
        paths = pair_mds([(r["id"], r["started_at"], r["title"] or "", r["ended_at"]) for r in rows + before])
        for r in rows:
            items.append({"kind": "meeting", "id": r["id"], "title": r["title"] or "Meeting",
                          "time": r["started_at"], "duration": r["duration_secs"],
                          "status": r["status"], "path": paths.get(r["id"])})
    try:
        lines = FILE_HISTORY.read_text().splitlines()[-limit * 2:]
    except OSError:
        lines = []
    for line in lines:
        try:
            h = json.loads(line)
        except json.JSONDecodeError:
            continue
        outputs = h.get("outputs") or []
        md = next((o for o in outputs if o.endswith(".md")), outputs[0] if outputs else None)
        items.append({"kind": "file", "id": None, "title": Path(h.get("input", "?")).name,
                      "time": h.get("time"), "duration": h.get("duration"),
                      "status": h.get("status", "done"), "path": md})
    items.sort(key=lambda i: i.get("time") or 0, reverse=True)
    return items[:limit]


def detached(*cmd: str) -> None:
    """Start and forget (meeting stop can take minutes; the caller must not block)."""
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def to_app(command: dict, start: bool = True) -> dict | None:
    """macOS: one command to BMeet.app (its answer). start: open BMeet.app first if it is not
    running (it records, dictates and pastes, so macOS asks for its permissions only)."""
    answer = bmeetmac.agent(command)
    if answer is not None or not start:
        return answer
    subprocess.run(["open", "-g", "-b", "io.github.baakhoff.bmeet"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    import time
    for _ in range(100):
        time.sleep(0.1)
        if (answer := bmeetmac.agent(command)) is not None:
            return answer
    print("bmeet-ctl: BMeet.app is not running (open it from ~/Applications)", file=sys.stderr)
    return None


def set_mac_language(target: str) -> int:
    """macOS `lang`: the dictation language BMeet.app uses from the next dictation on."""
    current = read_first_line(MAC_LANGUAGE, "en")
    language = next_language(current) if target == "toggle" else target
    if not language:
        return 0
    MAC_LANGUAGE.parent.mkdir(parents=True, exist_ok=True)
    MAC_LANGUAGE.write_text(language + "\n")
    to_app({"op": "language", "language": language}, start=False)
    return 0


WINDOW_PAGES = ("meetings", "files", "transcribe")   # the window's pages (PAGES in bmeet/app/bmeet)


def window_args(args: list[str]) -> list[str] | None:
    """macOS `open`: the window's arguments with its files made absolute here, read the way the
    window reads them (parse_cli() in bmeet/app/bmeet). BMeet.app starts the window in /, not in
    the folder you ran `bmeet` in. None (and why, on stderr) when the window would not take them."""
    out, rest, page, files, only_files = [], list(args), False, False, False

    def here(f: str) -> str:   # (file: URLs are absolute; the window turns them into paths)
        return f if not f or f.startswith("file:") else os.path.abspath(os.path.expanduser(f))
    while rest:
        a = rest.pop(0)
        if only_files:
            out.append(here(a))
        elif a == "--":
            out.append(a)
            only_files = True
        elif a == "--id" and rest:
            out += [a, rest.pop(0)]
        elif a.startswith("--id="):
            out.append(a)
        elif a == "--file" and rest:
            out += [a, here(rest.pop(0))]
            files = True
        elif a.startswith("--file="):
            out.append("--file=" + here(a[7:]))
            files = True
        elif a in WINDOW_PAGES and not page and not files:
            out.append(a)
            page = True
        elif a.startswith("-") and a != "-":
            print(f"bmeet: unknown option or missing value: {a}\n\n{window_usage()}", file=sys.stderr)
            return None
        else:
            out.append(here(a))
            files = True
    return out


def window_usage() -> str:
    """The window's --help (its docstring), for macOS, where the window has no terminal."""
    import ast
    try:
        return (ast.get_docstring(ast.parse(APP.read_text(encoding="utf-8"))) or "").strip()
    except (OSError, SyntaxError, ValueError):
        return "usage: bmeet [meetings|files|transcribe] [--id MEETING_ID] [--file PATH]... [FILE...]"


def mac_main(cmd: str, args: list[str]) -> int | None:
    """The actions on macOS (None: not one of them; status, recent, version are shared)."""
    if cmd == "dictate":
        return 0 if to_app({"op": "dictate", "clipboard": "--clipboard" in args}) else 1
    if cmd == "cancel":
        to_app({"op": "cancel"}, start=False)
        return 0
    if cmd == "lang":
        target = (args[:1] or ["toggle"])[0].lower()
        if target != "toggle" and not LANG_CODE.match(target):
            print(f"bmeet-ctl: not a language code: {target!r}", file=sys.stderr)
            return 2
        return set_mac_language(target)
    if cmd == "meeting":
        action = args[0] if args else "toggle"
        extra = [a for a in args[1:] if a == "--in-person"]
        if action not in ("start", "stop", "toggle", "pause", "resume") or len(extra) != len(args[1:]) \
                or (extra and action in ("pause", "resume")):
            print("usage: bmeet-ctl meeting start|stop|toggle|pause|resume [--in-person]", file=sys.stderr)
            return 2
        return 0 if to_app({"op": "meeting", "action": action, "in_person": bool(extra)}) else 1
    if cmd == "open":   # (`bmeet`: what the window would print, and its files, are done here)
        if any(a in ("-h", "--help") for a in args):
            print(window_usage())
            return 0
        if "--version" in args:
            print(f"bmeet {__version__}")
            return 0
        if (window := window_args(args)) is None:
            return 2
        return 0 if to_app({"op": "open", "args": window}) else 1
    return None


def main(argv: list[str]) -> int:
    cmd, args = (argv[0], argv[1:]) if argv else ("status", [])
    if MAC and (code := mac_main(cmd, args)) is not None:
        return code
    if cmd == "status":
        print(json.dumps(status()))
    elif cmd == "recent":
        limit = int(args[args.index("--limit") + 1]) if "--limit" in args else 10
        print(json.dumps(recent(limit)))
    elif cmd == "dictate":
        if live_dictation() != "off":
            return 0 if to_dictate("toggle" + (" --clipboard" if "--clipboard" in args else "")) else 1
        return subprocess.call(["voxtype", "record", "toggle"]
                               + (["--clipboard"] if "--clipboard" in args else []))
    elif cmd == "cancel":
        if live_dictation() != "off":
            to_dictate("cancel", start=False)
            return 0
        return subprocess.call(["voxtype", "record", "cancel"])
    elif cmd == "lang":
        target = (args[:1] or ["toggle"])[0].lower()
        if target != "toggle" and not LANG_CODE.match(target):
            print(f"bmeet-ctl: not a language code: {target!r}", file=sys.stderr)
            return 2
        detached(str(BIN / "voxtype-lang"), target)
    elif cmd == "meeting":
        action = args[0] if args else "toggle"
        extra = [a for a in args[1:] if a == "--in-person"]
        if action in ("start", "stop", "toggle") and len(extra) == len(args[1:]):
            detached(str(BIN / "voxtype-meeting-toggle"), action, *extra)
        elif action in ("pause", "resume") and not args[1:]:
            return subprocess.call(["voxtype", "meeting", action])
        else:
            print("usage: bmeet-ctl meeting start|stop|toggle|pause|resume [--in-person]", file=sys.stderr)
            return 2
    elif cmd == "open":
        detached(str(APP), *args)
    elif cmd in ("version", "--version"):
        print(f"bmeet-ctl {__version__}")
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
