{
  "manifest_version": 3,
  "name": "BMeet: is the call hearing you?",
  "version": "0.8.1",
  "description": "Tells BMeet when your Google Meet or Slack call cannot hear your microphone (muted), so the meeting transcript leaves out what you said meanwhile.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://app.slack.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["https://meet.google.com/*", "https://app.slack.com/*"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
