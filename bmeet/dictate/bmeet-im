#!/usr/bin/python3 -I
"""bmeet-im - BMeet's input method: the text of a dictation inside the text field you are in.

KWin runs one input method at a time (System Settings > Keyboard > Virtual Keyboard). For the
length of a dictation bmeet-dictate makes this it (and gives the slot back afterwards), and KWin
starts it with a Wayland connection of its own (WAYLAND_SOCKET, zwp_input_method_v1). When a text
field has the focus, the words still being redone are shown in it as underlined preedit text
and the final words are committed into it as they become final: no clipboard, no key presses.

It gets the text from bmeet-dictate's socket ($XDG_RUNTIME_DIR/bmeet/dictate.sock; it says "im"
and then gets JSON lines {"final", "draft", "done"}), and tells it whether a text field is there
({"field": true|false}), so that bmeet-dictate pastes the text instead in windows without one
(X11 programs). Stdlib only, and quick to start: KWin starts it when a dictation begins.

  bmeet-im                  (started by KWin)
  bmeet-im --script FILE    tests: play the text events in FILE (JSON lines with "at" seconds)
                            into the next text field that gets the focus
Env: BMEET_IM_LOG=FILE (tests: what was sent and received, with time.time()), BMEET_RUNTIME_DIR.
"""
from __future__ import annotations

import array
import json
import os
import select
import socket
import struct
import sys
import time
from pathlib import Path

PROG = "bmeet-im"
RUNTIME = Path(os.environ.get("BMEET_RUNTIME_DIR")
               or Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "bmeet")
LOG = open(os.environ["BMEET_IM_LOG"], "a", buffering=1) if os.environ.get("BMEET_IM_LOG") else None


def note(**kw) -> None:
    if LOG:
        kw["t"] = time.time()
        LOG.write(json.dumps(kw, ensure_ascii=False) + "\n")


# --------------------------------------------------------------------------- Wayland wire protocol

def u32(v: int) -> bytes:
    return struct.pack("<I", v & 0xFFFFFFFF)


def i32(v: int) -> bytes:
    return struct.pack("<i", v)


def string(text: str) -> bytes:
    raw = text.encode() + b"\0"
    return u32(len(raw)) + raw + b"\0" * (-len(raw) % 4)


class Args:
    def __init__(self, body: bytes) -> None:
        self.body, self.pos = body, 0

    def u32(self) -> int:
        v = struct.unpack_from("<I", self.body, self.pos)[0]
        self.pos += 4
        return v

    def string(self) -> str:
        n = self.u32()
        text = self.body[self.pos:self.pos + max(0, n - 1)].decode(errors="replace")
        self.pos += (n + 3) & ~3
        return text


class Wayland:
    """A Wayland client connection, just enough for an input method: the registry, binding,
    sync, and requests and events as raw messages."""

    def __init__(self) -> None:
        fd = os.environ.pop("WAYLAND_SOCKET", None)    # (KWin hands its input method a socket)
        if fd is not None:
            self.sock = socket.socket(fileno=int(fd))
        else:
            self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            self.sock.connect(os.path.join(os.environ["XDG_RUNTIME_DIR"], os.environ.get("WAYLAND_DISPLAY", "wayland-0")))
        self.next_id, self.handlers, self.globals, self.buf = 2, {1: self.display_event}, {}, b""
        self.registry = self.new(self.registry_event)
        self.send(1, 1, u32(self.registry))            # wl_display.get_registry
        self.roundtrip()

    def new(self, handler) -> int:
        oid, self.next_id = self.next_id, self.next_id + 1
        self.handlers[oid] = handler
        return oid

    def send(self, oid: int, opcode: int, payload: bytes = b"") -> None:
        self.sock.sendall(struct.pack("<II", oid, ((8 + len(payload)) << 16) | opcode) + payload)

    def bind(self, interface: str, version: int, handler) -> int:
        name = next((n for n, i in self.globals.items() if i == interface), None)
        if name is None:
            raise RuntimeError(f"the compositor offers no {interface}")
        oid = self.new(handler)
        self.send(self.registry, 0, u32(name) + string(interface) + u32(version) + u32(oid))
        return oid

    def roundtrip(self) -> None:
        done: list[int] = []
        self.send(1, 0, u32(self.new(lambda op, a: done.append(1))))   # wl_display.sync
        while not done:
            self.dispatch()

    def dispatch(self) -> None:
        fds = array.array("i")
        data, anc, _, _ = self.sock.recvmsg(1 << 16, socket.CMSG_LEN(16 * fds.itemsize))
        if not data:
            raise ConnectionError("the compositor closed the connection")
        for level, kind, cdata in anc:   # (no event we use carries a file descriptor: close them)
            if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
                fds.frombytes(cdata[:len(cdata) - len(cdata) % fds.itemsize])
        for fd in fds:
            os.close(fd)
        self.buf += data
        while len(self.buf) >= 8:
            oid, word = struct.unpack_from("<II", self.buf)
            size, opcode = word >> 16, word & 0xFFFF
            if len(self.buf) < size:
                break
            body, self.buf = self.buf[8:size], self.buf[size:]
            if (handler := self.handlers.get(oid)) is not None:
                handler(opcode, Args(body))

    def display_event(self, op: int, a: Args) -> None:
        if op == 0:
            obj, code, msg = a.u32(), a.u32(), a.string()
            raise RuntimeError(f"Wayland error on object {obj}: {code} {msg}")
        if op == 1:
            self.handlers.pop(a.u32(), None)

    def registry_event(self, op: int, a: Args) -> None:
        if op == 0:
            name, interface = a.u32(), a.string()
            self.globals[name] = interface
        elif op == 1:
            self.globals.pop(a.u32(), None)


# --------------------------------------------------------------------------- the input method

class InputMethod:
    """zwp_input_method_v1: KWin activates a context while a text field has the focus."""

    def __init__(self, wl: Wayland) -> None:
        self.wl, self.context, self.serial = wl, None, 0
        self.committed = ""        # the dictation's final text that went into a field
        self.on_field = lambda active: None
        wl.bind("zwp_input_method_v1", 1, self.event)
        wl.roundtrip()

    def event(self, op: int, a: Args) -> None:
        if op == 0:                                  # activate(new_id context)
            self.context = a.u32()
            self.wl.handlers[self.context] = self.context_event
            note(ev="activate")
            self.on_field(True)
        elif op == 1:                                # deactivate(context)
            ctx = a.u32()
            if ctx == self.context:
                self.wl.send(ctx, 0)                 # context.destroy
                self.context = None
                note(ev="deactivate")
                self.on_field(False)

    def context_event(self, op: int, a: Args) -> None:
        if op == 4:                                  # commit_state(serial)
            self.serial = a.u32()

    def show(self, final: str, draft: str) -> str:
        """Commit the final words not yet in the field, show the draft as preedit text. Returns
        what was committed now."""
        if self.context is None:
            return ""
        new = ""
        if final.startswith(self.committed) and len(final) > len(self.committed):
            new = final[len(self.committed):]
            new = (" " if self.committed else "") + new.lstrip()
            self.wl.send(self.context, 1, u32(self.serial) + string(new))            # commit_string
            self.committed = final
        if draft and (self.committed or new):
            draft = " " + draft
        self.wl.send(self.context, 4, i32(len(draft.encode())))                      # preedit_cursor (bytes)
        self.wl.send(self.context, 2, u32(self.serial) + string(draft) + string(""))  # preedit_string
        note(ev="show", commit=new, preedit=draft)
        return new


def play_script(im: InputMethod, wl: Wayland, path: Path) -> int:
    """--script: the events of FILE into the next field that gets the focus, at their times."""
    events = [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]
    start: list[float] = []
    im.on_field = lambda active: start.append(time.monotonic() + 0.5) if active and not start else None
    i = 0
    while True:
        wait = None
        if start and i < len(events):
            wait = max(0.0, start[0] + events[i]["at"] - time.monotonic())
        if select.select([wl.sock], [], [], wait)[0]:
            wl.dispatch()
            continue
        ev = events[i]
        done = bool(ev.get("done"))
        im.show(ev.get("text", "") if done else ev.get("final", ""), "" if done else ev.get("draft", ""))
        i += 1


def follow_service(im: InputMethod, wl: Wayland) -> int:
    """The dictation's text from bmeet-dictate, into the field."""
    svc = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    svc.connect(str(RUNTIME / "dictate.sock"))
    svc.sendall(b"im\n")

    def tell(active: bool) -> None:
        svc.sendall(json.dumps({"field": active}).encode() + b"\n")
    im.on_field = tell
    tell(im.context is not None)
    pending = b""
    while True:
        ready = select.select([wl.sock, svc], [], [])[0]
        if wl.sock in ready:
            wl.dispatch()
        if svc in ready:
            data = svc.recv(1 << 16)
            if not data:
                return 0
            pending += data
            while b"\n" in pending:
                line, pending = pending.split(b"\n", 1)
                ev = json.loads(line)
                if ev.get("cancel"):                 # (what was committed stays; the draft goes)
                    im.show(im.committed, "")
                elif ev.get("done"):
                    committed = im.show(ev.get("text", ""), "")
                    svc.sendall(json.dumps({"committed": committed, "all": im.committed,
                                            "field": im.context is not None}).encode() + b"\n")
                else:
                    im.show(ev.get("final", ""), ev.get("draft", ""))


def main(argv: list[str]) -> int:
    wl = Wayland()
    im = InputMethod(wl)
    note(ev="started")
    try:
        if argv[:1] == ["--script"]:
            return play_script(im, wl, Path(argv[1]))
        return follow_service(im, wl)
    except (ConnectionError, OSError) as exc:
        note(ev="ended", why=str(exc))
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
