<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- BMeet.app: the menu bar app (macos/Sources/BMeet). macos/install.sh fills in @VERSION@. -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key><string>io.github.baakhoff.bmeet</string>
	<key>CFBundleName</key><string>BMeet</string>
	<key>CFBundleDisplayName</key><string>BMeet</string>
	<key>CFBundleExecutable</key><string>BMeet</string>
	<key>CFBundleIconFile</key><string>BMeet</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>@VERSION@</string>
	<key>CFBundleVersion</key><string>@VERSION@</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>LSMinimumSystemVersion</key><string>14.2</string>
	<key>LSUIElement</key><true/>
	<key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
	<key>NSHighResolutionCapable</key><true/>
	<key>NSHumanReadableCopyright</key><string>MIT License</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>BMeet records your microphone for dictation and meeting transcripts. The speech is transcribed on this Mac, on its Neural Engine, and never uploaded.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>BMeet records what your Mac plays - the other side of a call - for meeting transcripts. It stays on this Mac, in memory only, until the transcript is done.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>BMeet saves the meeting transcripts in your Documents folder, in Documents/Meetings.</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key><string>Audio or video to transcribe</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array><string>public.audio</string><string>public.movie</string></array>
		</dict>
	</array>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key><dict><key>default</key><string>Transcribe with BMeet</string></dict>
			<key>NSMessage</key><string>transcribeFiles</string>
			<key>NSPortName</key><string>BMeet</string>
			<key>NSRequiredContext</key><dict/>
			<key>NSSendFileTypes</key><array><string>public.audio</string><string>public.movie</string></array>
		</dict>
		<dict>
			<key>NSMenuItem</key><dict><key>default</key><string>Transcribe with Speakers (BMeet)</string></dict>
			<key>NSMessage</key><string>transcribeWithSpeakers</string>
			<key>NSPortName</key><string>BMeet</string>
			<key>NSRequiredContext</key><dict/>
			<key>NSSendFileTypes</key><array><string>public.audio</string><string>public.movie</string></array>
		</dict>
		<dict>
			<key>NSMenuItem</key><dict><key>default</key><string>Translate Speech to English (BMeet)</string></dict>
			<key>NSMessage</key><string>translateFiles</string>
			<key>NSPortName</key><string>BMeet</string>
			<key>NSRequiredContext</key><dict/>
			<key>NSSendFileTypes</key><array><string>public.audio</string><string>public.movie</string></array>
		</dict>
		<dict>
			<key>NSMenuItem</key><dict><key>default</key><string>Open in BMeet</string></dict>
			<key>NSMessage</key><string>openInBMeet</string>
			<key>NSPortName</key><string>BMeet</string>
			<key>NSRequiredContext</key><dict/>
			<key>NSSendFileTypes</key><array><string>public.audio</string><string>public.movie</string></array>
		</dict>
	</array>
</dict>
</plist>
