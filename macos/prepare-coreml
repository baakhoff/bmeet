def prepare_gigaam(src: Path, out: Path) -> None:
    import onnxruntime as ort
    prep = load_script("prepare-models")
    out.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=out) as tmp:
        work = Path(tmp)
        n = prep.dequantize(src / "model.int8.onnx", work / "float.onnx")
        print(f"  {n} quantised layers back to float")
        model = static_and_folded(work / "float.onnx", {"features": [1, 64, GIGAAM_FRAMES], "feature_lengths": [1]},
                                  work)
        prog = OnnxToMil(model, {"features": ((1, 64, GIGAAM_FRAMES), "fp32"),
                                 "feature_lengths": ((1,), "int32")}).build()
        to_mlpackage(prog, work / "model.mlpackage")
        compiled = compile_mlpackage(work / "model.mlpackage", out / "model.mlmodelc")
        shutil.copyfile(src / "tokens.txt", out / "tokens.txt")
        # check: the test recording through Core ML vs. the float ONNX model on the CPU
        wav = next((src / "test_wavs").glob("*.wav"), None)
        feats = np.zeros((1, 64, GIGAAM_FRAMES), np.float32)
        n_frames = GIGAAM_FRAMES
        if wav is not None:
            nt = load_npu_transcribe()
            audio = nt.decode_all(wav)[:30 * nt.SAMPLE_RATE]
            g = nt.GigaAM.__new__(nt.GigaAM)
            g.window = 0.5 - 0.5 * np.cos(2 * np.pi * np.arange(g.N_FFT) / g.N_FFT)
            g.mel = g.mel_filters()
            f = g.features(np.pad(audio, (0, max(0, g.N_FFT - audio.size))))
            n_frames = min(f.shape[1], GIGAAM_FRAMES)
            feats[0, :, :n_frames] = f[:, :n_frames]
        lengths = np.array([n_frames], np.int64)
        ref = ort.InferenceSession(str(work / "static.onnx"), providers=["CPUExecutionProvider"]) \
            .run(None, {"features": feats, "feature_lengths": lengths})[0]
        got, secs = timed(load(compiled), {"features": feats, "feature_lengths": lengths.astype(np.int32)})
        got = next(iter(got.values()))
        valid = (n_frames + 3) // 4
        same = float((got[0, :valid].argmax(-1) == ref[0, :valid].argmax(-1)).mean())
        print(f"  {out}/model.mlmodelc ready: {secs * 1000:.0f} ms per 30 s, "
              f"{same * 100:.2f} % of the output frames agree with the CPU")
        report_plan(compiled)


def titanet_fp16_safe(model, scale: float = TITANET_SCALE) -> None:
    """npu-transcribe's titanet_npu_safe, on the ONNX graph: TitaNet's attentive statistics
    pooling underflows in float16 (attention weights ~1/T times squared deviations ~1e-3),
    on the Neural Engine as on the Intel NPU. Feed the statistics scale*x and scale the means
    and standard deviations back down where they leave."""
    from onnx import helper, numpy_helper
    g = model.graph
    by = {n.name.rsplit("/", 1)[-1]: n for n in g.node if "/decoder/_pooling/" in n.name}
    x = by["Sub"].input[0]
    g.initializer.extend([numpy_helper.from_array(np.array(scale, np.float32), "bmeet_scale"),
                          numpy_helper.from_array(np.array(1.0 / scale, np.float32), "bmeet_inv_scale")])
    nodes = [helper.make_node("Mul", [x, "bmeet_scale"], ["bmeet_xs"], name="bmeet/scale_x")]
    for name in ("Mul", "Mul_2"):
        node = by[name]
        node.input[:] = ["bmeet_xs" if i == x else i for i in node.input]
    for name in ("Sub", "Sub_1"):
        by[name].input[0] = "bmeet_xs"

    def scale_down(src_name: str, consumer, tag: str) -> None:
        out = src_name + "_bmeet_down"
        nodes.append(helper.make_node("Mul", [src_name, "bmeet_inv_scale"], [out], name="bmeet/" + tag))
        consumer.input[:] = [out if i == src_name else i for i in consumer.input]

    scale_down(by["Unsqueeze_4"].output[0], by["Expand"], "mean")
    scale_down(by["Sqrt"].output[0], by["Unsqueeze_9"], "std")
    concat_out = by["Concat_5"].output[0]
    down = concat_out + "_bmeet_down"
    for n in g.node:
        n.input[:] = [down if i == concat_out else i for i in n.input]
    nodes.append(helper.make_node("Mul", [concat_out, "bmeet_inv_scale"], [down], name="bmeet/stats"))
    # (insert each new node right after the node that makes its input: topological order)
    order = list(g.node)
    for new in nodes:
        src = new.input[0]
        at = next((i for i, n in enumerate(order) if src in n.output), -1)
        order.insert(at + 1, new)
    del g.node[:]
    g.node.extend(order)


def prepare_titanet(src: Path, out: Path) -> None:
    import onnx
    import onnxruntime as ort
    out.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=out) as tmp:
        work = Path(tmp)
        m = onnx.load(str(src))
        titanet_fp16_safe(m)
        onnx.save(m, str(work / "safe.onnx"))
        model = static_and_folded(work / "safe.onnx", {"audio_signal": [TITANET_BATCH, 80, TITANET_FRAMES],
                                                       "length": [TITANET_BATCH]}, work)
        prog = OnnxToMil(model, {"audio_signal": ((TITANET_BATCH, 80, TITANET_FRAMES), "fp32"),
                                 "length": ((TITANET_BATCH,), "int32")}).build()
        to_mlpackage(prog, work / "titanet.mlpackage")
        compiled = compile_mlpackage(work / "titanet.mlpackage", out / "titanet.mlmodelc")
        rng = np.random.default_rng(1)
        feats = rng.standard_normal((TITANET_BATCH, 80, TITANET_FRAMES)).astype(np.float32)
        lengths = np.array([TITANET_FRAMES - 20 * i for i in range(TITANET_BATCH)], np.int64)
        sess = ort.InferenceSession(str(src), providers=["CPUExecutionProvider"])
        ref = sess.run(["embs"], {"audio_signal": feats, "length": lengths})[0]
        got, secs = timed(load(compiled), {"audio_signal": feats, "length": lengths.astype(np.int32)})
        got = got["embs"]
        sims = [cosine(got[i], ref[i]) for i in range(TITANET_BATCH)]
        print(f"  {out}/titanet.mlmodelc ready: {secs * 1000:.0f} ms per {TITANET_BATCH} fingerprints, "
              f"{min(sims):.4f} alike to the CPU's at worst")
        report_plan(compiled)


# --------------------------------------------------------------------------- Nemotron

class MilOps:
    """The few openvino.opset13 functions prepare-diarization builds Nemotron with, as Core ML
    (MIL) ops, so that its graph code builds the same model for the Neural Engine."""

    def __init__(self) -> None:
        from coremltools.converters.mil import Builder as mb
        self.mb = mb
        self.params: dict[str, tuple] = {}

    def constant(self, a):
        return np.asarray(a)

    def _v(self, x):
        if isinstance(x, np.ndarray):
            return x.astype(np.int32) if x.dtype == np.int64 else (
                x.astype(np.float32) if x.dtype == np.float64 else x)
        return x

    def parameter(self, shape, dtype, name):
        self.params[name] = (tuple(shape), name)
        return ("param", name)          # replaced by the Function's input (build_mil)

    def reshape(self, x, shape, special_zero):
        return self.mb.reshape(x=self._v(x), shape=self._v(np.asarray(shape)).astype(np.int32))

    def matmul(self, a, b, ta, tb):
        if isinstance(b, np.ndarray) and b.ndim == 2:
            w = b if tb else b.T            # linear wants (out, in)
            if ta:
                a = self.mb.transpose(x=a, perm=[0, 2, 1])
            return self.mb.linear(x=self._v(a), weight=np.ascontiguousarray(w.astype(np.float32)))
        return self.mb.matmul(x=self._v(a), y=self._v(b), transpose_x=ta, transpose_y=tb)

    def add(self, a, b):
        return self._fold(np.add, a, b) or self.mb.add(x=self._v(a), y=self._v(b))

    def subtract(self, a, b):
        return self._fold(np.subtract, a, b) or self.mb.sub(x=self._v(a), y=self._v(b))

    def multiply(self, a, b):
        return self._fold(np.multiply, a, b) or self.mb.mul(x=self._v(a), y=self._v(b))

    @staticmethod
    def _fold(f, a, b):
        if isinstance(a, np.ndarray) and isinstance(b, np.ndarray):
            return np.asarray(f(a, b))
        return None

    def transpose(self, x, perm):
        return self.mb.transpose(x=self._v(x), perm=[int(v) for v in np.asarray(perm)])

    def mvn(self, x, axes, normalize_variance, eps, mode):
        return self.mb.layer_norm(x=self._v(x), axes=[int(v) for v in np.asarray(axes).ravel()],
                                  epsilon=np.float32(eps))

    def softmax(self, x, axis):
        return self.mb.softmax(x=self._v(x), axis=int(axis))

    def gelu(self, x, mode):
        return self.mb.gelu(x=self._v(x), mode="EXACT")

    def relu(self, x):
        return self.mb.relu(x=self._v(x))

    def sigmoid(self, x):
        return self.mb.sigmoid(x=self._v(x))

    def convolution(self, x, w, strides, pads_begin, pads_end, dilations):
        pad = [p for b, e in zip(pads_begin, pads_end) for p in (b, e)]
        return self.mb.conv(x=self._v(x), weight=self._v(np.asarray(w, np.float32)), strides=list(strides),
                            dilations=list(dilations), pad_type="custom", pad=pad)


def load_npu_transcribe():
    path = TRANSCRIBE / "npu-transcribe"
    loader = importlib.machinery.SourceFileLoader("npu_transcribe", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = mod
    loader.exec_module(mod)
    return mod


def prepare_nemotron(weights: Path, out: Path) -> None:
    """Nemotron's two parts as Core ML programs, built by prepare-diarization's graph code."""
    import coremltools as ct
    from coremltools.converters.mil.mil import Function, Program, types
    diar = load_script("prepare-diarization")
    w = diar.read_safetensors(weights)
    out.mkdir(parents=True, exist_ok=True)
    builder = diar.build_graph   # (the graph code, shared with the OpenVINO build)

    with tempfile.TemporaryDirectory(dir=out) as tmp:
        work = Path(tmp)
        for part in ("embedder", "encoder"):
            ops = MilOps()
            shapes = diar.graph_inputs(part)
            specs = {name: ops.mb.placeholder(shape=shape, dtype=types.fp32) for name, shape in shapes.items()}
            prog = Program()
            with Function(specs, opset_version=ct.target.macOS14) as fn:
                outputs = builder(ops, w, part, {name: fn.inputs[name] for name in shapes})
                fn.set_outputs([ops.mb.identity(x=v, name=name) for name, v in outputs.items()])
            prog.add_function("main", fn)
            to_mlpackage(prog, work / f"{part}.mlpackage")
            compile_mlpackage(work / f"{part}.mlpackage", out / f"{part}.mlmodelc")
            print(f"  {out}/{part}.mlmodelc ready")
            report_plan(out / f"{part}.mlmodelc")
        np.save(out / "silence.npy", w["silence_embeds"].astype(np.float32))
    check_nemotron(w, out)


def check_nemotron(w: dict, out: Path) -> None:
    """The encoder on random embeddings (a full step, half of it masked) vs. numpy in float32."""
    diar = load_script("prepare-diarization")
    shapes = diar.graph_inputs("encoder")
    rng = np.random.default_rng(2)
    x = (rng.standard_normal(shapes["embeds"]) * 0.5).astype(np.float32)
    mask = np.ones(shapes["mask"], np.float32)
    mask[0, shapes["mask"][1] // 2:] = 0.0
    ref = diar.build_graph(NumpyOps(), w, "encoder", {"embeds": x, "mask": mask})["probs"]
    got, secs = timed(load(out / "encoder.mlmodelc"), {"embeds": x, "mask": mask})
    got = got["probs"]
    valid = int(mask.sum()) * 8
    agree = float(((got[0, :valid] > 0.5) == (ref[0, :valid] > 0.5)).mean())
    print(f"  encoder: {secs * 1000:.0f} ms per step, {agree * 100:.2f} % of the 10 ms voice decisions "
          f"agree with float32 numpy, largest difference {np.abs(got[0, :valid] - ref[0, :valid]).max():.3f}")


class NumpyOps:
    """prepare-diarization's ops in float32 numpy: the reference the Core ML build is checked against."""

    def constant(self, a):
        return np.asarray(a)

    def parameter(self, shape, dtype, name):
        raise AssertionError("inputs are given")

    def reshape(self, x, shape, special_zero):
        return np.reshape(x, [int(v) for v in np.asarray(shape)])

    def matmul(self, a, b, ta, tb):
        a = np.swapaxes(a, -1, -2) if ta else a
        b = np.swapaxes(b, -1, -2) if tb else b
        return (a.astype(np.float32) @ b.astype(np.float32)).astype(np.float32)

    def add(self, a, b): return np.add(a, b, dtype=np.float32)
    def subtract(self, a, b): return np.subtract(a, b, dtype=np.float32)
    def multiply(self, a, b): return np.multiply(a, b, dtype=np.float32)
    def transpose(self, x, perm): return np.transpose(x, [int(v) for v in np.asarray(perm)])

    def mvn(self, x, axes, normalize_variance, eps, mode):
        ax = tuple(int(v) for v in np.asarray(axes).ravel())
        mean = x.mean(axis=ax, keepdims=True)
        var = ((x - mean) ** 2).mean(axis=ax, keepdims=True)
        return ((x - mean) / np.sqrt(var + eps)).astype(np.float32)

    def softmax(self, x, axis):
        e = np.exp(x - x.max(axis=axis, keepdims=True))
        return (e / e.sum(axis=axis, keepdims=True)).astype(np.float32)

    def gelu(self, x, mode):
        from math import erf, sqrt
        return (0.5 * x * (1.0 + np.vectorize(erf)(x / sqrt(2.0)))).astype(np.float32)

    def relu(self, x): return np.maximum(x, 0).astype(np.float32)
    def sigmoid(self, x): return (1.0 / (1.0 + np.exp(-x))).astype(np.float32)

    def convolution(self, x, w, strides, pads_begin, pads_end, dilations):
        # 1-D, stride 1, dilation 1 (the upsampler): out[o, t] = sum_i,k w[o, i, k] x[i, t + k - pad]
        x = np.pad(x, ((0, 0), (0, 0), (pads_begin[0], pads_end[0])))
        k = w.shape[-1]
        t = x.shape[-1] - k + 1
        cols = np.stack([x[0, :, j:j + t] for j in range(k)], -1)        # (in, t, k)
        return np.einsum("oik,itk->ot", w, cols)[None].astype(np.float32)


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print(__doc__.split("Usage:")[1].split("Run with")[0].rstrip(), file=sys.stderr)
        return 2
    sys.modules["openvino_telemetry"] = None
    what, args = argv[0], [Path(a) for a in argv[1:]]
    if what == "gigaam" and len(args) == 2:
        prepare_gigaam(*args)
    elif what == "titanet" and len(args) == 2:
        prepare_titanet(*args)
    elif what == "nemotron" and len(args) == 2:
        prepare_nemotron(*args)
    elif what == "plan" and len(args) == 1:
        report_plan(args[0])
    else:
        print(__doc__.split("Usage:")[1].split("Run with")[0].rstrip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
