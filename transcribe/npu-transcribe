# Tidying (not with --verbatim): what the speech models write for hesitations and slips,
# removed by rules that cannot change what was said. A language model on the NPU was tried
# for more (misheard words) and made things worse: Qwen3 8B and 4B, int4 as the NPU needs
# them, inserted Chinese characters, cut and translated words and invented terms on a real
# Russian meeting (docs/npu-transcribe.md).
FILLER = (r"(?:э+(?:[-.]+э+)*|а(?:[-.]+а+)+|а{3,}|м(?:-м+)+|м{3,}|эм+|э-м+|хм+|"
          r"uh+|um+|uhm|hmm+|erm)")
FILLER_BETWEEN_COMMAS = rf"(?:{FILLER}|м|а)"   # a lone "м" or "а" between commas is a hesitation too
WORD_EDGE = (r"(?<![\w-])", r"(?![\w-])")
KEEP_DOUBLED = {"да", "нет", "так", "ну", "вот", "очень", "давай", "давайте", "ага", "угу",
                "ок", "окей", "ой", "yes", "no", "very", "so", "bye"}
CYR_TO_LAT = dict(zip("абвгдеёжзийклмнопрстуфхцчшщъыьэюя",
                      ["a", "b", "v", "g", "d", "e", "e", "zh", "z", "i", "y", "k", "l", "m", "n",
                       "o", "p", "r", "s", "t", "u", "f", "h", "ts", "ch", "sh", "sch", "", "y", "",
                       "e", "yu", "ya"]))
LAT_TO_CYR = dict(zip("abcdefghijklmnopqrstuvwxyz",  # letters that look alike first, then sound
                      ["а", "б", "с", "д", "е", "ф", "г", "х", "и", "дж", "к", "л", "м", "н", "о",
                       "р", "к", "р", "с", "т", "у", "в", "в", "х", "у", "з"]))
VERBATIM = False   # --verbatim


def _case(src: str, dst: str) -> str:
    return dst.capitalize() if src.isupper() and dst else dst


def one_script(word: str) -> str:
    """A word that mixes Cyrillic and Latin letters ("oкей", "Viкl", "реetention": the speech
    model switching mid-word) in the script most of it is in (ties: its first letter's)."""
    cyr = sum(1 for c in word if "а" <= c.lower() <= "я" or c.lower() == "ё")
    lat = sum(1 for c in word if "a" <= c.lower() <= "z")
    if not cyr or not lat:
        return word
    to_latin = lat > cyr or (lat == cyr and "a" <= word[0].lower() <= "z")
    table = CYR_TO_LAT if to_latin else LAT_TO_CYR
    return "".join(_case(c, table[c.lower()]) if c.lower() in table else c for c in word)


def tidy(text: str) -> str:
    """Fillers (э-э, а-а, хмм, um), stutters ("функцио функционал", "мы мы"), stretched
    sounds ("и-и-и"), mixed-script words, and spacing around punctuation."""
    if VERBATIM:
        return text
    a, b = WORD_EDGE
    f = rf"{a}{FILLER}{b}"
    t = " ".join(text.split())
    t = re.sub(r"—{2,}", "—", t)
    t = re.sub(rf"\s*,\s*{a}{FILLER_BETWEEN_COMMAS}{b}\s*,\s*", " ", t, flags=re.I)  # "что, хмм, показал"
    t = re.sub(rf"(^|[.!?…]\s+){f}\s*[,.!?…]*\s*(\w?)", lambda m: m[1] + m[2].upper(), t,
               flags=re.I)                                                            # at a sentence start
    t = re.sub(rf"\s*,?\s*{f}\s*(?=[.!?…])", "", t, flags=re.I)                       # at a sentence end
    t = re.sub(rf"\s*,?\s*{f},?", "", t, flags=re.I)                                 # anywhere else
    t = re.sub(r"(?<![\w-])(\w)(?:-\1)+(?![\w-])", r"\1", t, flags=re.I)              # "и-и-и" -> "и"
    t = re.sub(r"\b(\w{4,})\s+(\1\w{2,})\b", r"\2", t, flags=re.I)                     # "функцио функционал"

    def doubled(m: re.Match) -> str:
        return m[0] if m[1].lower() in KEEP_DOUBLED or m[1].isdigit() else m[1]
    for _ in range(3):  # (three in a row)
        t = re.sub(r"\b(\w+)\s+\1\b", doubled, t, flags=re.I)
    t = re.sub(r"\w+", lambda m: one_script(m[0]), t)
    t = re.sub(r"\s+([,.!?…:;])", r"\1", t)
    t = re.sub(r"([,;:])(?=[^\W\d_])", r"\1 ", t)                                     # "Подожди,подожди"
    t = re.sub(r"(?<![.])\.\.(?![.])", ".", t)                                         # "пожалуйста.."
    t = re.sub(r"\.{4,}", "...", t)
    t = re.sub(r",\s*([.!?…])", r"\1", t)
    t = re.sub(r"(^|[.!?…]\s)[,;:]\s*", r"\1", t)
    t = re.sub(r"\s{2,}", " ", t).strip(" ,;")
    if t and text.lstrip()[:1].isupper():
        t = t[0].upper() + t[1:]
    return t if re.search(r"\w", t) else ""


def tidy_segments(segments: list[Segment]) -> list[Segment]:
    """Segments with tidy() text; those left without words are dropped."""
    out = []
    for seg in segments:
        if text := tidy(seg.text):
            out.append(seg if text == seg.text else Segment(seg.start, seg.end, text, seg.words, seg.speaker))
    return out


def paragraphs(segments: list[Segment]) -> list[tuple[float, str]]:
    """Join segments into ~PARAGRAPH_SECONDS paragraphs, preferably at sentence ends."""
    out: list[tuple[float, str]] = []
    parts: list[str] = []
    para_start = 0.0
    for seg in segments:
        age = seg.start - para_start
        if parts and age >= PARAGRAPH_SECONDS and (
                parts[-1].endswith((".", "!", "?", "…", "。", "？", "！")) or age >= 1.5 * PARAGRAPH_SECONDS):
            out.append((para_start, " ".join(parts)))
            parts = []
        if not parts:
            para_start = seg.start
        parts.append(seg.text)
    if parts:
        out.append((para_start, " ".join(parts)))
    return out


def turns(segments: list[Segment]) -> list[tuple[str, list[Segment]]]:
    """Consecutive segments of the same speaker ("" without --speakers)."""
    return [(spk, list(group)) for spk, group in itertools.groupby(segments, key=lambda s: s.speaker)]


def speaker_paragraphs(segments: list[Segment]) -> list[tuple[float, str, str]]:
    """(start, speaker, text): paragraphs that never mix two speakers."""
    return [(start, spk, text) for spk, group in turns(segments) for start, text in paragraphs(group)]


def to_srt(t: Transcript) -> str:
    cues = [f"{i}\n{srt_time(s.start)} --> {srt_time(s.end)}\n"
            f"{f'{s.speaker}: ' if s.speaker else ''}{s.text}\n"
            for i, s in enumerate(tidy_segments(t.segments), 1)]
    return "\n".join(cues)


def to_md(t: Transcript, src: Path, meta: dict[str, str]) -> str:
    head = [f"# {src.stem}", ""] + [f"- **{k}:** {v}" for k, v in meta.items()]
    body = [f"[{hms(start)}] " + (f"**{spk}:** " if spk else "") + text
            for start, spk, text in speaker_paragraphs(tidy_segments(t.segments))]
    return "\n".join(head) + "\n\n" + "\n\n".join(body or ["*(no speech detected)*"]) + "\n"


def to_txt(t: Transcript) -> str:
    return "\n\n".join((f"{spk}: " if spk else "") + text
                       for _, spk, text in speaker_paragraphs(tidy_segments(t.segments))) + "\n"


def meeting_time(seconds: float) -> str:
    """[mm:ss] like voxtype's meeting export; [h:mm:ss] from the first hour on."""
    s = int(seconds)
    return f"{s // 3600}:{s % 3600 // 60:02d}:{s % 60:02d}" if s >= 3600 else f"{s // 60:02d}:{s % 60:02d}"


def meeting_md(title: str, started: float | None, duration: float, segments: list[Segment],
               meta: dict[str, str], tidied: bool = False, empty: str = "*(no speech detected)*") -> str:
    """The meeting transcript, laid out like `voxtype meeting export --format markdown`
    (which it replaces): a heading per change of speaker, a [mm:ss] mark per paragraph.
    tidied: the segments went through tidy_segments() already. empty: the text without any."""
    segments = segments if tidied else tidy_segments(segments)
    speakers = sorted({s.speaker for s in segments},
                      key=lambda n: (n != "You", int(n.split()[-1]) if n[-1:].isdigit() else 0, n))
    info = ([f"- **Date:** {datetime.fromtimestamp(started):%Y-%m-%d %H:%M}"] if started else []) + [
        f"- **Duration:** {int(duration) // 60}m {int(duration) % 60}s",
        f"- **Word Count:** {sum(len(s.text.split()) for s in segments)}",
        f"- **Speakers:** {', '.join(speakers) or '-'}",
    ] + [f"- **{k}:** {v}" for k, v in meta.items()]
    body = []
    for spk, group in turns(segments):
        body += [f"### {spk}", ""]
        body += [f"*[{meeting_time(start)}]* {text}\n" for start, text in paragraphs(group)]
    return "\n".join([f"# {title}", "", "## Meeting Info", "", *info, "", "## Transcript", "",
                      *(body or [empty, ""])])


def write_atomic(path: Path, text: str, private: bool = False) -> None:
    """Write via a temp file + rename so a crash never leaves half a transcript.
    private: keep mkstemp's 0600 (voice fingerprints)."""
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        if not private:
            os.chmod(tmp, 0o666 & ~UMASK)  # mkstemp creates 0600; use normal file modes
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def notify(ok: bool, body: list[str], summary: str = "") -> None:
    """Desktop notification (used by the Dolphin service menu and meetings)."""
    if not shutil.which("notify-send"):
        return
    summary = summary or ("Transcription finished" if ok else "Transcription failed")
    cmd = ["notify-send", f"--app-name={PROG}", "--icon=view-media-lyrics",
           f"--urgency={'normal' if ok else 'critical'}", summary,
           html.escape("\n".join(body[:10]), quote=False)]  # body allows simple markup
    subprocess.run(cmd, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def record_history(src: Path, outputs: list[Path], model: str, language: str,
                   device: str, duration: float | None, ok: bool, speakers: int | None = None) -> None:
    """Append one JSON line per finished file to HISTORY (read by the BMeet
    app and bmeet-ctl). Best effort: a failure here only logs a warning."""
    try:
        if duration is None:  # failed before/while decoding: ask ffprobe
            duration = probe_duration(src) if src.is_file() else None
        entry = {
            "time": int(time.time()),
            "input": os.path.abspath(src),
            "outputs": [os.path.abspath(p) for p in outputs],
            "model": model,
            "language": language,
            "device": device,
            "duration": round(float(duration or 0.0), 3),
            "status": "done" if ok else "failed",
        }
        if speakers is not None:
            entry["speakers"] = speakers
        HISTORY.parent.mkdir(parents=True, exist_ok=True)
        with open(HISTORY, "a", encoding="utf-8") as f:
            fcntl.flock(f, fcntl.LOCK_EX)  # the app rewrites the file under the same lock
            f.write(json.dumps(entry) + "\n")
    except Exception as exc:  # never let the history break a transcription
        log(f"WARNING: could not update {HISTORY}: {exc}")


