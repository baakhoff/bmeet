def output_dir(src: Path, out: Path | None) -> Path:
    """--out, else the input's directory, else ~/Transcripts (read-only media, shares)."""
    if out:
        return out.expanduser()
    if os.access(src.parent, os.W_OK):
        return src.parent
    fallback = Path.home() / "Transcripts"
    fallback.mkdir(exist_ok=True)
    log(f"WARNING: {src.parent} is not writable; writing to {fallback}")
    return fallback


def output_stem(out_dir: Path, src: Path, formats: list[str], overwrite: bool) -> str:
    """NAME, or the first free NAME.2, NAME.3, ... unless --overwrite.

    NAME.N.srt still sits next to NAME.mkv, so video players keep finding it.
    """
    if overwrite:
        return src.stem
    for n in itertools.count(1):
        stem = src.stem if n == 1 else f"{src.stem}.{n}"
        if not any((out_dir / f"{stem}.{fmt}").exists() for fmt in formats):
            if n > 1:
                log(f"{src.stem}.* already exists; writing {stem}.* (--overwrite to replace)")
            return stem
    raise AssertionError("unreachable")


def resolve_model(value: str) -> Path:
    path = MODELS.get(value) or Path(value).expanduser()
    if not (path / "openvino_encoder_model.xml").is_file():
        hint = " - install it with the BMeet installer (--with-turbo)" if value == "turbo" else ""
        raise SystemExit(f"{PROG}: model not found: {path} (expected an OpenVINO Whisper export){hint}")
    return path


def model_languages(model_dir: Path) -> set[str] | None:
    """Language codes the model knows, read from its generation_config.json so a
    typo is rejected before a (possibly minutes long) NPU compile."""
    try:
        config = json.loads((model_dir / "generation_config.json").read_text(encoding="utf-8"))
        return {k.strip("<|>") for k in config["lang_to_id"]}
    except (OSError, ValueError, KeyError):
        return None  # unusual export: let WhisperPipeline judge the language


def pick_devices(requested: str) -> list[str]:
    """Device order to try. Our own AUTO: NPU if present, else CPU.

    (OpenVINO's "AUTO" plugin runs Whisper on the CPU here, measured 2026-10-11,
    because the NPU needs the static Whisper pipeline that only "NPU" selects.)
    """
    if requested == "CPU":
        return ["CPU"]
    import openvino as ov
    available = ov.Core().available_devices
    if "NPU" in available:
        return ["NPU", "CPU"]
    if requested == "NPU":
        log(f"WARNING: NPU not available (devices: {', '.join(available)}; "
            "is the intel NPU driver installed?) - using CPU")
    return ["CPU"]


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(prog=PROG, description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("files", nargs="*", type=Path, metavar="FILE", help="audio or video file(s)")
    p.add_argument("--version", action="version", version=f"{PROG} {__version__}")
    p.add_argument("--model", default=None, metavar="turbo|small|DIR",
                   help="turbo (default if installed, else small), small, or a path to an "
                        "OpenVINO Whisper model dir")
    p.add_argument("--device", default="NPU", type=str.upper, choices=("NPU", "CPU", "AUTO"),
                   help="NPU (default, falls back to CPU), CPU, or AUTO (NPU if present)")
    p.add_argument("--language", default="auto", metavar="auto|en|ru|...",
                   help="spoken language (default: detected from the first 30 s with speech of each file)")
    p.add_argument("--translate", action="store_true", help="translate the speech to English")
    p.add_argument("--format", default="srt,md", metavar="srt,md,txt",
                   help="comma-separated output formats (default: srt,md)")
    p.add_argument("--out", type=Path, metavar="DIR", help="output directory (default: next to each input)")
    p.add_argument("--overwrite", action="store_true",
                   help="replace existing NAME.srt/.md/.txt instead of writing NAME.2.* etc.")
    p.add_argument("--notify", action="store_true", help="send a desktop notification when done")
    p.add_argument("--engine", default="auto", choices=("auto", "whisper", "gigaam"),
                   help="speech model: auto (default: GigaAM for Russian if installed, Whisper for "
                        "other languages and --translate), whisper, or gigaam (Russian only)")
    p.add_argument("--speakers", action="store_true",
                   help="tell the voices apart: Speaker 1, Speaker 2, ... (in the order they first speak)")
    p.add_argument("--num-speakers", type=int, default=0, metavar="N",
                   help="exactly N voices (implies --speakers; default: find out how many)")
    p.add_argument("--meeting", type=Path, metavar="DIR",
                   help="transcribe a BMeet meeting recording (see above) instead of files")
    p.add_argument("--output", type=Path, metavar="FILE.md", help="--meeting: the Markdown transcript")
    p.add_argument("--live", type=Path, metavar="DIR",
                   help="the transcript of a BMeet meeting while it is recorded into DIR, in DIR/live.md "
                        "(You / Remote; until the recording ends)")
    p.add_argument("--title", help="--meeting, --live: its title (default: from DIR/meeting.json)")
    p.add_argument("--no-english-terms", action="store_true",
                   help="Russian (GigaAM): do not let Whisper redo the English terms in sentences where "
                        "GigaAM heard some (by default it does, on the NPU, for those sentences only)")
    p.add_argument("--verbatim", action="store_true",
                   help="keep fillers (э-э, а-а, um), stutters and repeated words; by default they are "
                        "left out")
    p.add_argument("--voices", type=Path, metavar="DIR",
                   help="--meeting: give voices remembered in DIR/voices.json their names, keep "
                        "this meeting's voice fingerprints in DIR/meetings/, and learn your own voice "
                        "in DIR/you.json (BMeet's 'remember voices')")
    args = p.parse_args(argv)
    if args.num_speakers < 0:
        p.error("--num-speakers: expected a positive number")
    args.speakers = args.speakers or args.num_speakers > 0 or args.meeting is not None
    if args.meeting is not None:
        if args.files or not args.output or args.live is not None:
            p.error("--meeting DIR takes no FILE and needs --output FILE.md")
    elif args.live is not None:
        if args.files or args.voices is not None or args.speakers:
            p.error("--live DIR takes no FILE, --voices or --speakers")
    elif args.voices is not None:
        p.error("--voices only works with --meeting")
    elif not args.files:
        p.error("the following arguments are required: FILE")
    if args.speakers and (missing := speaker_models_missing()):
        p.error(f"speaker model missing: {missing[0]} (run the installer again)")
    args.formats = [f.strip().lower() for f in args.format.split(",") if f.strip()]
    if not args.formats or set(args.formats) - set(FORMATS):
        p.error(f"--format: choose from {', '.join(FORMATS)}")
    if args.model is None:
        turbo_installed = (MODELS["turbo"] / "openvino_encoder_model.xml").is_file()
        args.model = "small" if args.translate or not turbo_installed else "turbo"
        if args.translate and turbo_installed:
            log("--translate: using the small model (turbo was not trained to translate)")
    elif args.translate and args.model == "turbo":
        log("WARNING: whisper-large-v3-turbo was not trained to translate; output may stay untranslated")
    args.language = args.language.lower().strip("<|>")
    return args


class Engines:
    """The models, each loaded when first needed (on the NPU; the CPU only without one):
    Whisper (language detection, every language but Russian, translation), GigaAM
    (Russian) and the speaker models."""

    def __init__(self, args: argparse.Namespace, model_dir: Path, devices: list[str]) -> None:
        self.args, self.model_dir, self.devices = args, model_dir, devices
        self._whisper: Whisper | None = None
        self._gigaam: GigaAM | None = None
        self._speakers: SpeakerModels | None = None

    def whisper(self, words: bool = False) -> Whisper:
        """words: with word timestamps (a separately compiled pipeline; reloaded if needed).
        Always for --meeting and --live, which need them for the speakers and the echo."""
        words = words or self.args.speakers or self.args.live is not None
        if self._whisper is not None and words and not self._whisper.word_timestamps:
            self._whisper = None  # (frees the pipeline without them)
        if self._whisper is None:
            self._whisper = Whisper(self.model_dir, list(self.devices), word_timestamps=words)
        return self._whisper

    def english_terms(self, samples: np.ndarray, t: Transcript) -> int:
        """English terms from Whisper in a GigaAM transcript (english_terms()), in place.
        Returns the words swapped in."""
        if self.args.no_english_terms or not any(re.search(r"[A-Za-z]", s.text) for s in t.segments):
            return 0
        t0, c0 = time.monotonic(), cpu_seconds()
        t.segments, swapped, seconds = english_terms(self.whisper(words=True), samples, t.segments, "ru")
        log(f"English terms: Whisper on {seconds:.0f} s of {t.duration:.0f} s, {swapped} swapped in, "
            f"in {time.monotonic() - t0:.1f} s (CPU {cpu_seconds() - c0:.1f} s)")
        return swapped

    def gigaam(self) -> GigaAM:
        if self._gigaam is None:
            self._gigaam = GigaAM(list(self.devices))
        return self._gigaam

    def speakers(self) -> SpeakerModels:
        if self._speakers is None:
            self._speakers = SpeakerModels(list(self.devices))
        return self._speakers

    def detect(self, blocks: Generator[tuple[float, np.ndarray], None, None]) -> str:
        """Whisper's guess of the language of the first block with sound ("?" if none).
        A language that is not one of yours (~/.config/bmeet/languages) is checked on the
        next block with sound: one of yours there wins. (Whisper took synthetic Russian for
        Polish and Latin; GenAI gives no language probabilities to compare.)"""
        first = None
        try:
            for _, block in blocks:
                if peak_dbfs(block) < SILENCE_DBFS:
                    continue
                whisper = self.whisper()
                whisper.ready_for_detection()
                result = whisper.generate(block, return_timestamps=False, task="transcribe")
                if result is None:
                    continue
                language = (result.language or "?").strip("<|>")
                if first is None:
                    log(f"language: {language} (detected from the first 30 s with sound)")
                    yours = user_languages()
                    if not yours or language in yours:
                        return language
                    first = language
                    continue
                if language in user_languages():
                    log(f"language: {language} on the next 30 s with sound, one of yours: "
                        f"using it rather than {first}")
                    return language
                return first
        finally:
            blocks.close()
        return first or "?"

    def choose(self, language: str, blocks) -> tuple[Whisper | GigaAM, str]:
        """(the model for this recording, its language): GigaAM for Russian unless told
        otherwise (--engine) or translating. With --language auto the language is detected
        once here, on `blocks`, so that every track of a meeting gets the same one."""
        if self.args.engine == "gigaam":
            blocks.close()
            return self.gigaam(), "ru"
        if language == "auto":
            language = self.detect(blocks)
        else:
            blocks.close()
        return self.for_language(language)

    def for_language(self, language: str, words: bool = False) -> tuple[Whisper | GigaAM, str]:
        """choose() once the language is known. words: Whisper with word timestamps."""
        if self.args.engine == "gigaam" or (self.args.engine == "auto" and language == "ru"
                                            and not self.args.translate and gigaam_ready()):
            return self.gigaam(), "ru"
        return self.whisper(words), language


def user_languages() -> set[str]:
    """The languages you speak, from BMeet's dictation languages (~/.config/bmeet/languages,
    e.g. "en ru"); empty if unknown."""
    path = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "bmeet/languages"
    try:
        return {w.lower() for w in path.read_text(encoding="utf-8").split() if re.fullmatch(r"[a-z]{2,3}", w.lower())}
    except OSError:
        return set()


def engine_label(engine: Whisper | GigaAM) -> str:
    return "gigaam-v3-ctc" if isinstance(engine, GigaAM) else engine.model_dir.name


def save_meeting_voices(folder: Path, transcript: Path, people: dict[str, list[float]]) -> None:
    """FOLDER/meetings/<transcript name>.json: this meeting's voice fingerprints by label, so
    the BMeet app can remember the people you name. Private (0700 folders, 0600 file)."""
    meetings = folder / "meetings"
    for d in (folder, meetings):
        d.mkdir(mode=0o700, parents=True, exist_ok=True)
    data = {"version": 1, "model": EMBEDDING_MODEL.name, "transcript": transcript.name,
            "people": people}
    write_atomic(meetings / f"{transcript.stem}.json", json.dumps(data) + "\n", private=True)


def transcribe_meeting(args: argparse.Namespace, engines: Engines, gen_kwargs: dict) -> int:
    """--meeting DIR: both tracks transcribed, the system audio split by voice, your
    microphone as "You", interleaved by time into --output (Markdown). Where the browser call
    could not hear you (muted; read_call_log), your microphone is left out.

    In person (DIR/meeting.json says "in_person", or nobody spoke through the speakers): the
    microphone is split by voice instead. The voice that sounds like you (learned from your
    microphone in online meetings, with --voices) is You, a single voice is You too, the
    others are Person 1, Person 2, ..."""
    folder, out = args.meeting.expanduser(), args.output.expanduser()
    try:
        info = json.loads((folder / "meeting.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        info = {}
    title = args.title or info.get("title") or "Meeting"
    in_person = bool(info.get("in_person"))
    voices_dir = args.voices.expanduser() if args.voices else None
    # voxtype-meeting-toggle has already saved voxtype's own transcript there; it is replaced
    # unless it changed meanwhile (then the result goes next to it).
    before = out.stat().st_mtime_ns if out.exists() else None
    try:
        mic, remote, parts = read_meeting(folder)
        if in_person:  # (nothing is recorded; voxtype's live transcript still has it)
            remote = np.zeros(0, np.float32)
        duration = max(mic.size, remote.size) / SAMPLE_RATE
        log(f"meeting: {hms(duration)} of audio" + (", in person (microphone only)" if in_person else ""))
        t0, c0 = time.monotonic(), cpu_seconds()
        gain, muted = 0.0, []
        if not in_person:
            gain = echo_gain(mic, remote)  # before the silencing, which would make it look like headphones
            if muted := muted_spans(read_call_log(folder), parts):
                silence(mic, muted)
                log(f"microphone off in the call: {hms(sum(b - a for a, b in muted))} left out")
        audible = {name: samples.size > 0 and peak_dbfs(samples) >= SILENCE_DBFS
                   for name, samples in (("system audio", remote), ("microphone", mic))}
        remembered = load_voices(voices_dir) if voices_dir else {}
        # One language per meeting, detected on the other side (your track may hold little
        # speech of your own; detected there it went wrong, and Whisper then translated).
        engine, language = engines.choose(args.language, array_blocks(
            remote if audible["system audio"] else mic))
        if not isinstance(engine, GigaAM) and language not in ("auto", "?"):
            gen_kwargs = dict(gen_kwargs, language=f"<|{language}|>")
        heard = {}
        for name, samples in (("system audio", remote), ("microphone", mic)):
            t1, c1 = time.monotonic(), cpu_seconds()
            heard[name] = transcribe(engine, name, array_blocks(samples), samples.size / SAMPLE_RATE,
                                     gen_kwargs) if audible[name] else None
            if heard[name]:
                log(f"{name}: transcribed in {time.monotonic() - t1:.1f} s (CPU {cpu_seconds() - c1:.1f} s)")
        theirs, yours = heard["system audio"], heard["microphone"]
        terms = 0
        if isinstance(engine, GigaAM):
            for t, samples in ((theirs, remote), (yours, mic)):
                if t and t.segments:
                    terms += engines.english_terms(samples, t)
        room = in_person or not (theirs and theirs.segments)
        segments, labels, prints, names = [], {}, {}, {}
        speakers_on, echoes, me = "", 0, None
        if room and yours and yours.segments:  # everyone is on the microphone
            known = dict(remembered)
            if voices_dir and (mine := load_self(voices_dir)):
                known["You"] = mine
            found, prints, names = diarize(engines.speakers(), mic, args.num_speakers, known)
            speakers_on = engines.speakers().device
            if not names and len({t.speaker for t in found}) == 1:
                names = {found[0].speaker: "You"}  # one voice at your microphone: you
            # (no voice found at all, as in a few seconds of speech: that is you too)
            segments, labels = number_speakers(yours.segments, found, "Person",
                                               "Person ?" if found else "You", names)
        elif not room:
            found, prints, names = diarize(engines.speakers(), remote, args.num_speakers, remembered)
            speakers_on = engines.speakers().device
            remote_segments, labels = number_speakers(theirs.segments, found, "Person", "Remote", names)
            my_segments = [Segment(s.start, s.end, s.text, s.words, "You") for s in yours.segments] \
                if yours else []
            my_segments, echoes = drop_echo(my_segments, theirs.segments, mic, remote, gain)
            if voices_dir and my_segments:
                me = self_print(engines.speakers(), mic, my_segments)
            segments = sorted(my_segments + remote_segments, key=lambda s: s.start)
        del mic, remote
        people = len({label for label in labels.values() if label != "You"})
        wall = time.monotonic() - t0
        langs = {who: t.language for who, t in (("you", yours), ("others", theirs)) if t and t.language != "?"}
        meta = {
            "Language": (", ".join(sorted(set(langs.values()))) if len(set(langs.values())) < 2
                         else ", ".join(f"{who} {lang}" for who, lang in langs.items())) or "-",
            "Transcribed": f"{engine_label(engine)} on {engine.device} in {hms(wall)}"
                           + (f"; voices told apart on {speakers_on}" if speakers_on else ""),
        }
        if room:
            meta["Microphone"] = "split by voice (" + (
                "in-person meeting)" if in_person else "nobody spoke through the speakers)")
        if recognised := sorted({names[v] for v in labels if v in names and names[v] != "You"}):
            meta["Recognised by voice"] = ", ".join(recognised)
        if muted:
            meta["Microphone off"] = (f"{hms(sum(b - a for a, b in muted))} in which the call could "
                                      "not hear you (muted) were left out")
        if echoes:
            meta["Echo"] = (f"{echoes} word(s) your microphone picked up from the speakers "
                            "were left out")
        if terms:
            meta["English terms"] = f"{terms} written as Whisper heard them (GigaAM garbles English)"
        dest = out
        if out.exists() and out.stat().st_mtime_ns != before:
            dest = out.with_name(f"{out.stem}-speakers.md")
            log(f"{out.name} changed while this ran; writing {dest.name} instead")
        write_atomic(dest, meeting_md(title, info.get("started"), duration, segments, meta))
        if voices_dir and prints:  # so the people can be named and remembered later
            people_prints: dict[str, list[float]] = {}
            for v, label in labels.items():  # (a name can cover two voices: keep the longer)
                if v in prints and label not in people_prints:
                    people_prints[label] = prints[v]
            save_meeting_voices(voices_dir, dest, people_prints)
        if me and learn_self(voices_dir, me, dest.stem):
            log("your voice: learned from this meeting's microphone")
    except Exception as exc:
        log(f"ERROR: {exc}")
        if args.notify:
            notify(False, [str(exc), f"The transcript without speakers stays in {out}"],
                   "Meeting speakers failed")
        return 1
    print(dest, flush=True)
    log(f"done: {hms(duration)} in {hms(wall)} (CPU {cpu_seconds() - c0:.0f} s), {people} other voice(s)"
        + (f" ({', '.join(recognised)} recognised)" if recognised else "") + ", "
        f"{len(segments)} segment(s)" + (f", {echoes} echo word(s) left out" if echoes else ""))
    if args.notify:
        who = ", ".join(label for label in dict.fromkeys(labels.values()) if label != "You")
        notify(True, [f"{people} other voice(s): {who}" if people else "no other voices", str(dest)],
               "Meeting speakers identified")
    return 0


# --------------------------------------------------------------------------- live

# --live DIR: the transcript while the meeting is still on, for the BMeet window (DIR/live.md,
# rewritten whenever the text changes). It follows bmeet-meeting-audio's recording as the
# files grow, cuts each track into phrases where its sound stops, and transcribes a phrase
# once it has ended. With GigaAM (Russian) the phrase still being said is shown as well,
# redone after every LIVE_PARTIAL more seconds of it: ~85 ms on the NPU and ~5 ms of CPU
# each time. Other languages wait for the end of the phrase (Whisper). Your microphone is
# "You" (left out while the call cannot hear you, the other side's echo cut out as in the
# speaker pass), the system audio "Remote"; who is who among them is the speaker pass's job
# after the meeting. In person, the microphone is "Room".
LIVE_TICK = 0.5           # seconds between looks at the recording
LIVE_FRAME = SAMPLE_RATE // 10  # sound is measured per 100 ms (as in echo_gain)
LIVE_NOISE = 300          # a track's background noise: the quietest tenth of its last 300 frames
LIVE_SNR = 12.0           # sound: this many dB above that noise (and above SILENCE_DBFS)
LIVE_PAUSE = 0.8          # a phrase ends after this much quiet ...
LIVE_LONGEST = 20.0       # ... or is cut at its quietest moment when it gets this long
LIVE_PAD = 0.3            # audio kept on both sides of a phrase
LIVE_MIN_SOUND = 0.3      # a phrase with less sound than this is a click or a cough
LIVE_PARTIAL = 1.5        # GigaAM: the phrase being said is redone after this much more of it
LIVE_DETECT = 8.0         # the language is detected (by Whisper) once this much was said
LIVE_START = 30.0         # give up when no recording shows up in this long
LIVE_STILL = 3.0          # nothing recorded for this long (paused): the phrases being said end
LIVE_KEEP = 30.0          # audio no phrase needs any more is let go of in steps this long


def wav_data(path: Path) -> int | None:
    """Where the samples start in a WAV that pw-record may still be writing (its sizes are not
    final then); None while the header is not there yet. Only 16 kHz mono 16-bit, as
    bmeet-meeting-audio records it."""
    try:
        with open(path, "rb") as f:
            head = f.read(4096)
    except OSError:
        return None
    if len(head) < 12 or head[:4] != b"RIFF" or head[8:12] != b"WAVE":
        return None
    pos = 12
    while pos + 8 <= len(head):
        chunk, size = head[pos:pos + 4], int.from_bytes(head[pos + 4:pos + 8], "little")
        if chunk == b"fmt " and pos + 24 <= len(head):
            fmt, channels, rate = (int.from_bytes(head[pos + 8:pos + 10], "little"),
                                   int.from_bytes(head[pos + 10:pos + 12], "little"),
                                   int.from_bytes(head[pos + 12:pos + 16], "little"))
            bits = int.from_bytes(head[pos + 22:pos + 24], "little")
            if (fmt, channels, rate, bits) != (1, 1, SAMPLE_RATE, 16):
                raise RuntimeError(f"{path.name}: not 16 kHz mono 16-bit PCM")
        if chunk == b"data":
            return pos + 8
        pos += 8 + size + (size & 1)
    return None


def shifted(segments: list[Segment], seconds: float) -> list[Segment]:
    return [Segment(s.start + seconds, s.end + seconds, s.text,
                    [Word(w.start + seconds, w.end + seconds, w.text) for w in s.words], s.speaker)
            for s in segments]


class LiveTrack:
    """One track of a meeting while it is being recorded: its audio, phrases and text.
    Sample positions count from the start of the meeting (its parts joined, as in
    read_meeting()); the audio itself is kept from LiveMeeting.base on."""

    def __init__(self, kind: str, label: str) -> None:
        self.kind, self.label = kind, label            # "mic"/"remote", the speaker label
        self.buf = np.zeros(60 * SAMPLE_RATE, np.float32)
        self.length = 0                                # samples recorded
        self.rms = np.zeros(0)                         # loudness per LIVE_FRAME from the start
        self.file: Path | None = None                  # the part being read, ...
        self.data = 0                                  # ... where its samples start, ...
        self.read = 0                                  # ... and the bytes of them read
        self.start: int | None = None                  # the phrase being said: first sample,
        self.began = 0                                 # ... its first sound,
        self.last = 0                                  # ... end of its last sound,
        self.sound = 0                                 # ... its frames with sound,
        self.partial_at = 0                            # ... and how far its draft goes
        self.closed = 0                                # where the last phrase ended
        self.heard = 0                                 # samples with sound in ended phrases
        self.ended: list[tuple[int, int]] = []         # phrases said, not transcribed yet
        self.final: list[Segment] = []                 # transcribed (tidied)
        self.drafts: dict[int, list[Segment]] = {}     # phrase start -> its text so far

    def audio(self, base: int, a: int, b: int) -> np.ndarray:
        return self.buf[max(a, base) - base:max(min(b, self.length), base) - base]

    def append(self, x: np.ndarray, base: int) -> None:
        used = self.length - base
        if used + x.size > self.buf.size:
            grown = np.zeros(max(2 * self.buf.size, used + x.size), np.float32)
            grown[:used] = self.buf[:used]
            self.buf = grown
        self.buf[used:used + x.size] = x
        self.length += x.size

    def forget(self, base: int, new_base: int) -> None:
        """Let go of the audio before new_base."""
        used = self.length - base
        self.buf[:used - (new_base - base)] = self.buf[new_base - base:used]

    def take_in(self, base: int) -> bool:
        """Read what the recorder added to the current part's file; True if anything."""
        if self.file is None:
            return False
        if not self.data:
            self.data = wav_data(self.file) or 0
            if not self.data:
                return False
        try:
            with open(self.file, "rb") as f:
                f.seek(self.data + self.read)
                raw = f.read()
        except OSError:
            return False
        raw = raw[:len(raw) // 2 * 2]
        if not raw:
            return False
        self.read += len(raw)
        self.append(np.frombuffer(raw, "<i2").astype(np.float32) / 32768.0, base)
        return True

    def listen(self, base: int, upto: int | None = None, echo: np.ndarray | None = None) -> None:
        """Measure the new audio (up to frame `upto`), frame by frame: phrases begin, end, and
        get cut when long. echo: per frame, how loud the other side's echo would be here
        (your microphone without headphones); sound that is not louder is no phrase of yours."""
        first, n = self.rms.size, self.length // LIVE_FRAME
        if upto is not None:
            n = min(n, upto)
        if n <= first:
            return
        self.rms = np.concatenate([self.rms, frame_rms(self.audio(base, first * LIVE_FRAME, n * LIVE_FRAME),
                                                       LIVE_FRAME)])
        level = 20 * np.log10(np.maximum(self.rms[max(0, n - LIVE_NOISE):], 1e-10))
        threshold = max(SILENCE_DBFS, float(np.percentile(level, 10)) + LIVE_SNR)
        pad, pause = int(LIVE_PAD * SAMPLE_RATE), int(LIVE_PAUSE * SAMPLE_RATE)
        loud = lambda i: (20 * math.log10(max(self.rms[i], 1e-10)) >= threshold
                          and (echo is None or i >= echo.size or self.rms[i] >= echo[i]))
        for i in range(first, n):
            s, e = i * LIVE_FRAME, (i + 1) * LIVE_FRAME
            if loud(i):
                if self.start is None:
                    self.start = self.partial_at = max(s - pad, self.closed)
                    self.began, self.sound = s, 0
                self.last, self.sound = e, self.sound + 1
            elif self.start is not None and e - self.last >= pause:
                self.close(self.last + pad)
            if self.start is not None and e - self.start >= LIVE_LONGEST * SAMPLE_RATE:
                # (between two words: the quietest 100 ms of its last 5 s)
                tail = self.audio(base, e - 5 * SAMPLE_RATE, e)
                cut = e - tail.size + quietest_cut(tail, tail.size)
                self.close(cut, go_on=sum(loud(j) for j in range(cut // LIVE_FRAME, i + 1)))

    def close(self, end: int, go_on: int | None = None) -> None:
        """The phrase being said ends at `end`. go_on: the next one starts there, with this
        many frames of sound already."""
        start, end = self.start, min(end, self.length)
        assert start is not None
        if end - start >= LIVE_FRAME and self.sound * LIVE_FRAME >= LIVE_MIN_SOUND * SAMPLE_RATE:
            self.ended.append((start, end))
            self.heard += self.sound * LIVE_FRAME
            if start in self.drafts:  # (its draft stays until it is transcribed)
                self.drafts[start] = [d for d in self.drafts[start] if d.end <= end / SAMPLE_RATE]
        else:
            self.drafts.pop(start, None)
        self.closed = self.partial_at = end
        if go_on is None:
            self.start, self.sound = None, 0
        else:
            self.start = self.began = end
            self.sound, self.last = go_on, max(self.last, end)

    def end_phrase(self) -> None:
        """The recording paused or ended: so did the phrase being said."""
        if self.start is not None:
            self.close(self.last + int(LIVE_PAD * SAMPLE_RATE))

    def settled(self) -> int:
        """Samples up to which everything said was transcribed (the other side's text, which
        your microphone's echo is told apart by, must be there first)."""
        if self.ended:
            return self.ended[0][0]
        return self.began if self.start is not None else self.rms.size * LIVE_FRAME

    def speech(self) -> float:
        """Seconds of sound in the phrases so far."""
        return (self.heard + self.sound * LIVE_FRAME) / SAMPLE_RATE


class LiveMeeting:
    """--live: a meeting's transcript while bmeet-meeting-audio records it (see LIVE_TICK)."""

    def __init__(self, folder: Path, in_person: bool) -> None:
        self.folder = folder
        self.mic = LiveTrack("mic", "Room" if in_person else "You")
        self.remote = None if in_person else LiveTrack("remote", "Remote")
        self.tracks = [t for t in (self.remote, self.mic) if t is not None]
        self.part = 0
        self.parts: list[Part] = []
        self.base = 0                     # the first sample kept in memory (all tracks)
        self.calls: list[tuple[float, bool, bool]] = []
        self.calls_read = 0               # bytes of call-mic.jsonl read
        self.engine: Whisper | GigaAM | None = None
        self.kwargs: dict = {}
        self.gain, self.gain_at = 0.0, 0  # echo_gain() so far, and at how many frames
        self.echoes = self.muted = 0      # your words left out, as echo / while muted

    # -- the recording
    def take_in(self) -> bool:
        """Read what was recorded since the last look; True if there was something."""
        got = False
        while True:
            if self.part == 0:
                if not (self.folder / "part-1.start").exists():
                    return False
                self.next_part()
            # A newer part means this one is complete: the recorder stopped it (a pause) first.
            newer = (self.folder / f"part-{self.part + 1}.start").exists()
            got = any([t.take_in(self.base) for t in self.tracks]) or got
            if not newer:
                break
            self.end_part()
            self.next_part()
        self.parts[-1].length = max(t.length for t in self.tracks) / SAMPLE_RATE - self.parts[-1].offset
        return got

    def next_part(self) -> None:
        self.part += 1
        try:
            wall: float | None = float((self.folder / f"part-{self.part}.start").read_text().strip())
        except (OSError, ValueError):
            wall = None
        self.parts.append(Part(max(t.length for t in self.tracks) / SAMPLE_RATE, 0.0, wall))
        for t in self.tracks:
            t.file, t.data, t.read = self.folder / f"part-{self.part}-{t.kind}.wav", 0, 0

    def end_part(self) -> None:
        """Both tracks of a part are made as long (as read_meeting() does), its phrases end."""
        n = max(t.length for t in self.tracks)
        self.listen(end=True)
        for t in self.tracks:
            t.end_phrase()
            t.append(np.zeros(n - t.length, np.float32), self.base)

    def listen(self, end: bool = False) -> None:
        """LiveTrack.listen() for both tracks: the other side first, as your microphone's
        phrases are only what is louder than its echo (ECHO_MARGIN, as in drop_echo())."""
        if self.remote is None:
            self.mic.listen(self.base)
            return
        self.remote.listen(self.base)
        if not self.gain or self.remote.rms.size - self.gain_at >= 100:  # (once known: every 10 s)
            self.gain, self.gain_at = echo_gain_of(self.mic.rms, self.remote.rms), self.remote.rms.size
        # (your track waits for theirs, unless theirs stopped growing: then without the echo)
        behind = not end and self.remote.length + 2 * SAMPLE_RATE >= self.mic.length
        self.mic.listen(self.base, self.remote.rms.size if behind else None,
                        ECHO_MARGIN * self.gain * self.remote.rms if self.gain > 0 else None)

    def muted_spans(self) -> list[tuple[float, float]]:
        """muted_spans() of the call log so far (bmeet-chrome-host appends to it)."""
        try:
            with open(self.folder / "call-mic.jsonl", "rb") as f:
                f.seek(self.calls_read)
                text = f.read()
        except OSError:
            text = b""
        text = text[:text.rfind(b"\n") + 1]  # (whole lines only)
        if text:
            self.calls_read += len(text)
            for line in text.decode(errors="replace").splitlines():
                try:
                    d = json.loads(line)
                    self.calls.append((float(d["t"]), bool(d["call"]), bool(d["live"])))
                except (ValueError, KeyError, TypeError):
                    continue
            self.calls.sort()
        return muted_spans(self.calls, self.parts) if self.calls else []

    # -- the text
    def step(self, engines: Engines, args: argparse.Namespace, over: bool, still: bool = False) -> bool:
        """Transcribe what can be (over: the recording ended, so everything; still: nothing
        was recorded for a while, so the phrases being said are over); True if the text changed."""
        self.listen(end=over)
        if over or still:
            for t in self.tracks:
                t.end_phrase()
        if self.engine is None and not self.choose(engines, args, over):
            return False
        changed = False
        if self.remote:
            changed |= self.finish(self.remote, list(self.remote.ended))
        # Yours waits while the other side says something at the same time (your phrase's
        # padding may reach into theirs: only its sound counts).
        settled = self.remote.settled() + int(LIVE_PAD * SAMPLE_RATE) if self.remote and not over else math.inf
        changed |= self.finish(self.mic, [p for p in self.mic.ended if p[1] <= settled])
        if isinstance(self.engine, GigaAM) and not over:
            for t in self.tracks:
                changed |= self.draft(t)
        self.let_go()
        return changed

    def choose(self, engines: Engines, args: argparse.Namespace, over: bool) -> bool:
        """The model, once the language is known: given, or detected by Whisper on the first
        LIVE_DETECT s said on the other side (like the speaker pass: your microphone may hold
        little of your own; in person, on the microphone). False while it is not known yet."""
        if args.engine == "gigaam":
            language = "ru"
        elif args.language != "auto":
            language = args.language
        else:
            t = next((t for t in self.tracks if t.speech() >= LIVE_DETECT), None)
            if t is self.mic and self.remote and self.mic.speech() < 3 * LIVE_DETECT and not over:
                t = None  # (you have spoken for a while, the others hardly: then yours)
            if t is None and over:
                t = max(self.tracks, key=lambda x: x.speech())
            if t is None or t.speech() == 0:
                return False
            spans = t.ended + ([(t.start, t.length)] if t.start is not None else [])
            sound = np.concatenate([t.audio(self.base, a, b) for a, b in spans])
            language = engines.detect(array_blocks(sound[:BLOCK_SECONDS * SAMPLE_RATE]))
        self.engine, language = engines.for_language(language, words=True)
        if isinstance(self.engine, GigaAM):
            engines._whisper = None  # (only needed for detecting the language: frees ~2 GB)
        else:
            self.kwargs = {"return_timestamps": True, "task": "transcribe", "word_timestamps": True}
            if language not in ("auto", "?"):
                self.kwargs["language"] = f"<|{language}|>"
        log(f"live: {language}, {engine_label(self.engine)} on {self.engine.device} "
            f"(CPU so far {cpu_seconds():.1f} s)")
        return True

    def hear(self, t: LiveTrack, a: int, b: int) -> list[Segment]:
        """Phrase [a, b) of track t, transcribed; your words the call did not get, or that are
        the other side's echo, left out."""
        block = t.audio(self.base, a, b)
        if block.size == 0 or peak_dbfs(block) < SILENCE_DBFS:
            return []
        if isinstance(self.engine, GigaAM):
            segments = ctc_block(self.engine, a / SAMPLE_RATE, block)
        else:
            segments = whisper_block(self.engine, a / SAMPLE_RATE, block, self.kwargs)[0]
        for seg in segments:
            seg.speaker = t.label
        if t is not self.mic or not self.remote or not segments:
            return segments
        return self.not_echo(self.not_muted(segments))

    def not_muted(self, segments: list[Segment]) -> list[Segment]:
        if not (spans := self.muted_spans()):
            return segments
        out = []
        for seg in segments:
            cut = [any(x <= (w.start + w.end) / 2 < y for x, y in spans) for w in seg.words]
            self.muted += sum(cut)
            out += without_words(seg, cut)
        return out

    def not_echo(self, segments: list[Segment]) -> list[Segment]:
        assert self.remote is not None
        if not segments:
            return []
        a, b = segments[0].start - ECHO_WINDOW, segments[-1].end + ECHO_WINDOW
        theirs = [s for s in self.remote.final + [d for ds in self.remote.drafts.values() for d in ds]
                  if s.end >= a and s.start <= b]
        n = min(self.mic.length, self.remote.length)
        off = self.base / SAMPLE_RATE
        kept, cut = drop_echo(shifted(segments, -off), shifted(theirs, -off),
                              self.mic.audio(self.base, self.base, n), self.remote.audio(self.base, self.base, n),
                              echo_gain_of(self.mic.rms, self.remote.rms))
        self.echoes += cut
        return shifted(kept, off)

    def finish(self, t: LiveTrack, phrases: list[tuple[int, int]]) -> bool:
        for a, b in phrases:
            t.final += tidy_segments(self.hear(t, a, b))
            t.drafts.pop(a, None)
            t.ended.remove((a, b))
        return bool(phrases)

    def draft(self, t: LiveTrack) -> bool:
        """The phrase being said, as far as it goes (every LIVE_PARTIAL s of it)."""
        if t.start is None or t.last - t.partial_at < LIVE_PARTIAL * SAMPLE_RATE:
            return False
        echoes, muted = self.echoes, self.muted
        t.drafts[t.start] = tidy_segments(self.hear(t, t.start, t.last))
        self.echoes, self.muted = echoes, muted  # (counted when it is final)
        t.partial_at = t.last
        return True

    def let_go(self) -> None:
        """Forget the audio that no phrase needs any more."""
        need = min(min([a for a, _ in t.ended] + [t.start if t.start is not None else t.length])
                   for t in self.tracks)
        need = min([need] + [t.rms.size * LIVE_FRAME for t in self.tracks]) - SAMPLE_RATE
        if need - self.base >= LIVE_KEEP * SAMPLE_RATE:
            for t in self.tracks:
                t.forget(self.base, need)
            self.base = need

    def markdown(self, title: str, started: float | None, done: bool) -> str:
        segments = [s for t in self.tracks for s in t.final]
        if not done:  # what is still being said, in italics
            segments += [Segment(d.start, d.end, f"*{d.text} …*", d.words, d.speaker)
                         for t in self.tracks for ds in t.drafts.values() for d in ds]
        segments.sort(key=lambda s: s.start)
        how = f"{engine_label(self.engine)} on {self.engine.device}" if self.engine else "…"
        meta = {"Transcribed": f"as people talked (live), {how}"} if done else \
            {"Live": f"transcribed as people talk, {how}; in italics: still being said"}
        if self.muted:
            meta["Microphone off"] = f"{self.muted} word(s) the call could not hear (muted) were left out"
        if self.echoes:
            meta["Echo"] = f"{self.echoes} word(s) your microphone picked up from the speakers were left out"
        duration = max(t.length for t in self.tracks) / SAMPLE_RATE
        return meeting_md(title, started, duration, segments, meta, tidied=True,
                          empty="*(nothing said yet)*" if not done else "*(no speech detected)*")


def live_meeting(args: argparse.Namespace, engines: Engines) -> int:
    """--live DIR: DIR/live.md while bmeet-meeting-audio records DIR (see LiveMeeting). Ends
    with the recording (it no longer names DIR in $XDG_RUNTIME_DIR/bmeet/recording, or env
    BMEET_RECORDING_FILE), at SIGTERM/SIGINT, or when the speaker pass starts; then the last
    phrases are transcribed, live.md is written once more and DIR/live.done marks it whole."""
    folder = args.live.expanduser()
    pointer = Path(os.environ.get("BMEET_RECORDING_FILE")
                   or Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "bmeet/recording")
    try:
        info = json.loads((folder / "meeting.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        info = {}
    title, started = args.title or info.get("title") or "Meeting", info.get("started")
    meeting = LiveMeeting(folder, bool(info.get("in_person")))
    out = folder / "live.md"
    stop = threading.Event()
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: stop.set())
    log(f"live: following {folder}")
    t0, c0, seen, written = time.monotonic(), cpu_seconds(), False, ""
    heard = t0
    try:
        while True:
            try:
                ours = Path(pointer.read_text().strip()).resolve() == folder.resolve()
            except OSError:
                ours = False
            seen |= ours
            over = (stop.is_set() or (seen and not ours) or (folder / "speaker-pass").exists()
                    or (not seen and time.monotonic() - t0 > LIVE_START))
            if not folder.is_dir():
                log("live: the recording is gone")
                return 1
            if meeting.take_in():
                heard = time.monotonic()
            if over:
                meeting.end_part()
            changed = meeting.step(engines, args, over, still=time.monotonic() - heard > LIVE_STILL)
            if changed or over or not written:
                text = meeting.markdown(title, started, done=over)
                if text != written:
                    write_atomic(out, text)
                    written = text
            if over:
                break
            stop.wait(max(0.0, LIVE_TICK - (time.monotonic() - t0) % LIVE_TICK))
    except Exception as exc:
        log(f"ERROR: live: {exc}")
        return 1
    if meeting.part == 0:
        log("live: nothing was recorded")
        return 1
    try:
        (folder / "live.done").touch()
    except OSError:  # (the recording is gone already)
        return 1
    said = sum(len(t.final) for t in meeting.tracks)
    log(f"live: done, {hms(max(t.length for t in meeting.tracks) / SAMPLE_RATE)} of audio, {said} sentence(s)"
        f" (CPU {cpu_seconds() - c0:.1f} s)")
    return 0


def history_model(engine: Whisper | GigaAM | None, args: argparse.Namespace, model_dir: Path) -> str:
    """The "model" of a history line: gigaam, or --model as given (turbo, small, a path)."""
    if isinstance(engine, GigaAM):
        return "gigaam"
    return args.model if args.model in MODELS else str(model_dir)


def main(argv: list[str]) -> int:
    global VERBATIM
    args = parse_args(argv)
    VERBATIM = args.verbatim
    for tool in ("ffmpeg", "ffprobe"):
        if not shutil.which(tool):
            raise SystemExit(f"{PROG}: {tool} not found in PATH")
    model_dir = resolve_model(args.model)
    gen_kwargs: dict = {"return_timestamps": True,
                        "task": "translate" if args.translate else "transcribe"}
    if args.language != "auto":
        known = model_languages(model_dir)
        if known is not None and args.language not in known:
            raise SystemExit(f"{PROG}: unknown language {args.language!r}; "
                             f"choose from: {' '.join(sorted(known))}")
        gen_kwargs["language"] = f"<|{args.language}|>"
    if args.out:
        try:
            args.out.expanduser().mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            raise SystemExit(f"{PROG}: cannot create --out directory: {exc}")

    forced_language = args.language if args.language != "auto" else "?"
    engines = Engines(args, model_dir, pick_devices(args.device))
    if args.meeting:
        return transcribe_meeting(args, engines, gen_kwargs)
    if args.live:
        return live_meeting(args, engines)

    report: list[str] = []
    failed = 0
    for i, src in enumerate(args.files, 1):
        src = src.expanduser()
        written: list[Path] = []
        t: Transcript | None = None
        speakers: int | None = None
        engine: Whisper | GigaAM | None = None
        if len(args.files) > 1:
            log(f"[{i}/{len(args.files)}] {src}")
        try:
            if not src.is_file():
                raise RuntimeError("no such file")
            out_dir = output_dir(src, args.out)  # checked before the expensive part
            engine, language = engines.choose(args.language, audio_blocks(src))
            kwargs = dict(gen_kwargs, language=f"<|{language}|>") \
                if not isinstance(engine, GigaAM) and language not in ("auto", "?") else gen_kwargs
            terms = 0
            if args.speakers or isinstance(engine, GigaAM):  # (the whole recording at once)
                samples = decode_all(src)
                t = transcribe(engine, src.name, array_blocks(samples), samples.size / SAMPLE_RATE, kwargs)
                t0 = time.monotonic()
                if isinstance(engine, GigaAM) and t.segments:
                    terms = engines.english_terms(samples, t)
                if args.speakers:
                    found = diarize(engines.speakers(), samples, args.num_speakers)[0] if t.segments else []
                    t.segments, labels = number_speakers(t.segments, found, "Speaker", "Speaker ?")
                    speakers = len(set(labels.values()))
                t.wall += time.monotonic() - t0
                del samples
            else:
                t = transcribe(engine, src.name, audio_blocks(src), probe_duration(src), kwargs)
            speed = t.duration / t.wall if t.wall > 0 else 0.0
            lang = f"{t.language} ({'given' if args.language != 'auto' else 'detected'})" \
                if t.language != "?" else "- (no speech found)"
            model_name = engine_label(engine)
            meta = {
                "File": src.name,
                "Duration": hms(t.duration),
                "Language": lang + (", translated to English" if args.translate else ""),
                "Model": f"{model_name} on {engine.device}, {speed:.1f}x realtime",
                "Created": f"{datetime.now():%Y-%m-%d %H:%M} by {PROG}",
            }
            if terms:
                meta["English terms"] = f"{terms} written as Whisper heard them (GigaAM garbles English)"
            if speakers is not None:
                meta["Speakers"] = f"{speakers}, told apart by voice" + \
                    (f" (asked for {args.num_speakers})" if args.num_speakers else "")
            render = {"srt": lambda: to_srt(t), "md": lambda: to_md(t, src, meta),
                      "txt": lambda: to_txt(t)}
            stem = output_stem(out_dir, src, args.formats, args.overwrite)
            for fmt in args.formats:
                dest = out_dir / f"{stem}.{fmt}"
                if dest.resolve() == src.resolve():
                    raise RuntimeError(f"refusing to overwrite the input file with {fmt} output")
                write_atomic(dest, render[fmt]())
                written.append(dest)
                print(dest, flush=True)  # stdout: just the paths, for scripting
        except KeyboardInterrupt:
            log("interrupted")
            return 130
        except Exception as exc:
            failed += 1
            log(f"ERROR: {src.name}: {exc}")
            report.append(f"FAILED {src.name}: {exc}")
            record_history(src, written, history_model(engine, args, model_dir),
                           t.language if t else forced_language,
                           engine.device if engine else args.device, t.duration if t else None, ok=False)
            continue
        record_history(src, written, history_model(engine, args, model_dir), t.language, engine.device,
                       t.duration, ok=True, speakers=speakers)
        log(f"done: {src.name}: {hms(t.duration)} of audio in {t.wall:.1f} s with {model_name} on {engine.device} "
            f"({speed:.1f}x realtime), {len(t.segments)} segment(s), language {lang}"
            + (f", {speakers} speaker(s)" if speakers is not None else "")
            + (f", dropped {t.dropped} segment(s) over silence" if t.dropped else ""))
        report.append(f"{src.name} → {out_dir / stem}.{{{','.join(args.formats)}}} "
                      f"({hms(t.duration)} in {t.wall:.0f} s, {engine.device})")

    if args.notify:
        notify(failed == 0, report)
    return 1 if failed else 0


if __name__ == "__main__":  # guard also keeps multiprocessing re-imports harmless
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        log("interrupted")
        sys.exit(130)
