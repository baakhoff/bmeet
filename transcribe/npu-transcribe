try:
    import numpy as np  # noqa: E402  (must come after the telemetry block above)
except ImportError:
    sys.exit("npu-transcribe: numpy/openvino-genai are missing - run it through the "
             "installer's wrapper (~/.local/bin/npu-transcribe) or its venv")

__version__ = "0.3.1"
MODELS_DIR = Path(os.environ.get("NPU_MODELS_DIR")
                  or Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "npu-models")
MODELS = {
    "turbo": MODELS_DIR / "whisper-large-v3-turbo-int8-ov",
    "small": MODELS_DIR / "whisper-small-int8-ov",
}
CACHE_DIR = Path.home() / ".cache/npu-ov-cache"  # compiled NPU blobs
HISTORY = Path(os.environ.get("NPU_TRANSCRIBE_HISTORY")
               or Path.home() / ".local/share/npu-transcribe/history.jsonl")
SAMPLE_RATE = 16_000          # what Whisper expects
# Audio per generate() call: one Whisper window. Longer blocks let OpenVINO GenAI chain
# 30 s windows itself, and on real Russian calls that lost most punctuation and capitals
# after the first window and misheard more words (docs/npu-transcribe.md), at no speed gain.
BLOCK_SECONDS = 30
CUT_SEARCH_SECONDS = 10       # cut each block at the quietest 100 ms of its last 10 s
SILENCE_DBFS = -50.0          # blocks/segments with a lower peak are treated as silence
SILENCE_AMPLITUDE = 10 ** (SILENCE_DBFS / 20)
CUE_MARGIN = 0.2              # seconds kept around the audible part of a cue
# What Whisper writes over silence and noise (from the subtitles it was trained on). A
# segment that is only these words is dropped (letters and digits compared, any case).
HALLUCINATIONS = (
    "продолжение следует", "спасибо за просмотр", "подписывайтесь на канал",
    "субтитры сделал dimatorzok", "субтитры создавал dimatorzok", "субтитры делал dimatorzok",
    "редактор субтитров а синецкая корректор а кулакова", "субтитры подготовлены сообществом amara org",
    "thank you for watching", "thanks for watching", "please subscribe",
    "subtitles by the amara org community",
)
PARAGRAPH_SECONDS = 30       # Markdown/text paragraph length (approximate)
FORMATS = ("srt", "md", "txt")
# Speaker diarization (sherpa-onnx): pyannote segmentation-3.0 finds who speaks when in
# 10 s windows, a speaker-embedding model fingerprints each voice, and the fingerprints
# are clustered. The installer downloads both models (sha256-pinned).
SPEAKER_MODELS = MODELS_DIR / "speaker-diarization"
SEGMENTATION_MODEL = SPEAKER_MODELS / "pyannote-segmentation-3-0.onnx"
EMBEDDING_MODEL = SPEAKER_MODELS / "nemo_en_titanet_small.onnx"  # NVIDIA TitaNet-small, CC-BY-4.0
# Clustering threshold for "same voice" when the number of speakers is not given: higher
# merges more. With TitaNet, 0.8-0.9 found the right number of people in every test call
# (0.7 split people, 1.0 merged two); see docs/npu-transcribe.md. Env NPU_SPEAKER_THRESHOLD
# overrides it: lower when two people end up as one, higher when one person is split.
SPEAKER_THRESHOLD = float(os.environ.get("NPU_SPEAKER_THRESHOLD") or 0.85)
WORD_SMOOTH_SECONDS = 0.6     # a speaker change shorter than this inside a sentence is noise
# Remembered voices (--voices): a voice in a new meeting gets a remembered name when its
# fingerprint is at least this similar (cosine). TitaNet on LibriSpeech readers through
# Opus, fingerprints from different recordings: the same person >= 0.80, others <= 0.40.
VOICE_SIMILARITY = 0.55
VOICE_MARGIN = 0.1            # ... and at least this much more similar than to anyone else remembered
# On real calls the clustering also makes "voices" of fragments (a laugh, a cough, codec
# glitches; one 1:1 call came out as 30 voices) and splits a person in two. A voice with
# less speech than MIN_VOICE_SECONDS and MIN_VOICE_SHARE of all joins the voice it sounds
# most like (or the nearest one in time); a voice at least SAME_VOICE similar to a bigger
# one joins it.
MIN_VOICE_SECONDS = 15
MIN_VOICE_SHARE = 0.05
SAME_VOICE = 0.65
NEAREST_SECONDS = 30          # words no turn covers go to the nearest speaker within this
VOICE_WINDOW = 2.0            # long turns are also checked in windows this long ...
VOICE_HOP = 0.5               # ... this far apart, and split where a remembered person
VOICE_MIN_RUN = 1.5           # changes for at least this long (similar voices share a turn)
FINGERPRINT_SECONDS = 60      # a person's fingerprint: their longest turns, up to this much speech
ECHO_MARGIN = 2.0             # meeting: a mic word at most this much louder than the echo
                              # expected from the system audio at that moment is the echo
ECHO_WINDOW = 2.0             # without word timestamps: look this far around a mic line ...
ECHO_SHARE = 0.6              # ... and drop it when this share of its words was said remotely
PROG = "npu-transcribe"
STDERR_LOCK = threading.Lock()  # log() and the progress ticker share stderr
UMASK = os.umask(0o022)
os.umask(UMASK)                 # read the umask once (still single-threaded here)


def log(msg: str) -> None:
    """Log to stderr; on a terminal, first clear a half-drawn progress line."""
    prefix = "\r\x1b[K" if sys.stderr.isatty() else ""
    with STDERR_LOCK:
        print(f"{prefix}{PROG}: {msg}", file=sys.stderr, flush=True)


def hms(seconds: float) -> str:
    s = int(seconds)
    return f"{s // 3600:02d}:{s % 3600 // 60:02d}:{s % 60:02d}"


def srt_time(seconds: float) -> str:
    ms = int(round(seconds * 1000))
    return f"{ms // 3_600_000:02d}:{ms % 3_600_000 // 60_000:02d}:{ms % 60_000 // 1000:02d},{ms % 1000:03d}"


def hallucination(text: str) -> bool:
    """Is this segment only one of Whisper's stock phrases (HALLUCINATIONS), maybe repeated?"""
    words = " ".join(re.findall(r"\w+", text.lower()))
    for phrase in HALLUCINATIONS:
        if words and words.replace(phrase, " ").strip() == "":
            return True
    return False


def peak_dbfs(samples: np.ndarray) -> float:
    peak = float(np.abs(samples).max()) if samples.size else 0.0
    return 20 * math.log10(peak) if peak > 0 else -math.inf


def audible_span(samples: np.ndarray, s: float, e: float) -> tuple[float, float] | None:
    """Shrink the cue [s, e] (seconds into `samples`) to its audible part plus
    CUE_MARGIN; None if all of it is below SILENCE_DBFS.

    Whisper starts a segment at the beginning of its 30 s window even after long
    digital silence (20 s silent intro -> cue "00:00:00 --> 00:00:25", measured on
    both models/devices; max_initial_timestamp_index does not change it).
    Only true (digital) silence is trimmed; a normal noise floor is louder.
    """
    i = int(s * SAMPLE_RATE)
    loud = np.flatnonzero(np.abs(samples[i:int(e * SAMPLE_RATE)]) >= SILENCE_AMPLITUDE)
    if loud.size == 0:
        return None
    first, last = (i + loud[0]) / SAMPLE_RATE, (i + loud[-1]) / SAMPLE_RATE
    return max(s, first - CUE_MARGIN), min(e, last + CUE_MARGIN)


# --------------------------------------------------------------------------- audio

def ff_input(path: Path) -> str:
    """Input name for ffmpeg/ffprobe. The explicit file: protocol keeps a relative
    name like "talk: part 1.ogg" from being read as protocol "talk" (measured:
    "Protocol not found" without it)."""
    return f"file:{path}"


def probe_duration(path: Path) -> float | None:
    """Duration in seconds for the progress percentage: the first audio stream's,
    else the container's (Matroska/WebM often lack per-stream durations)."""
    for args in (["-select_streams", "a:0", "-show_entries", "stream=duration"],
                 ["-show_entries", "format=duration"]):
        out = subprocess.run(["ffprobe", "-v", "error", *args, "-of", "csv=p=0", ff_input(path)],
                             capture_output=True, text=True)
        try:
            return float(out.stdout.split()[0])
        except (ValueError, IndexError):
            continue
    return None


def quietest_cut(samples: np.ndarray, search: int, frame: int = SAMPLE_RATE // 10) -> int:
    """Sample index inside the last `search` samples with the least energy (between words)."""
    start = max(0, len(samples) - search)
    n = (len(samples) - start) // frame
    if n == 0:
        return len(samples)
    energy = np.square(samples[start:start + n * frame].reshape(n, frame)).mean(axis=1)
    return start + int(energy.argmin()) * frame + frame // 2


def audio_blocks(path: Path) -> Iterator[tuple[float, np.ndarray]]:
    """Yield (start_seconds, samples) blocks of 16 kHz mono float32 decoded by ffmpeg."""
    cmd = ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error", "-i", ff_input(path),
           "-map", "0:a:0", "-vn", "-sn", "-dn",
           # Keep samples on the file's timeline: pad with silence when the audio
           # track starts after the video (or has gaps). Without this a track that
           # starts 3 s late gave cues 3 s early (measured on a test .mkv).
           "-af", "aresample=async=1:first_pts=0",
           "-ac", "1", "-ar", str(SAMPLE_RATE), "-f", "f32le", "pipe:1"]
    block_bytes = BLOCK_SECONDS * SAMPLE_RATE * 4
    # stderr goes to a temp file: a corrupt input can log more than a pipe buffer holds.
    with tempfile.TemporaryFile() as err, \
            subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=err) as proc:
        assert proc.stdout is not None
        offset, pending, eof = 0, b"", False
        try:
            while not eof:
                want = block_bytes - len(pending)
                data = proc.stdout.read(want)  # blocks until `want` bytes or EOF
                eof = len(data) < want
                pending += data
                samples = np.frombuffer(pending, np.float32, len(pending) // 4)
                if samples.size == 0:
                    break
                cut = samples.size if eof else quietest_cut(samples, CUT_SEARCH_SECONDS * SAMPLE_RATE)
                yield offset / SAMPLE_RATE, samples[:cut]
                offset += cut
                pending = pending[cut * 4:]
        finally:
            if proc.poll() is None:  # consumer stopped early (error, Ctrl+C)
                proc.kill()
        if proc.wait() != 0:
            err.seek(0)
            msg = err.read().decode(errors="replace").strip()
            if "matches no streams" in msg:  # from -map 0:a:0
                raise RuntimeError("no audio stream in this file")
            last = msg.splitlines()[-1] if msg else f"exit status {proc.returncode}"
            raise RuntimeError(f"ffmpeg failed: {last}")
        if offset == 0:
            raise RuntimeError("no audio decoded (empty file?)")


def decode_all(path: Path) -> np.ndarray:
    """The whole audio track as one 16 kHz mono float32 array (for --speakers/--meeting)."""
    return np.concatenate([block for _, block in audio_blocks(path)])


def array_blocks(samples: np.ndarray) -> Iterator[tuple[float, np.ndarray]]:
    """Like audio_blocks(), for audio that is already in memory."""
    block, offset = BLOCK_SECONDS * SAMPLE_RATE, 0
    while offset < samples.size:
        chunk = samples[offset:offset + block]
        cut = chunk.size if offset + block >= samples.size \
            else quietest_cut(chunk, CUT_SEARCH_SECONDS * SAMPLE_RATE)
        yield offset / SAMPLE_RATE, chunk[:cut]
        offset += cut


# --------------------------------------------------------------------------- whisper

class Whisper:
    """WhisperPipeline on the first working device of `devices` (e.g. NPU, then CPU)."""

    def __init__(self, model_dir: Path, devices: list[str], word_timestamps: bool = False) -> None:
        self.model_dir, self.devices = model_dir, devices
        # Word timestamps (for splitting sentences between speakers) need a pipeline built
        # for them: on the NPU that is a separate compile (turbo ~1 min, cached), and each
        # generate() takes ~8% longer.
        self.word_timestamps = word_timestamps
        self.device = ""
        self.used = False  # has generate() run since the last load?
        self._load()

    def _load(self) -> None:
        import openvino_genai as ov_genai
        while True:
            dev = self.devices[0]
            note = " (the first NPU run compiles the model: ~1 min small, ~4 min turbo;" \
                " cached afterwards)" if dev == "NPU" and not self.device else ""
            log(f"loading {self.model_dir.name} on {dev}{note}")
            t0 = time.monotonic()
            # CACHE_DIR only for the NPU: its compile is slow, CPU loads in seconds anyway.
            kwargs = {"CACHE_DIR": str(CACHE_DIR)} if dev == "NPU" else {}
            if self.word_timestamps:
                kwargs["word_timestamps"] = True
            try:
                self.pipe = ov_genai.WhisperPipeline(str(self.model_dir), dev, **kwargs)
            except Exception as exc:  # driver missing, compile error, out of memory, ...
                self._fall_back(f"loading on {dev} failed: {exc}")
                continue
            self.device, self.used = dev, False
            log(f"model ready on {dev} in {time.monotonic() - t0:.1f} s")
            return

    def ready_for_detection(self) -> None:
        """Make sure the next generate() really auto-detects the language.

        NPU bug (openvino_genai 2026.4.1, both models, measured 2026-10-11): with
        language unset, only the first generate() of a pipeline detects the
        language; later calls silently reuse the previous call's language, so a
        Russian file after an English one came out as an English translation.
        Forced languages work on every call. Workaround: reload (~3 s from the
        compile cache) before detecting again. The CPU pipeline detects correctly.
        """
        if self.device == "NPU" and self.used:
            log("reloading the NPU pipeline so language auto-detection starts fresh")
            del self.pipe
            self._load()

    def _fall_back(self, reason: str) -> None:
        reason = " ".join(reason.split())  # OpenVINO errors span several lines
        if len(self.devices) < 2:
            raise RuntimeError(reason)
        log(f"WARNING: {reason}; falling back to {self.devices[1]}")
        self.devices.pop(0)

    def generate(self, samples: np.ndarray, **kwargs):
        """pipe.generate(); on failure reload on the next device and retry this block.

        Known NPU failure: openvino.genai issue #4222 ("invalid unordered_map<K, T> key"
        at the first generate() with some Whisper exports on Lunar Lake).
        """
        while True:
            try:
                self.used = True
                return self.pipe.generate(samples, **kwargs)
            except Exception as exc:
                self._fall_back(f"transcription on {self.device} failed: {exc}")
                del self.pipe
                self._load()


@dataclass
class Word:
    start: float
    end: float
    text: str        # as Whisper spells it, usually with a leading space


@dataclass
class Segment:
    start: float
    end: float
    text: str
    words: list[Word] = field(default_factory=list)  # only with word timestamps
    speaker: str = ""                                # only with --speakers/--meeting


@dataclass
class Transcript:
    segments: list[Segment]
    duration: float
    wall: float      # seconds spent decoding + transcribing
    language: str    # given, or detected on the first non-silent block
    dropped: int     # segments discarded as silence hallucinations


# --------------------------------------------------------------------------- progress

class Progress:
    """Status line on stderr: percent done, position, elapsed time, speed.

    On a terminal it is redrawn every second (also while Whisper is busy);
    otherwise one line is printed per finished block.
    """

    def __init__(self, name: str, total: float | None) -> None:
        self.name, self.total, self.done = name, total, 0.0
        self.t0 = time.monotonic()
        self.tty = sys.stderr.isatty()
        self._stop = threading.Event()
        if self.tty:
            threading.Thread(target=self._tick, daemon=True).start()

    def _line(self) -> str:
        elapsed = time.monotonic() - self.t0
        pct = f"{min(100.0, 100 * self.done / self.total):3.0f}%" if self.total else "  ?%"
        speed = f"{self.done / elapsed:.1f}x" if self.done and elapsed > 0 else "-"
        total = hms(self.total) if self.total else "?"
        return f"{self.name}: {pct}  {hms(self.done)}/{total}  elapsed {hms(elapsed)}  speed {speed}"

    def _draw(self) -> None:
        with STDERR_LOCK:
            sys.stderr.write("\r\x1b[K" + self._line()[:shutil.get_terminal_size().columns - 1])
            sys.stderr.flush()

    def _tick(self) -> None:
        while not self._stop.wait(1.0):
            self._draw()

    def update(self, done: float) -> None:
        self.done = done
        if self.tty:
            self._draw()
        else:
            print(self._line(), file=sys.stderr, flush=True)

    def close(self) -> None:
        self._stop.set()
        if self.tty:
            self._draw()
            sys.stderr.write("\n")


# --------------------------------------------------------------------------- transcription

def transcribe(whisper: Whisper, name: str, blocks: Generator[tuple[float, np.ndarray], None, None],
               duration: float | None, gen_kwargs: dict) -> Transcript:
    """Transcribe one recording block by block (blocks: audio_blocks() or array_blocks()).

    With --language auto the language is detected on the first non-silent block
    and then pinned for the rest of the file (like the openai-whisper CLI does);
    this keeps a file consistent and sidesteps the NPU detection bug above.
    """
    language = gen_kwargs.get("language", "").strip("<|>")
    if not language:
        whisper.ready_for_detection()
    if whisper.word_timestamps:
        gen_kwargs = dict(gen_kwargs, word_timestamps=True)
    progress = Progress(name, duration)
    segments: list[Segment] = []
    dropped, done = 0, 0.0
    t0 = time.monotonic()
    try:
        for start, block in blocks:
            length = block.size / SAMPLE_RATE
            # Whisper invents text ("Thank you.") for pure silence: skip silent
            # blocks and drop segments whose audio is (digitally) silent.
            if peak_dbfs(block) >= SILENCE_DBFS:
                kwargs = dict(gen_kwargs, language=f"<|{language}|>") if language else gen_kwargs
                result = whisper.generate(block, **kwargs)
                if not language and result.language:
                    language = result.language.strip("<|>")
                    log(f"language: {language} (auto-detected from the first block)")
                words = [Word(float(w.start_ts), float(w.end_ts), w.word)
                         for w in (getattr(result, "words", None) or [])]
                chunks = [c for c in result.chunks or [] if c.text.strip()]
                for i, chunk in enumerate(chunks):
                    text = " ".join(chunk.text.split())  # one line: a blank line would end the SRT cue
                    s = min(max(float(chunk.start_ts), 0.0), length)
                    e = min(max(float(chunk.end_ts), s + 0.5), length)  # end may be missing
                    # this segment's words: those centred before its end (the last one takes the rest)
                    n = len(words) if i == len(chunks) - 1 else \
                        sum(1 for _ in itertools.takewhile(lambda w: (w.start + w.end) / 2 <= e, words))
                    mine, words = words[:n], words[n:]
                    span = audible_span(block, s, e)
                    if span is None or hallucination(text):
                        dropped += 1
                        continue
                    segments.append(Segment(start + span[0], start + span[1], text,
                                            [Word(start + w.start, start + w.end, w.text) for w in mine]))
            done = start + length
            progress.update(done)
    finally:
        blocks.close()  # stops ffmpeg right away if we bail out early
        progress.close()
    return Transcript(segments, done, time.monotonic() - t0, language or "?", dropped)


# --------------------------------------------------------------------------- speakers

@dataclass
class Turn:
    start: float
    end: float
    speaker: int     # 0, 1, ... in the order the voices first speak


def speaker_models_missing() -> list[Path]:
    return [p for p in (SEGMENTATION_MODEL, EMBEDDING_MODEL) if not p.is_file()]


def unit(v) -> np.ndarray:
    a = np.asarray(v, np.float64)
    return a / (np.linalg.norm(a) or 1.0)


def diarize(samples: np.ndarray, num_speakers: int = 0, fingerprints: bool = False,
            known: dict[str, list[list[float]]] | None = None
            ) -> tuple[list[Turn], dict[int, list[float]], dict[int, str]]:
    """Who speaks when, on the CPU (sherpa-onnx). num_speakers=0: find out how many.

    Returns the turns, each voice's fingerprint (with fingerprints or known; see
    voice_prints) and the remembered names found among the voices (known; see identify)."""
    try:
        import sherpa_onnx
    except ImportError:
        raise RuntimeError("sherpa-onnx is missing from the venv - run the installer again")
    if missing := speaker_models_missing():
        raise RuntimeError(f"speaker model missing: {missing[0]} - run the installer again")
    threads = max(1, min(4, (os.cpu_count() or 2) // 2))
    config = sherpa_onnx.OfflineSpeakerDiarizationConfig(
        segmentation=sherpa_onnx.OfflineSpeakerSegmentationModelConfig(
            pyannote=sherpa_onnx.OfflineSpeakerSegmentationPyannoteModelConfig(
                model=str(SEGMENTATION_MODEL)),
            num_threads=threads),
        embedding=sherpa_onnx.SpeakerEmbeddingExtractorConfig(
            model=str(EMBEDDING_MODEL), num_threads=threads),
        clustering=sherpa_onnx.FastClusteringConfig(
            num_clusters=num_speakers or -1, threshold=SPEAKER_THRESHOLD),
        min_duration_on=0.3, min_duration_off=0.5)
    if not config.validate():
        raise RuntimeError("the speaker models could not be loaded - run the installer again")
    sd = sherpa_onnx.OfflineSpeakerDiarization(config)
    log(f"telling voices apart ({hms(samples.size / SAMPLE_RATE)} of audio, {threads} CPU threads)")
    t0 = time.monotonic()
    result = sd.process(samples).sort_by_start_time()
    order: dict[int, int] = {}
    turns = [Turn(r.start, r.end, order.setdefault(r.speaker, len(order))) for r in result]
    prints: dict[int, list[float]] = {}
    names: dict[int, str] = {}
    if turns:
        extractor = sherpa_onnx.SpeakerEmbeddingExtractor(sherpa_onnx.SpeakerEmbeddingExtractorConfig(
            model=str(EMBEDDING_MODEL), num_threads=threads))

        def embed(start: float, end: float) -> np.ndarray:
            stream = extractor.create_stream()
            stream.accept_waveform(SAMPLE_RATE, samples[int(start * SAMPLE_RATE):int(end * SAMPLE_RATE)])
            stream.input_finished()
            return unit(extractor.compute(stream))

        if known:
            turns = split_by_known_voices(turns, embed, remembered_voices(known))
        vecs: dict[int, tuple[np.ndarray, float]] = {}
        for i, t in enumerate(turns):
            if t.end - t.start >= 1.0:
                mid = (t.start + t.end) / 2
                start, end = max(t.start, mid - 7.5), min(t.end, mid + 7.5)  # at most 15 s
                vecs[i] = (embed(start, end), end - start)
        turns, vecs = merge_voices(turns, vecs)
        if known:
            turns, names = identify(turns, vecs, known)
        prints = voice_prints(turns, vecs)
    log(f"{len({t.speaker for t in turns})} voice(s) in {time.monotonic() - t0:.1f} s"
        + (f", recognised: {', '.join(sorted(set(names.values())))}" if names else ""))
    return turns, prints, names


def merge_voices(turns: list[Turn], vecs: dict[int, tuple[np.ndarray, float]]
                 ) -> tuple[list[Turn], dict[int, tuple[np.ndarray, float]]]:
    """Fold the voices the clustering made too much of into the voices they belong to
    (MIN_VOICE_SECONDS and MIN_VOICE_SHARE, SAME_VOICE), smallest first. vecs: {turn index: (embedding, seconds)}.
    Returns the turns with their new voices (and vecs, unchanged: indexes stay)."""
    turns = list(turns)
    fragment = min(MIN_VOICE_SECONDS, MIN_VOICE_SHARE * sum(t.end - t.start for t in turns))
    while True:
        speech: dict[int, float] = {}
        sums: dict[int, np.ndarray] = {}
        for i, t in enumerate(turns):
            speech[t.speaker] = speech.get(t.speaker, 0.0) + t.end - t.start
            if i in vecs:
                v, seconds = vecs[i]
                sums[t.speaker] = sums.get(t.speaker, 0.0) + v * seconds
        centroid = {v: unit(c) for v, c in sums.items()}
        target = None
        for voice in sorted(speech, key=speech.__getitem__):
            bigger = [u for u in speech if u != voice and speech[u] >= speech[voice]]
            if not bigger:
                continue
            similar = {u: float(centroid[voice] @ centroid[u]) for u in bigger
                       if voice in centroid and u in centroid}
            closest = max(similar, key=similar.__getitem__) if similar else None
            if speech[voice] < fragment:
                if closest is None:  # no turn long enough to compare: the nearest voice in time
                    first = next(t for t in turns if t.speaker == voice)
                    closest = min((t for t in turns if t.speaker in bigger),
                                  key=lambda t: max(t.start - first.end, first.start - t.end)).speaker
                target = (voice, closest)
            elif closest is not None and similar[closest] >= SAME_VOICE:
                target = (voice, closest)
            if target:
                break
        if target is None:
            return turns, vecs
        turns = [Turn(t.start, t.end, target[1]) if t.speaker == target[0] else t for t in turns]


def remembered_voices(known: dict[str, list[list[float]]]) -> dict[str, np.ndarray]:
    """{name: the mean of their fingerprints (unit length)}"""
    return {name: unit(np.mean([unit(f) for f in fps], axis=0)) for name, fps in known.items()}


def who_is(v: np.ndarray, voices: dict[str, np.ndarray]) -> str | None:
    """The remembered person this embedding belongs to: VOICE_SIMILARITY similar to their
    voice, and VOICE_MARGIN more than to anyone else remembered; else None."""
    ranked = sorted(((float(v @ k), name) for name, k in voices.items()), reverse=True)
    if ranked and ranked[0][0] >= VOICE_SIMILARITY and \
            (len(ranked) == 1 or ranked[0][0] - ranked[1][0] >= VOICE_MARGIN):
        return ranked[0][1]
    return None


def split_by_known_voices(turns: list[Turn], embed, voices: dict[str, np.ndarray]) -> list[Turn]:
    """Split turns in which remembered people take turns: with similar voices the
    segmentation can miss the change. embed(start, end) -> embedding. Turns of
    2 * VOICE_WINDOW or more are checked in VOICE_WINDOW windows every VOICE_HOP; a
    remembered person heard for VOICE_MIN_RUN or more gets their own piece."""
    out: list[Turn] = []
    for t in turns:
        if t.end - t.start < 2 * VOICE_WINDOW:
            out.append(t)
            continue
        starts = np.arange(t.start, t.end - VOICE_WINDOW + 1e-6, VOICE_HOP)
        ids = [who_is(embed(a, a + VOICE_WINDOW), voices) for a in starts]
        for order in (range(len(ids)), reversed(range(len(ids)))):  # unclear windows: neighbour's
            last = None
            for i in order:
                if ids[i] is None:
                    ids[i] = last
                last = ids[i]
        runs = [[name, len(list(group))] for name, group in itertools.groupby(ids)]
        min_windows = max(1, round(VOICE_MIN_RUN / VOICE_HOP))
        merged: list[list] = []
        for name, n in runs:  # a short run joins its neighbour
            if merged and (name == merged[-1][0] or n < min_windows):
                merged[-1][1] += n
            else:
                merged.append([name, n])
        if len(merged) > 1 and merged[0][1] < min_windows:
            merged[1][1] += merged.pop(0)[1]
        if len(merged) < 2:
            out.append(t)
            continue
        cuts, i = [t.start], 0
        for _, n in merged[:-1]:
            i += n  # first window of the next run: cut between the two windows' middles
            cuts.append(float(starts[i - 1] + starts[i]) / 2 + VOICE_WINDOW / 2)
        cuts.append(t.end)
        out += [Turn(a, b, t.speaker) for a, b in zip(cuts, cuts[1:])]
    return out


def identify(turns: list[Turn], vecs: dict[int, tuple[np.ndarray, float]],
             known: dict[str, list[list[float]]]) -> tuple[list[Turn], dict[int, str]]:
    """Remembered people in a recording. vecs: {turn index: (embedding, seconds)}.

    A turn is a remembered person's when who_is() says so. A voice (cluster) whose
    recognised speech is mostly one person's takes their name; that person's turns inside
    another voice (two people the clustering merged) move to them. Returns the turns
    (moved ones get a new voice number) and {voice: name}."""
    voices = remembered_voices(known)
    whose = {i: name for i, (v, _) in vecs.items() if (name := who_is(v, voices))}
    names: dict[int, str] = {}
    for voice in {t.speaker for t in turns}:
        heard: dict[str, float] = {}
        for i, t in enumerate(turns):
            if t.speaker == voice and i in whose:
                heard[whose[i]] = heard.get(whose[i], 0.0) + vecs[i][1]
        measured = sum(vecs[i][1] for i, t in enumerate(turns) if t.speaker == voice and i in vecs)
        if heard and (best := max(heard, key=heard.__getitem__)) and heard[best] >= measured / 2:
            names[voice] = best
    extra = {name: max(t.speaker for t in turns) + 1 + n for n, name in enumerate(voices)}
    moved = []
    for i, t in enumerate(turns):
        if i in whose and names.get(t.speaker) != whose[i]:
            t = Turn(t.start, t.end, extra[whose[i]])
            names[t.speaker] = whose[i]
        moved.append(t)
    return moved, names


def voice_prints(turns: list[Turn], vecs: dict[int, tuple[np.ndarray, float]]) -> dict[int, list[float]]:
    """Each voice's fingerprint, to remember it by: the duration-weighted mean of the
    embeddings of its longest turns, up to FINGERPRINT_SECONDS (unit length)."""
    prints: dict[int, list[float]] = {}
    for voice in {t.speaker for t in turns}:
        total, acc = 0.0, np.zeros(0)
        for i in sorted((i for i, t in enumerate(turns) if t.speaker == voice and i in vecs),
                        key=lambda i: -vecs[i][1]):  # longest first
            if total >= FINGERPRINT_SECONDS:
                break
            v, seconds = vecs[i]
            acc = v * seconds if not acc.size else acc + v * seconds
            total += seconds
        if acc.size:
            prints[voice] = [round(float(x), 5) for x in unit(acc)]
    return prints


def diarize_aside(samples: np.ndarray, num_speakers: int = 0, fingerprints: bool = False,
                  known: dict[str, list[list[float]]] | None = None) -> concurrent.futures.Future:
    """diarize() in a second process, so the CPU tells voices apart while Whisper runs on
    the NPU (sherpa-onnx holds the GIL: in a thread Whisper would just wait). "spawn",
    not fork: the parent may hold the NPU."""
    pool = concurrent.futures.ProcessPoolExecutor(1, mp_context=multiprocessing.get_context("spawn"))
    try:
        return pool.submit(diarize, samples, num_speakers, fingerprints, known)
    finally:
        pool.shutdown(wait=False)


def speaker_at(turns: list[Turn], start: float, end: float) -> int | None:
    """The speaker who talks most during [start, end]; else the nearest one within
    NEAREST_SECONDS (short replies like "Угу" or "Yes" often get no turn of their own)."""
    best, best_overlap, near, near_gap = None, 0.0, None, NEAREST_SECONDS
    for t in turns:  # sorted by start
        if t.start >= end + near_gap:
            break
        overlap = min(end, t.end) - max(start, t.start)
        if overlap > best_overlap:
            best, best_overlap = t.speaker, overlap
        elif best is None and (gap := max(t.start - end, start - t.end)) <= near_gap:
            near, near_gap = t.speaker, gap
    return best if best is not None else near


def label_speakers(seg: Segment, turns: list[Turn], name) -> list[Segment]:
    """Give a segment its speaker (name(n) for speaker n, name(None) if unknown).

    With word timestamps the segment is split where the voice changes, so a sentence
    that crosses a change of speaker is not given to one of them; runs shorter than
    WORD_SMOOTH_SECONDS are put to their neighbour (diarization jitter around pauses).
    """
    if not seg.words:
        return [Segment(seg.start, seg.end, seg.text, seg.words,
                        name(speaker_at(turns, seg.start, seg.end)))]
    who = [speaker_at(turns, w.start, w.end) for w in seg.words]
    for order in (range(len(who)), reversed(range(len(who)))):  # words between turns: neighbour's
        last = None
        for i in order:
            if who[i] is None:
                who[i] = last
            last = who[i]
    runs = [(spk, list(group)) for spk, group in
            itertools.groupby(zip(who, seg.words), key=lambda x: x[0])]
    merged: list[tuple[int | None, list[Word]]] = []
    for spk, pairs in runs:
        words = [w for _, w in pairs]
        if merged and (spk == merged[-1][0] or words[-1].end - words[0].start < WORD_SMOOTH_SECONDS):
            merged[-1][1].extend(words)
        else:
            merged.append((spk, words))
    if len(merged) > 1 and merged[0][1][-1].end - merged[0][1][0].start < WORD_SMOOTH_SECONDS:
        merged[1] = (merged[1][0], merged[0][1] + merged[1][1])  # a short first run joins the next
        del merged[0]
    if len(merged) == 1:
        return [Segment(seg.start, seg.end, seg.text, seg.words, name(merged[0][0]))]
    return [Segment(words[0].start, words[-1].end, " ".join("".join(w.text for w in words).split()),
                    words, name(spk)) for spk, words in merged]


def tokens(text: str) -> list[str]:
    return re.findall(r"\w+", text.lower())


def rms(samples: np.ndarray, start: float, end: float) -> float:
    part = samples[int(start * SAMPLE_RATE):int(end * SAMPLE_RATE)]
    return float(np.sqrt(np.square(part, dtype=np.float64).mean())) if part.size else 0.0


def echo_gain(mic: np.ndarray, remote: np.ndarray) -> float:
    """How loud the system audio comes back through the microphone: the median mic/remote
    loudness ratio over the 100 ms frames where the remote side is loudest (you are
    silent in most of them). ~0 with headphones."""
    frame = SAMPLE_RATE // 10
    n = min(mic.size, remote.size) // frame
    if n == 0:
        return 0.0
    loud_r = np.sqrt(np.square(remote[:n * frame].reshape(n, frame), dtype=np.float64).mean(axis=1))
    loud_m = np.sqrt(np.square(mic[:n * frame].reshape(n, frame), dtype=np.float64).mean(axis=1))
    loud = loud_r >= max(SILENCE_AMPLITUDE, float(np.percentile(loud_r, 70)))
    return float(np.median(loud_m[loud] / loud_r[loud])) if loud.sum() >= 20 else 0.0


def drop_echo(mine: list[Segment], theirs: list[Segment], mic: np.ndarray,
              remote: np.ndarray) -> tuple[list[Segment], int]:
    """Meeting without headphones: the microphone also hears the other side, and Whisper
    writes their words into your track too, often in the same sentence as your own.

    With word timestamps, a word is the echo when the microphone is not clearly louder
    (ECHO_MARGIN) than the echo the system audio would cause at that moment; those words
    are cut out. Without them, a whole line goes when ECHO_SHARE of its words were said
    remotely within ECHO_WINDOW. Returns the kept segments and the number of words cut."""
    gain = echo_gain(mic, remote)
    kept: list[Segment] = []
    cut = 0
    for seg in mine:
        if seg.words:
            echo = [gain > 0 and rms(mic, w.start, w.end) < ECHO_MARGIN * gain * rms(remote, w.start, w.end)
                    for w in seg.words]
            cut += sum(echo)
            for is_echo, group in itertools.groupby(zip(echo, seg.words), key=lambda x: x[0]):
                words = [w for _, w in group]
                text = " ".join("".join(w.text for w in words).split())
                if not is_echo and tokens(text):
                    if len(words) == len(seg.words):
                        kept.append(seg)
                    else:
                        kept.append(Segment(words[0].start, words[-1].end, text, words, seg.speaker))
            continue
        said = tokens(seg.text)
        pool: dict[str, int] = {}
        for r in theirs:
            if r.end >= seg.start - ECHO_WINDOW and r.start <= seg.end + ECHO_WINDOW:
                for tok in tokens(r.text):
                    pool[tok] = pool.get(tok, 0) + 1
        hits = 0
        for tok in said:
            if pool.get(tok, 0) > 0:
                pool[tok] -= 1
                hits += 1
        if said and hits / len(said) >= ECHO_SHARE:
            cut += len(said)
        else:
            kept.append(seg)
    return kept, cut


def load_voices(folder: Path) -> dict[str, list[list[float]]]:
    """Remembered voices, {name: [fingerprint, ...]}, from FOLDER/voices.json (the BMeet
    app writes it when you name people). Fingerprints of another model are ignored."""
    try:
        data = json.loads((folder / "voices.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if data.get("model") != EMBEDDING_MODEL.name:
        return {}
    return {name: v["fingerprints"] for name, v in (data.get("voices") or {}).items()
            if isinstance(v, dict) and v.get("fingerprints")}


def number_speakers(segments: list[Segment], found: list[Turn], word: str, unknown: str,
                    names: dict[int, str] | None = None) -> tuple[list[Segment], dict[int, str]]:
    """Label (and split) segments by speaker as "<word> 1", "<word> 2", ... numbered in the
    order they first say something (a voice that only coughed gets no number). Voices in
    `names` (recognised) keep that name instead. Returns the segments and {voice: label}."""
    names = names or {}
    labelled = [part for seg in segments
                for part in label_speakers(seg, found, lambda n: "" if n is None else str(n))]
    labels: dict[int, str] = {}
    for seg in labelled:
        if seg.speaker and (voice := int(seg.speaker)) not in labels:
            numbered = sum(1 for v in labels if v not in names)
            labels[voice] = names.get(voice) or f"{word} {numbered + 1}"
    for seg in labelled:
        seg.speaker = labels[int(seg.speaker)] if seg.speaker else unknown
    return labelled, labels


PART_NAME = re.compile(r"^part-(\d+)-(mic|remote)\.wav$")


def read_meeting(folder: Path) -> tuple[np.ndarray, np.ndarray]:
    """A recording by bmeet-meeting-audio: part-N-mic.wav + part-N-remote.wav for each
    stretch between pauses, joined in order. The two tracks of a part are padded to the
    same length so they stay in step across pauses."""
    parts = sorted({int(m[1]) for f in folder.iterdir() if (m := PART_NAME.match(f.name))})
    if not parts:
        raise RuntimeError(f"no recording in {folder}")
    mics, remotes = [], []
    for n in parts:
        tracks = []
        for kind in ("mic", "remote"):
            path = folder / f"part-{n}-{kind}.wav"
            try:
                tracks.append(decode_all(path) if path.is_file() else np.zeros(0, np.float32))
            except RuntimeError as exc:  # empty part: the recorder stopped right away
                log(f"WARNING: {path.name}: {exc}")
                tracks.append(np.zeros(0, np.float32))
        length = max(t.size for t in tracks)
        mics.append(np.pad(tracks[0], (0, length - tracks[0].size)))
        remotes.append(np.pad(tracks[1], (0, length - tracks[1].size)))
    return np.concatenate(mics), np.concatenate(remotes)


# --------------------------------------------------------------------------- output

def paragraphs(segments: list[Segment]) -> list[tuple[float, str]]:
    """Join segments into ~PARAGRAPH_SECONDS paragraphs, preferably at sentence ends."""
    out: list[tuple[float, str]] = []
    parts: list[str] = []
    para_start = 0.0
    for seg in segments:
        age = seg.start - para_start
        if parts and age >= PARAGRAPH_SECONDS and (
                parts[-1].endswith((".", "!", "?", "…", "。", "？", "！")) or age >= 1.5 * PARAGRAPH_SECONDS):
            out.append((para_start, " ".join(parts)))
            parts = []
        if not parts:
            para_start = seg.start
        parts.append(seg.text)
    if parts:
        out.append((para_start, " ".join(parts)))
    return out


def turns(segments: list[Segment]) -> list[tuple[str, list[Segment]]]:
    """Consecutive segments of the same speaker ("" without --speakers)."""
    return [(spk, list(group)) for spk, group in itertools.groupby(segments, key=lambda s: s.speaker)]


def speaker_paragraphs(segments: list[Segment]) -> list[tuple[float, str, str]]:
    """(start, speaker, text): paragraphs that never mix two speakers."""
    return [(start, spk, text) for spk, group in turns(segments) for start, text in paragraphs(group)]


def to_srt(t: Transcript) -> str:
    cues = [f"{i}\n{srt_time(s.start)} --> {srt_time(s.end)}\n"
            f"{f'{s.speaker}: ' if s.speaker else ''}{s.text}\n"
            for i, s in enumerate(t.segments, 1)]
    return "\n".join(cues)


def to_md(t: Transcript, src: Path, meta: dict[str, str]) -> str:
    head = [f"# {src.stem}", ""] + [f"- **{k}:** {v}" for k, v in meta.items()]
    body = [f"[{hms(start)}] " + (f"**{spk}:** " if spk else "") + text
            for start, spk, text in speaker_paragraphs(t.segments)]
    return "\n".join(head) + "\n\n" + "\n\n".join(body or ["*(no speech detected)*"]) + "\n"


def to_txt(t: Transcript) -> str:
    return "\n\n".join((f"{spk}: " if spk else "") + text
                       for _, spk, text in speaker_paragraphs(t.segments)) + "\n"


def meeting_time(seconds: float) -> str:
    """[mm:ss] like voxtype's meeting export; [h:mm:ss] from the first hour on."""
    s = int(seconds)
    return f"{s // 3600}:{s % 3600 // 60:02d}:{s % 60:02d}" if s >= 3600 else f"{s // 60:02d}:{s % 60:02d}"


def meeting_md(title: str, started: float | None, duration: float, segments: list[Segment],
               meta: dict[str, str]) -> str:
    """The meeting transcript, laid out like `voxtype meeting export --format markdown`
    (which it replaces): a heading per change of speaker, a [mm:ss] mark per paragraph."""
    speakers = sorted({s.speaker for s in segments},
                      key=lambda n: (n != "You", int(n.split()[-1]) if n[-1:].isdigit() else 0, n))
    info = ([f"- **Date:** {datetime.fromtimestamp(started):%Y-%m-%d %H:%M}"] if started else []) + [
        f"- **Duration:** {int(duration) // 60}m {int(duration) % 60}s",
        f"- **Word Count:** {sum(len(s.text.split()) for s in segments)}",
        f"- **Speakers:** {', '.join(speakers) or '-'}",
    ] + [f"- **{k}:** {v}" for k, v in meta.items()]
    body = []
    for spk, group in turns(segments):
        body += [f"### {spk}", ""]
        body += [f"*[{meeting_time(start)}]* {text}\n" for start, text in paragraphs(group)]
    return "\n".join([f"# {title}", "", "## Meeting Info", "", *info, "", "## Transcript", "",
                      *(body or ["*(no speech detected)*", ""])])


def write_atomic(path: Path, text: str, private: bool = False) -> None:
    """Write via a temp file + rename so a crash never leaves half a transcript.
    private: keep mkstemp's 0600 (voice fingerprints)."""
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        if not private:
            os.chmod(tmp, 0o666 & ~UMASK)  # mkstemp creates 0600; use normal file modes
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def notify(ok: bool, body: list[str], summary: str = "") -> None:
    """Desktop notification (used by the Dolphin service menu and meetings)."""
    if not shutil.which("notify-send"):
        return
    summary = summary or ("Transcription finished" if ok else "Transcription failed")
    cmd = ["notify-send", f"--app-name={PROG}", "--icon=view-media-lyrics",
           f"--urgency={'normal' if ok else 'critical'}", summary,
           html.escape("\n".join(body[:10]), quote=False)]  # body allows simple markup
    subprocess.run(cmd, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def record_history(src: Path, outputs: list[Path], model: str, language: str,
                   device: str, duration: float | None, ok: bool, speakers: int | None = None) -> None:
    """Append one JSON line per finished file to HISTORY (read by the BMeet
    app and bmeet-ctl). Best effort: a failure here only logs a warning."""
    try:
        if duration is None:  # failed before/while decoding: ask ffprobe
            duration = probe_duration(src) if src.is_file() else None
        entry = {
            "time": int(time.time()),
            "input": os.path.abspath(src),
            "outputs": [os.path.abspath(p) for p in outputs],
            "model": model,
            "language": language,
            "device": device,
            "duration": round(float(duration or 0.0), 3),
            "status": "done" if ok else "failed",
        }
        if speakers is not None:
            entry["speakers"] = speakers
        HISTORY.parent.mkdir(parents=True, exist_ok=True)
        with open(HISTORY, "a", encoding="utf-8") as f:
            fcntl.flock(f, fcntl.LOCK_EX)  # the app rewrites the file under the same lock
            f.write(json.dumps(entry) + "\n")
    except Exception as exc:  # never let the history break a transcription
        log(f"WARNING: could not update {HISTORY}: {exc}")


