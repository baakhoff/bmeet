def log(msg: str) -> None:
    """Log to stderr; on a terminal, first clear a half-drawn progress line."""
    prefix = "\r\x1b[K" if sys.stderr.isatty() else ""
    with STDERR_LOCK:
        print(f"{prefix}{PROG}: {msg}", file=sys.stderr, flush=True)


def cpu_seconds() -> float:
    """CPU time used so far by this process and its finished children (ffmpeg), in seconds.
    Logged per stage: the models are meant to run on the NPU, the CPU only does the glue."""
    t = os.times()
    return t.user + t.system + t.children_user + t.children_system


def hms(seconds: float) -> str:
    s = int(seconds)
    return f"{s // 3600:02d}:{s % 3600 // 60:02d}:{s % 60:02d}"


def srt_time(seconds: float) -> str:
    ms = int(round(seconds * 1000))
    return f"{ms // 3_600_000:02d}:{ms % 3_600_000 // 60_000:02d}:{ms % 60_000 // 1000:02d},{ms % 1000:03d}"


def hallucination(text: str) -> bool:
    """Is this segment only one of Whisper's stock phrases (HALLUCINATIONS), maybe repeated?"""
    words = " ".join(re.findall(r"\w+", text.lower()))
    for phrase in HALLUCINATIONS:
        if words and words.replace(phrase, " ").strip() == "":
            return True
    return False


# Whisper sometimes loops over audio it cannot make out ("Я в рейтинге. Я в рейтинге. ..."
# for a minute on a real call). A phrase of 2-12 words said this many times in a row in one
# segment is kept once (a single word: REPEAT_WORD times, so "нет, нет, нет" stays).
REPEAT_PHRASE = 3
REPEAT_WORD = 5


def collapse_repeats(seg: Segment) -> Segment:
    """The segment with Whisper's loops (REPEAT_PHRASE / REPEAT_WORD) said once."""
    units = seg.words or seg.text.split()
    keys = [re.sub(r"\W+", "", (u.text if isinstance(u, Word) else u).lower()) for u in units]
    kept, i, cut = [], 0, False
    while i < len(units):
        step = 1
        for size in range(1, 13):
            need = REPEAT_WORD if size == 1 else REPEAT_PHRASE
            phrase = keys[i:i + size]
            if i + size * need > len(units):
                break
            if not all(phrase):
                continue
            count = 1
            while keys[i + count * size:i + (count + 1) * size] == phrase:
                count += 1
            if count >= need:
                step, cut = size * count, True
                break
        kept += units[i:i + (size if step > 1 else 1)]
        i += step
    if not cut:
        return seg
    if seg.words:
        return Segment(seg.start, kept[-1].end, " ".join("".join(w.text for w in kept).split()),
                       kept, seg.speaker)
    return Segment(seg.start, seg.end, " ".join(kept), [], seg.speaker)


def drop_repeated_segments(segments: list[Segment]) -> list[Segment]:
    """A loop across segments: the same words REPEAT_PHRASE or more times in a row are kept once."""
    out: list[Segment] = []
    for _, group in itertools.groupby(segments, key=lambda seg: tuple(tokens(seg.text)) or id(seg)):
        group = list(group)
        out += group[:1] if len(group) >= REPEAT_PHRASE else group
    return out


def peak_dbfs(samples: np.ndarray) -> float:
    peak = float(np.abs(samples).max()) if samples.size else 0.0
    return 20 * math.log10(peak) if peak > 0 else -math.inf


def audible_span(samples: np.ndarray, s: float, e: float) -> tuple[float, float] | None:
    """Shrink the cue [s, e] (seconds into `samples`) to its audible part plus
    CUE_MARGIN; None if all of it is below SILENCE_DBFS.

    Whisper starts a segment at the beginning of its 30 s window even after long
    digital silence (20 s silent intro -> cue "00:00:00 --> 00:00:25", measured on
    both models/devices; max_initial_timestamp_index does not change it).
    Only true (digital) silence is trimmed; a normal noise floor is louder.
    """
    i = int(s * SAMPLE_RATE)
    loud = np.flatnonzero(np.abs(samples[i:int(e * SAMPLE_RATE)]) >= SILENCE_AMPLITUDE)
    if loud.size == 0:
        return None
    first, last = (i + loud[0]) / SAMPLE_RATE, (i + loud[-1]) / SAMPLE_RATE
    return max(s, first - CUE_MARGIN), min(e, last + CUE_MARGIN)


# --------------------------------------------------------------------------- audio

def ff_input(path: Path) -> str:
    """Input name for ffmpeg/ffprobe. The explicit file: protocol keeps a relative
    name like "talk: part 1.ogg" from being read as protocol "talk" (measured:
    "Protocol not found" without it)."""
    return f"file:{path}"


def probe_duration(path: Path) -> float | None:
    """Duration in seconds for the progress percentage: the first audio stream's,
    else the container's (Matroska/WebM often lack per-stream durations)."""
    for args in (["-select_streams", "a:0", "-show_entries", "stream=duration"],
                 ["-show_entries", "format=duration"]):
        out = subprocess.run(["ffprobe", "-v", "error", *args, "-of", "csv=p=0", ff_input(path)],
                             capture_output=True, text=True)
        try:
            return float(out.stdout.split()[0])
        except (ValueError, IndexError):
            continue
    return None


def quietest_cut(samples: np.ndarray, search: int, frame: int = SAMPLE_RATE // 10) -> int:
    """Sample index inside the last `search` samples with the least energy (between words)."""
    start = max(0, len(samples) - search)
    n = (len(samples) - start) // frame
    if n == 0:
        return len(samples)
    energy = np.square(samples[start:start + n * frame].reshape(n, frame)).mean(axis=1)
    return start + int(energy.argmin()) * frame + frame // 2


def audio_blocks(path: Path) -> Iterator[tuple[float, np.ndarray]]:
    """Yield (start_seconds, samples) blocks of 16 kHz mono float32 decoded by ffmpeg."""
    cmd = ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error", "-i", ff_input(path),
           "-map", "0:a:0", "-vn", "-sn", "-dn",
           # Keep samples on the file's timeline: pad with silence when the audio
           # track starts after the video (or has gaps). Without this a track that
           # starts 3 s late gave cues 3 s early (measured on a test .mkv).
           "-af", "aresample=async=1:first_pts=0",
           "-ac", "1", "-ar", str(SAMPLE_RATE), "-f", "f32le", "pipe:1"]
    block_bytes = BLOCK_SECONDS * SAMPLE_RATE * 4
    # stderr goes to a temp file: a corrupt input can log more than a pipe buffer holds.
    with tempfile.TemporaryFile() as err, \
            subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=err) as proc:
        assert proc.stdout is not None
        offset, pending, eof = 0, b"", False
        try:
            while not eof:
                want = block_bytes - len(pending)
                data = proc.stdout.read(want)  # blocks until `want` bytes or EOF
                eof = len(data) < want
                pending += data
                samples = np.frombuffer(pending, np.float32, len(pending) // 4)
                if samples.size == 0:
                    break
                cut = samples.size if eof else quietest_cut(samples, CUT_SEARCH_SECONDS * SAMPLE_RATE)
                yield offset / SAMPLE_RATE, samples[:cut]
                offset += cut
                pending = pending[cut * 4:]
        finally:
            if proc.poll() is None:  # consumer stopped early (error, Ctrl+C)
                proc.kill()
        if proc.wait() != 0:
            err.seek(0)
            msg = err.read().decode(errors="replace").strip()
            if "matches no streams" in msg:  # from -map 0:a:0
                raise RuntimeError("no audio stream in this file")
            last = msg.splitlines()[-1] if msg else f"exit status {proc.returncode}"
            raise RuntimeError(f"ffmpeg failed: {last}")
        if offset == 0:
            raise RuntimeError("no audio decoded (empty file?)")


def decode_all(path: Path) -> np.ndarray:
    """The whole audio track as one 16 kHz mono float32 array (for --speakers/--meeting)."""
    return np.concatenate([block for _, block in audio_blocks(path)])


def array_blocks(samples: np.ndarray) -> Iterator[tuple[float, np.ndarray]]:
    """Like audio_blocks(), for audio that is already in memory."""
    block, offset = BLOCK_SECONDS * SAMPLE_RATE, 0
    while offset < samples.size:
        chunk = samples[offset:offset + block]
        cut = chunk.size if offset + block >= samples.size \
            else quietest_cut(chunk, CUT_SEARCH_SECONDS * SAMPLE_RATE)
        yield offset / SAMPLE_RATE, chunk[:cut]
        offset += cut


# --------------------------------------------------------------------------- whisper

class Whisper:
    """WhisperPipeline on the first working device of `devices` (e.g. NPU, then CPU)."""

    def __init__(self, model_dir: Path, devices: list[str], word_timestamps: bool = False) -> None:
        self.model_dir, self.devices = model_dir, devices
        # Word timestamps (for splitting sentences between speakers) need a pipeline built
        # for them: on the NPU that is a separate compile (turbo ~1 min, cached), and each
        # generate() takes ~8% longer.
        self.word_timestamps = word_timestamps
        self.device = ""
        self.used = False  # has generate() run since the last load?
        self.failures = 0  # blocks that failed in a row
        self._load()

    def _load(self) -> None:
        import openvino_genai as ov_genai
        while True:
            dev = self.devices[0]
            note = " (the first NPU run compiles the model: ~1 min small, ~4 min turbo;" \
                " cached afterwards)" if dev == "NPU" and not self.device else ""
            log(f"loading {self.model_dir.name} on {dev}{note}")
            t0 = time.monotonic()
            # CACHE_DIR only for the NPU: its compile is slow, CPU loads in seconds anyway.
            kwargs = {"CACHE_DIR": str(CACHE_DIR)} if dev == "NPU" else {}
            if self.word_timestamps:
                kwargs["word_timestamps"] = True
            try:
                self.pipe = ov_genai.WhisperPipeline(str(self.model_dir), dev, **kwargs)
            except Exception as exc:  # driver missing, compile error, out of memory, ...
                self._fall_back(f"loading on {dev} failed: {exc}")
                continue
            self.device, self.used = dev, False
            log(f"model ready on {dev} in {time.monotonic() - t0:.1f} s")
            return

    def ready_for_detection(self) -> None:
        """Make sure the next generate() really auto-detects the language.

        NPU bug (openvino_genai 2026.4.1, both models, measured 2026-10-11): with
        language unset, only the first generate() of a pipeline detects the
        language; later calls silently reuse the previous call's language, so a
        Russian file after an English one came out as an English translation.
        Forced languages work on every call. Workaround: reload (~3 s from the
        compile cache) before detecting again. The CPU pipeline detects correctly.
        """
        if self.device == "NPU" and self.used:
            log("reloading the NPU pipeline so language auto-detection starts fresh")
            del self.pipe
            self._load()

    def _fall_back(self, reason: str) -> None:
        reason = " ".join(reason.split())  # OpenVINO errors span several lines
        if len(self.devices) < 2:
            raise RuntimeError(reason)
        log(f"WARNING: {reason}; falling back to {self.devices[1]}")
        self.devices.pop(0)

    def generate(self, samples: np.ndarray, **kwargs):
        """pipe.generate(), or None when this block cannot be transcribed.

        A failure is retried once with a fresh pipeline (after an error the NPU pipeline
        can stay broken). A block that fails again is skipped: one bad block must not move
        the rest of a long meeting to the CPU, which once took 23 min of CPU time for 10 min
        of audio. Only after MAX_FAILED_BLOCKS failed blocks in a row (the device itself is
        broken) does it go on with the next device. Known NPU failures: openvino.genai issue
        #4222 ("invalid unordered_map<K, T> key" at the first generate() with some Whisper
        exports on Lunar Lake), and a decoder overflow on loops (WHISPER_MAX_TOKENS).
        """
        kwargs.setdefault("max_new_tokens", WHISPER_MAX_TOKENS)
        for attempt in (1, 2):
            try:
                self.used = True
                result = self.pipe.generate(samples, **kwargs)
                self.failures = 0
                return result
            except Exception as exc:
                reason = " ".join(str(exc).split())  # OpenVINO errors span several lines
                del self.pipe
                if attempt == 1:
                    log(f"WARNING: transcription on {self.device} failed: {reason}; "
                        "retrying this block with a fresh pipeline")
                    self._load()
        self.failures += 1
        if self.failures >= MAX_FAILED_BLOCKS:
            self._fall_back(f"transcription on {self.device} failed for {self.failures} blocks in a row")
            self.failures = 0
            self._load()
            return self.generate(samples, **kwargs)
        self._load()
        log(f"WARNING: a block could not be transcribed on {self.device}: skipped")
        return None


@dataclass
class Word:
    start: float
    end: float
    text: str        # as Whisper spells it, usually with a leading space


@dataclass
class Segment:
    start: float
    end: float
    text: str
    words: list[Word] = field(default_factory=list)  # only with word timestamps
    speaker: str = ""                                # only with --speakers/--meeting


@dataclass
class Transcript:
    segments: list[Segment]
    duration: float
    wall: float      # seconds spent decoding + transcribing
    language: str    # given, or detected on the first non-silent block
    dropped: int     # segments discarded as silence hallucinations


# --------------------------------------------------------------------------- gigaam

def gigaam_ready() -> bool:
    return all((GIGAAM_DIR / f).is_file() for f in ("model.xml", "model.bin", "tokens.txt"))


class GigaAM:
    """GigaAM v3 e2e CTC: Russian speech to punctuated text. On Russian conversation it made
    ~20 % fewer word errors than Whisper large-v3-turbo, at ~200x realtime on the NPU, but
    it knows no other language and mangles English words (docs/npu-transcribe.md)."""
    language = "ru"
    word_timestamps = True      # always: from the CTC output frames
    MELS, N_FFT, HOP = 64, 320, 160
    FRAMES = 1 + (BLOCK_SECONDS * SAMPLE_RATE - N_FFT) // HOP   # 2999 per 30 s block
    STEP = 4 * HOP / SAMPLE_RATE                                # 40 ms per output frame

    def __init__(self, devices: list[str]) -> None:
        import openvino as ov
        self.devices, self.device, self.model_dir = devices, "", GIGAAM_DIR
        self.tokens = [line.rsplit(" ", 1)[0]
                       for line in (GIGAAM_DIR / "tokens.txt").read_text(encoding="utf-8").splitlines()]
        self.blank = len(self.tokens) - 1
        self.window = 0.5 - 0.5 * np.cos(2 * np.pi * np.arange(self.N_FFT) / self.N_FFT)  # periodic Hann
        self.mel = self.mel_filters()
        core = ov.Core()
        while True:
            dev = self.devices[0]
            note = " (the first NPU run compiles it: ~1 min, cached afterwards)" if dev == "NPU" else ""
            log(f"loading GigaAM v3 on {dev}{note}")
            t0 = time.monotonic()
            try:
                self.req = core.compile_model(str(GIGAAM_DIR / "model.xml"), dev,
                                              {"CACHE_DIR": str(CACHE_DIR)} if dev == "NPU" else {}
                                              ).create_infer_request()
            except Exception as exc:
                reason = " ".join(f"loading on {dev} failed: {exc}".split())
                if len(self.devices) < 2:
                    raise RuntimeError(reason)
                log(f"WARNING: {reason}; falling back to {self.devices[1]}")
                self.devices.pop(0)
                continue
            self.device = dev
            log(f"model ready on {dev} in {time.monotonic() - t0:.1f} s")
            return

    @classmethod
    def mel_filters(cls) -> np.ndarray:
        """torchaudio's melscale_fbanks(161 bins, 0-8000 Hz, 64 mels, htk, no norm)"""
        mel = lambda f: 2595.0 * np.log10(1.0 + f / 700.0)
        hz = lambda m: 700.0 * (10 ** (m / 2595.0) - 1.0)
        freqs = np.linspace(0, SAMPLE_RATE // 2, cls.N_FFT // 2 + 1)
        pts = hz(np.linspace(mel(0.0), mel(SAMPLE_RATE / 2), cls.MELS + 2))
        slopes = pts[None, :] - freqs[:, None]
        down = -slopes[:, :-2] / np.diff(pts)[:-1]
        up = slopes[:, 2:] / np.diff(pts)[1:]
        return np.maximum(0.0, np.minimum(down, up))

    def features(self, x: np.ndarray) -> np.ndarray:
        """(64, frames) log-mel like gigaam.preprocess.FeatureExtractor (center=False)"""
        n = 1 + (x.size - self.N_FFT) // self.HOP
        idx = np.arange(self.N_FFT)[None, :] + self.HOP * np.arange(n)[:, None]
        power = np.abs(np.fft.rfft(x[idx] * self.window, n=self.N_FFT)) ** 2
        return np.log(np.clip(power @ self.mel, 1e-9, 1e9)).T.astype(np.float32)

    def words(self, block: np.ndarray) -> list[Word]:
        """A block (<= 30 s) -> its words, timed from the CTC output frames; punctuation
        stays attached, and like Whisper's words each starts with a space."""
        block = np.pad(block[:BLOCK_SECONDS * SAMPLE_RATE], (0, max(0, self.N_FFT - block.size)))
        n = 1 + (block.size - self.N_FFT) // self.HOP
        feats = np.zeros((1, self.MELS, self.FRAMES), np.float32)
        feats[0, :, :n] = self.features(block)[:, :self.FRAMES]
        out = self.req.infer({"features": feats, "feature_lengths": np.array([n], np.int64)})
        ids = next(iter(out.values()))[0, :(n + 3) // 4].argmax(axis=-1)
        words: list[Word] = []
        prev = self.blank
        for i, tok in enumerate(ids):
            if tok != prev and tok != self.blank:
                piece, at = self.tokens[tok], i * self.STEP
                if piece.startswith("▁") or not words:
                    words.append(Word(at, at + self.STEP, " " + piece.lstrip("▁")))
                else:
                    words[-1].end, words[-1].text = at + self.STEP, words[-1].text + piece
            prev = tok
        return [w for w in words if w.text.strip()]


def sentences(words: list[Word], pause: float = 1.5) -> list[Segment]:
    """Segments for a CTC model's words: one per sentence, or broken at a longer pause."""
    out: list[Segment] = []
    current: list[Word] = []

    def close() -> None:
        if current:
            out.append(Segment(current[0].start, current[-1].end,
                               " ".join("".join(w.text for w in current).split()), list(current)))
            current.clear()
    for w in words:
        if current and w.start - current[-1].end > pause:
            close()
        current.append(w)
        if w.text.rstrip("»\"')").endswith((".", "!", "?", "…")):
            close()
    close()
    return out


# --------------------------------------------------------------------------- progress

class Progress:
    """Status line on stderr: percent done, position, elapsed time, speed.

    On a terminal it is redrawn every second (also while Whisper is busy);
    otherwise one line is printed per finished block.
    """

    def __init__(self, name: str, total: float | None) -> None:
        self.name, self.total, self.done = name, total, 0.0
        self.t0 = time.monotonic()
        self.tty = sys.stderr.isatty()
        self._stop = threading.Event()
        if self.tty:
            threading.Thread(target=self._tick, daemon=True).start()

    def _line(self) -> str:
        elapsed = time.monotonic() - self.t0
        pct = f"{min(100.0, 100 * self.done / self.total):3.0f}%" if self.total else "  ?%"
        speed = f"{self.done / elapsed:.1f}x" if self.done and elapsed > 0 else "-"
        total = hms(self.total) if self.total else "?"
        return f"{self.name}: {pct}  {hms(self.done)}/{total}  elapsed {hms(elapsed)}  speed {speed}"

    def _draw(self) -> None:
        with STDERR_LOCK:
            sys.stderr.write("\r\x1b[K" + self._line()[:shutil.get_terminal_size().columns - 1])
            sys.stderr.flush()

    def _tick(self) -> None:
        while not self._stop.wait(1.0):
            self._draw()

    def update(self, done: float) -> None:
        self.done = done
        if self.tty:
            self._draw()
        else:
            print(self._line(), file=sys.stderr, flush=True)

    def close(self) -> None:
        self._stop.set()
        if self.tty:
            self._draw()
            sys.stderr.write("\n")


# --------------------------------------------------------------------------- transcription

def transcribe(whisper: Whisper | GigaAM, name: str,
               blocks: Generator[tuple[float, np.ndarray], None, None],
               duration: float | None, gen_kwargs: dict) -> Transcript:
    """Transcribe one recording block by block (blocks: audio_blocks() or array_blocks()).

    With --language auto the language is detected on the first non-silent block
    and then pinned for the rest of the file (like the openai-whisper CLI does);
    this keeps a file consistent and sidesteps the NPU detection bug above.
    """
    if isinstance(whisper, GigaAM):
        return transcribe_ctc(whisper, name, blocks, duration)
    language = gen_kwargs.get("language", "").strip("<|>")
    if not language:
        whisper.ready_for_detection()
    if whisper.word_timestamps:
        gen_kwargs = dict(gen_kwargs, word_timestamps=True)
    progress = Progress(name, duration)
    segments: list[Segment] = []
    dropped, done = 0, 0.0
    t0 = time.monotonic()
    try:
        for start, block in blocks:
            # Whisper invents text ("Thank you.") for pure silence: skip silent
            # blocks and drop segments whose audio is (digitally) silent.
            if peak_dbfs(block) >= SILENCE_DBFS:
                kwargs = dict(gen_kwargs, language=f"<|{language}|>") if language else gen_kwargs
                found, lost, heard = whisper_block(whisper, start, block, kwargs)
                segments += found
                dropped += lost
                if not language and heard:
                    language = heard
                    log(f"language: {language} (auto-detected from the first block)")
            done = start + block.size / SAMPLE_RATE
            progress.update(done)
    finally:
        blocks.close()  # stops ffmpeg right away if we bail out early
        progress.close()
    if (looped := len(segments) - len(segments := drop_repeated_segments(segments))) > 0:
        log(f"{looped} repeated segment(s) left out (Whisper looping)")
    return Transcript(segments, done, time.monotonic() - t0, language or "?", dropped)


def whisper_block(whisper: Whisper, start: float, block: np.ndarray,
                  kwargs: dict) -> tuple[list[Segment], int, str]:
    """One block (<= 30 s, starting `start` seconds in) through Whisper: (its segments, how
    many were dropped as silence hallucinations or a failed block, the language it heard)."""
    length = block.size / SAMPLE_RATE
    result = whisper.generate(block, **kwargs)
    if result is None:
        return [], 1, ""
    words = [Word(float(w.start_ts), float(w.end_ts), w.word)
             for w in (getattr(result, "words", None) or [])]
    chunks = [c for c in result.chunks or [] if c.text.strip()]
    segments: list[Segment] = []
    dropped = 0
    for i, chunk in enumerate(chunks):
        text = " ".join(chunk.text.split())  # one line: a blank line would end the SRT cue
        s = min(max(float(chunk.start_ts), 0.0), length)
        e = min(max(float(chunk.end_ts), s + 0.5), length)  # end may be missing
        # this segment's words: those centred before its end (the last one takes the rest)
        n = len(words) if i == len(chunks) - 1 else \
            sum(1 for _ in itertools.takewhile(lambda w: (w.start + w.end) / 2 <= e, words))
        mine, words = words[:n], words[n:]
        span = audible_span(block, s, e)
        if span is None or hallucination(text) or not re.search(r"\w", text):
            dropped += 1
            continue
        segments.append(collapse_repeats(Segment(
            start + span[0], start + span[1], text,
            [Word(start + w.start, start + w.end, w.text) for w in mine])))
    return segments, dropped, (result.language or "").strip("<|>")


def transcribe_ctc(model: GigaAM, name: str, blocks: Generator[tuple[float, np.ndarray], None, None],
                   duration: float | None) -> Transcript:
    """transcribe() for GigaAM: no language detection, no timestamp tokens, no stock phrases."""
    progress = Progress(name, duration)
    segments: list[Segment] = []
    done = 0.0
    t0 = time.monotonic()
    try:
        for start, block in blocks:
            if peak_dbfs(block) >= SILENCE_DBFS:
                segments += ctc_block(model, start, block)
            done = start + block.size / SAMPLE_RATE
            progress.update(done)
    finally:
        blocks.close()
        progress.close()
    return Transcript(segments, done, time.monotonic() - t0, model.language, 0)


def ctc_block(model: GigaAM, start: float, block: np.ndarray) -> list[Segment]:
    """One block (<= 30 s, starting `start` seconds in) through GigaAM, as sentences."""
    return [seg for seg in sentences([Word(start + w.start, start + w.end, w.text) for w in model.words(block)])
            if re.search(r"\w", seg.text)]  # (a lone "." or "—" is no sentence)


# English terms in Russian speech. GigaAM writes them garbled or in Cyrillic ("Data Dog",
# "worниiнг statemont", "Рuби, Пиtн", "жаво"); Whisper gets most of them, but makes more
# errors in the Russian around them. So the sentences in which GigaAM wrote Latin letters
# (it heard something English) are also given to Whisper, and Whisper's English words
# replace the GigaAM words that sound like them, at the same time. On 33 min of a Russian IT
# podcast with 98 English terms (Podlodka; docs/npu-transcribe.md): GigaAM 7.3 % word
# errors and 20 % of the terms right, Whisper turbo 8.2 % and 58 %, both together 6.8 %
# and 54 %, with Whisper on 13 % of the audio.
TERM_SIMILARITY = 0.4         # how alike (transliterated) a GigaAM word and Whisper's English word must sound
TERM_SHORT_SIMILARITY = 0.7   # ... for GigaAM words of 1-3 letters ("то", "не")
TERM_SLICE_GAP = 2.0          # sentences closer than this go to Whisper together, ...
TERM_SLICE_MAX = 28.0         # ... up to this long (one Whisper window)
TERM_PAD = 0.3                # audio around a sentence for Whisper
# Russian endings kept after an English word: "GPU-шки", "warning-и", "Go-разработчиков"
TERM_ENDING = re.compile(r"^(?:ы|и|а|у|е|ой|ом|ов|ев|ах|ам|ами|ей|ем|шк[аиуе]|шками|к[аиуе]|ками|"
                         r"ный|ная|ное|ные|ного|ному|ными|ский|ские|ским|ер|ера|еры|ерам|ером)$", re.I)
ENGLISH_WORD = re.compile(r"^\W*[A-Za-z][\w.+#'&/-]*?(?:-[а-яё]+)?\W*$", re.I)


def sounds(text: str) -> str:
    """Letters as they sound, in Latin: "ворнинг" -> "vorning"."""
    return re.sub(r"[^a-z0-9]", "", "".join(CYR_TO_LAT.get(c, c) for c in text.lower()))


def alike(a: str, b: str) -> float:
    a, b = sounds(a), sounds(b)
    return difflib.SequenceMatcher(None, a, b).ratio() if a and b else 0.0


def english_word(text: str) -> bool:
    return bool(ENGLISH_WORD.match(text.strip())) and len(re.sub(r"[^A-Za-z]", "", text)) >= 2


def whole_words(words: list[Word]) -> list[Word]:
    """Whisper's pieces (" one", "-on", "-one", ",") joined into words: a piece without a
    leading space continues the word before it."""
    out: list[Word] = []
    for w in words:
        if out and w.text and not w.text[0].isspace():
            out[-1] = Word(out[-1].start, w.end, out[-1].text + w.text)
        else:
            out.append(Word(w.start, w.end, w.text))
    return out


def split_ending(text: str) -> tuple[str, str]:
    """("GPU,", "-шки") for "GPU-шки,"; (text, "") when there is no "-ending"."""
    m = re.match(r"^(.*?)(-[а-яё]+)(\W*)$", text.strip(), re.I)
    return (m[1] + m[3], m[2]) if m and m[1] else (text.strip(), "")


def swap_english(mine: list[Word], theirs: list[Word]) -> tuple[list[Word], int]:
    """GigaAM's words (mine) with Whisper's English words (theirs) put in where they were
    said: a run of English Whisper words replaces the GigaAM words at the same time that
    sound like them (TERM_SIMILARITY). Returns the words and how many runs went in."""
    runs: list[list[Word]] = []
    current: list[Word] = []
    for w in whole_words(theirs) + [Word(0.0, 0.0, " .")]:  # (the last one ends the last run)
        if english_word(w.text):
            current.append(w)
        elif current:
            runs.append(current)
            current = []
    mark: list[int | None] = [None] * len(mine)
    for k, run in enumerate(runs):
        a, b = run[0].start - 0.15, run[-1].end + 0.15
        for i, w in enumerate(mine):
            if mark[i] is not None or max(0.0, min(w.end, b) - max(w.start, a)) < 0.3 * max(w.end - w.start, 0.02):
                continue
            core, _ = split_ending(w.text)
            near = [x for x in run if min(x.end, w.end + 0.15) - max(x.start, w.start - 0.15) > 0] or run
            best = max([alike(core, x.text) for x in near if len(sounds(x.text)) >= 3]
                       + [alike(core, "".join(x.text for x in near))])
            short = len(sounds(core)) <= 3 and not re.search(r"[A-Za-z]", core)
            if best >= (TERM_SHORT_SIMILARITY if short else TERM_SIMILARITY):
                mark[i] = k
    out: list[Word] = []
    done: set[int] = set()
    swapped = 0
    for i, w in enumerate(mine):
        k = mark[i]
        if k is None:
            out.append(w)
            continue
        if k in done:
            continue
        done.add(k)
        idx = [j for j in range(len(mine)) if mark[j] == k]
        first, last = mine[idx[0]], mine[idx[-1]]
        said = [x for x in runs[k] if min(x.end, last.end + 0.25) - max(x.start, first.start - 0.25) > 0] or runs[k]
        text = "".join(x.text for x in said).strip()
        if tokens(text) == tokens("".join(mine[j].text for j in idx)):  # the same words: keep GigaAM's
            out += [mine[j] for j in idx]
            continue
        last_text = last.text.strip()
        _, ending = split_ending(last_text)
        if not ending and re.fullmatch(r"\W*[а-яё]+\W*", last_text, re.I):  # "ворнинги" -> "warning-и"
            word, said_last = re.sub(r"\W+", "", last_text), said[-1].text
            for n in (3, 2, 1):
                stem, end = word[:-n], word[-n:].lower()
                if len(stem) >= 3 and TERM_ENDING.match(end) \
                        and alike(stem, said_last) >= alike(word, said_last) + 0.03 \
                        and not (end in ("ы", "и") and re.search(r"s\W*$", said_last)):  # (already plural)
                    ending = "-" + end
                    break
        if ending and not re.search(r"[а-яё]", text, re.I):
            part = ending[1:]
            if TERM_ENDING.match(part) or (len(part) >= 6 and max(alike(part, x.text) for x in said) < TERM_SIMILARITY):
                text = re.sub(r"\W*$", "", text) + ending
        if (tail := re.search(r"[.!?…,]+$", last_text)) and not re.search(r"[.!?…,]$", text):
            text += tail[0]
        elif not tail:
            text = re.sub(r"[.!?…,]+$", "", text)
        out.append(Word(first.start, last.end, " " + text))
        swapped += 1
    return out, swapped


def english_terms(whisper: Whisper, samples: np.ndarray, segments: list[Segment],
                  language: str) -> tuple[list[Segment], int, float]:
    """GigaAM's segments with Whisper's English words put in (see TERM_SIMILARITY) where GigaAM
    wrote Latin letters. Returns the segments, the words swapped in, and the seconds of
    audio given to Whisper."""
    chosen = [i for i, seg in enumerate(segments) if seg.words and re.search(r"[A-Za-z]", seg.text)]
    slices: list[list[int]] = []
    for i in chosen:
        seg = segments[i]
        if slices and seg.start - segments[slices[-1][-1]].end < TERM_SLICE_GAP \
                and seg.end - segments[slices[-1][0]].start < TERM_SLICE_MAX:
            slices[-1].append(i)
        else:
            slices.append([i])
    out, swapped, seconds = list(segments), 0, 0.0
    for group in slices:
        a = max(0.0, segments[group[0]].start - TERM_PAD)
        b = min(samples.size / SAMPLE_RATE, segments[group[-1]].end + TERM_PAD)
        seconds += b - a
        result = whisper.generate(samples[int(a * SAMPLE_RATE):int(b * SAMPLE_RATE)], language=f"<|{language}|>",
                                  task="transcribe", return_timestamps=True, word_timestamps=True)
        if result is None:
            continue
        theirs = [Word(a + float(w.start_ts), a + float(w.end_ts), w.word) for w in (result.words or [])]
        for i in group:
            seg = segments[i]
            near = [w for w in theirs if seg.start - 0.5 <= (w.start + w.end) / 2 <= seg.end + 0.5]
            words, n = swap_english(seg.words, near)
            if n:
                swapped += n
                out[i] = Segment(seg.start, seg.end, " ".join("".join(w.text for w in words).split()),
                                 words, seg.speaker)
    return out, swapped, seconds


